<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Nosum server composition root: registers services and handlers into Nalix and binds the WebSocket listener.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nosum.Handlers\Nosum.Handlers.csproj" />
    <ProjectReference Include="..\Nosum.Infrastructure\Nosum.Infrastructure.csproj" />
    <PackageReference Include="Nalix.Hosting" />
    <!-- Design-time only: lets the EF tools work with Nosum.Host as startup project; never flows to publish output. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Maps of Nosum.Gameplay.Maps.GameMaps that the server loads (placeholder content, docs/adr/ADR-007); linked so assets/ stays the single copy. -->
  <ItemGroup>
    <Content Include="..\..\assets\Maps\Farm.tmx;..\..\assets\Maps\FarmHouse.tmx;..\..\assets\Maps\BusStop.tmx;..\..\assets\Maps\Forest.tmx;..\..\assets\Maps\Town.tmx;..\..\assets\Maps\Backwoods.tmx;..\..\assets\Maps\Farm_Foraging.tmx;..\..\assets\Maps\Mine.tmx" Link="maps\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The forty floor plans of the mine (docs/adr/ADR-026 D3), in a Mines sub-folder like the assets. -->
    <Content Include="..\..\assets\Maps\Mines\1.tmx;..\..\assets\Maps\Mines\2.tmx;..\..\assets\Maps\Mines\3.tmx;..\..\assets\Maps\Mines\4.tmx;..\..\assets\Maps\Mines\5.tmx;..\..\assets\Maps\Mines\6.tmx;..\..\assets\Maps\Mines\7.tmx;..\..\assets\Maps\Mines\8.tmx;..\..\assets\Maps\Mines\9.tmx;..\..\assets\Maps\Mines\10.tmx;..\..\assets\Maps\Mines\11.tmx;..\..\assets\Maps\Mines\12.tmx;..\..\assets\Maps\Mines\13.tmx;..\..\assets\Maps\Mines\14.tmx;..\..\assets\Maps\Mines\15.tmx;..\..\assets\Maps\Mines\16.tmx;..\..\assets\Maps\Mines\17.tmx;..\..\assets\Maps\Mines\18.tmx;..\..\assets\Maps\Mines\19.tmx;..\..\assets\Maps\Mines\20.tmx;..\..\assets\Maps\Mines\21.tmx;..\..\assets\Maps\Mines\22.tmx;..\..\assets\Maps\Mines\23.tmx;..\..\assets\Maps\Mines\24.tmx;..\..\assets\Maps\Mines\25.tmx;..\..\assets\Maps\Mines\26.tmx;..\..\assets\Maps\Mines\27.tmx;..\..\assets\Maps\Mines\28.tmx;..\..\assets\Maps\Mines\29.tmx;..\..\assets\Maps\Mines\41.tmx;..\..\assets\Maps\Mines\31.tmx;..\..\assets\Maps\Mines\32.tmx;..\..\assets\Maps\Mines\33.tmx;..\..\assets\Maps\Mines\34.tmx;..\..\assets\Maps\Mines\35.tmx;..\..\assets\Maps\Mines\36.tmx;..\..\assets\Maps\Mines\37.tmx;..\..\assets\Maps\Mines\38.tmx;..\..\assets\Maps\Mines\39.tmx;..\..\assets\Maps\Mines\40.tmx" Link="maps\Mines\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nosum.IntegrationTests" />
  </ItemGroup>

</Project>
