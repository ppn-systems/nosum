<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Description>Nosum server composition root: registers services and handlers into Nalix and binds the WebSocket listener.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nosum.Handlers\Nosum.Handlers.csproj" />
    <ProjectReference Include="..\Nosum.Infrastructure\Nosum.Infrastructure.csproj" />
    <PackageReference Include="Nalix.Hosting" />
    <!-- Design-time only: lets the EF tools work with Nosum.Host as startup project; never flows to publish output. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Maps of Nosum.Gameplay.Maps.GameMaps that the server loads (early content, docs/adr/ADR-007); linked so assets/ stays the single copy. -->
  <ItemGroup>
    <!-- Every hosted map has an own file (art/README.md), linked from art/own/Maps/ to the same path: same layout, own art. -->
    <Content Include="..\..\art\own\Maps\Farm.tmx" Link="maps\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\art\own\Maps\FarmHouse.tmx;..\..\art\own\Maps\BusStop.tmx;..\..\art\own\Maps\Forest.tmx;..\..\art\own\Maps\Town.tmx;..\..\art\own\Maps\Backwoods.tmx;..\..\art\own\Maps\Farm_Foraging.tmx;..\..\art\own\Maps\Mine.tmx;..\..\art\own\Maps\Mountain.tmx;..\..\art\own\Maps\Beach.tmx;..\..\art\own\Maps\Woods.tmx" Link="maps\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The forty floor plans of the mine (docs/adr/ADR-026 D3), in a Mines sub-folder like the assets. -->
    <Content Include="..\..\art\own\Maps\Mines\1.tmx;..\..\art\own\Maps\Mines\2.tmx;..\..\art\own\Maps\Mines\3.tmx;..\..\art\own\Maps\Mines\4.tmx;..\..\art\own\Maps\Mines\5.tmx;..\..\art\own\Maps\Mines\6.tmx;..\..\art\own\Maps\Mines\7.tmx;..\..\art\own\Maps\Mines\8.tmx;..\..\art\own\Maps\Mines\9.tmx;..\..\art\own\Maps\Mines\10.tmx;..\..\art\own\Maps\Mines\11.tmx;..\..\art\own\Maps\Mines\12.tmx;..\..\art\own\Maps\Mines\13.tmx;..\..\art\own\Maps\Mines\14.tmx;..\..\art\own\Maps\Mines\15.tmx;..\..\art\own\Maps\Mines\16.tmx;..\..\art\own\Maps\Mines\17.tmx;..\..\art\own\Maps\Mines\18.tmx;..\..\art\own\Maps\Mines\19.tmx;..\..\art\own\Maps\Mines\20.tmx;..\..\art\own\Maps\Mines\21.tmx;..\..\art\own\Maps\Mines\22.tmx;..\..\art\own\Maps\Mines\23.tmx;..\..\art\own\Maps\Mines\24.tmx;..\..\art\own\Maps\Mines\25.tmx;..\..\art\own\Maps\Mines\26.tmx;..\..\art\own\Maps\Mines\27.tmx;..\..\art\own\Maps\Mines\28.tmx;..\..\art\own\Maps\Mines\29.tmx;..\..\art\own\Maps\Mines\41.tmx;..\..\art\own\Maps\Mines\31.tmx;..\..\art\own\Maps\Mines\32.tmx;..\..\art\own\Maps\Mines\33.tmx;..\..\art\own\Maps\Mines\34.tmx;..\..\art\own\Maps\Mines\35.tmx;..\..\art\own\Maps\Mines\36.tmx;..\..\art\own\Maps\Mines\37.tmx;..\..\art\own\Maps\Mines\38.tmx;..\..\art\own\Maps\Mines\39.tmx;..\..\art\own\Maps\Mines\40.tmx" Link="maps\Mines\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\art\own\Maps\FarmHouse.tmx;..\..\art\own\Maps\BusStop.tmx;..\..\art\own\Maps\Forest.tmx;..\..\art\own\Maps\Town.tmx;..\..\art\own\Maps\Backwoods.tmx;..\..\art\own\Maps\Farm_Foraging.tmx;..\..\art\own\Maps\Coop.tmx;..\..\art\own\Maps\Barn.tmx" Link="maps\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
