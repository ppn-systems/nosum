  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\engine\Nosum.Core\Nosum.Core.csproj" />
    <ProjectReference Include="..\..\gameplay\Nosum.Gameplay\Nosum.Gameplay.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="terrain-kinds.csv" LogicalName="terrain-kinds.csv" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nosum.UnitTests" />
  </ItemGroup>

</Project>
