@using Nosum.Wasm.ViewModels.Building
@using Nosum.Wasm.ViewModels.Pets
@inherits ObservingComponent<CarpenterViewModel>

@* One tab of the carpenter's counter (docs/adr/ADR-028, docs/adr/ADR-075 amendment, docs/design/ui-standard.md section 3). The shop's tab bar picks the tab: Buildings shows
   the blueprints and, on the Build page, the animals for a finished building; Pets shows the cat or the dog to buy: choose one, name it, then confirm (the purchase is sent
   only by Confirm, in PetPurchaseOverlay). The server prices and checks everything; the buttons only follow the same rules so a player is not offered what they cannot afford. *@
<div class="carpenter-wrap">
    @if (Section == CarpenterTab.Buildings)
    {
        <GameSection Title="@Vm.Text("Carpenter_Buildings")">
            <p class="carpenter-line">@Vm.Text("Carpenter_Hint")</p>
            @foreach (BuildingOrder order in Vm.Orders)
            {
                BuildingOrder b = order;
                <GameRow Class="center carpenter-row">
                    <span>@order.Name</span>
                    <span class="carpenter-cost">@order.CostText</span>
                    <GameButton Text="@Vm.Text("Carpenter_Order")" Disabled="@(!order.CanOrder)" OnClick="@(() => Vm.OrderAsync(b))" />
                </GameRow>
            }
        </GameSection>
        @if (ShowAnimals)
        {
            @* The result of the last purchase sits above the animal section, not under the offers: at 1280 x 720 the bottom of this tab is out of view (docs/design/critique-animals-pets.md, finding 6). *@
            @if (Vm.Status.Length > 0)
            {
                <GameNotice Kind="@(Vm.StatusIsGood ? "ok" : "error")" Text="@Vm.Status" />
            }

            <GameSection Title="@Vm.Text("Carpenter_Animals")">
                @{
                    IReadOnlyList<AnimalOffer> offers = Vm.Offers;
                }
                @if (offers.Count == 0)
                {
                    <p class="carpenter-line">@Vm.Text("Carpenter_NoHome")</p>
                }
                else
                {
                    <GameField Label="@Vm.Text("Carpenter_Name")" Hint="@Vm.Text("Carpenter_NameHint")">
                        <GameInput Value="@Vm.AnimalName" ValueChanged="@(v => Vm.AnimalName = v)" Label="@Vm.Text("Carpenter_Name")" MaxLength="16" />
                    </GameField>
                    @foreach (AnimalOffer offer in offers)
                    {
                        AnimalOffer a = offer;
                        <GameRow Class="center carpenter-row">
                            <span>@offer.Title</span>
                            <GameButton Text="@offer.BuyLabel" Disabled="@(!offer.CanBuy)" OnClick="@(() => Vm.BuyAnimalAsync(a))" />
                        </GameRow>
                    }
                }
            </GameSection>
        }
    }
    else if (Section == CarpenterTab.Pets)
    {
        @if (Vm.PetStatusText.Length > 0)
        {
            <GameNotice Kind="@(Vm.PetStatusIsGood ? "ok" : "error")" Text="@Vm.PetStatusText" />
        }

        <GameSection Title="@Vm.Text("Carpenter_Pets")">
            <p class="carpenter-line">@Vm.Text("Carpenter_PetHint")</p>
            @if (Vm.HasPet)
            {
                <GameNotice Kind="info" Text="@Vm.Text("Carpenter_PetHave")" />
            }
            @if (Vm.PetStep == PetPurchaseStep.None)
            {
                @foreach (PetOffer pet in Vm.PetOffers)
                {
                    PetOffer p = pet;
                    <GameRow Class="center carpenter-row">
                        <span>@pet.Name</span>
                        <span class="carpenter-cost">@pet.PriceText</span>
                        <GameButton Text="@Vm.PetChooseText" Disabled="@(!pet.CanBuy)" OnClick="@(() => Vm.ChoosePetAsync(p))" />
                    </GameRow>
                }
            }
            else
            {
                @* The name step: the typed name is cleaned (PetRules.CleanName) when the player goes on; the confirm question follows in PetPurchaseOverlay. *@
                <GameField Label="@Vm.PetNameStepTitle">
                    <GameInput Value="@Vm.PetName" ValueChanged="@(v => Vm.PetName = v)" Label="@Vm.PetNameStepTitle" MaxLength="@CarpenterViewModel.MaxPetNameLength" />
                </GameField>
                @if (Vm.PetNameError.Length > 0)
                {
                    <GameNotice Kind="error" Text="@Vm.PetNameError" />
                }
                <GameRow Class="center">
                    <GameButton Variant="primary" Text="@Vm.PetNextText" OnClick="@(() => Vm.ContinuePet())" />
                    <GameButton Variant="secondary" Text="@Vm.PetCancelText" OnClick="@(() => Vm.CancelPet())" />
                </GameRow>
            }
        </GameSection>
    }
</div>

@code {
    /// <summary>The tab shown: the buildings (with the animals when <see cref="ShowAnimals"/>) or the pets.</summary>
    [Parameter] public CarpenterTab Section { get; set; } = CarpenterTab.Buildings;

    /// <summary>Whether the animal section shows. The carpenter's Buy page leaves it out: with the buildings it would not fit a 1280×720 panel, and the Build page has it (ADR-080 D5).</summary>
    [Parameter] public bool ShowAnimals { get; set; } = true;
}
