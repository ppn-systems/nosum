@* The page of one menu tab: scrolling content with an optional status line fixed under it. *@
<div class="menu-page">
    <div class="menu-page-body">@ChildContent</div>
    @if (Footer is not null)
    {
        <div class="menu-page-footer">@Footer</div>
    }
    @if (!string.IsNullOrEmpty(Status))
    {
        <p class="menu-page-status @(Good ? "good" : null)" role="status">@Status</p>
    }
</div>

@code {
    /// <summary>The localized status line (why the server refused something), or empty.</summary>
    [Parameter] public string? Status { get; set; }

    /// <summary>Whether the status line reports a success (shown in the "ok" colour) rather than a refusal.</summary>
    [Parameter] public bool Good { get; set; }

    /// <summary>Controls pinned under the scrolling content (the answer the page is for: confirm, cancel); optional.</summary>
    [Parameter] public RenderFragment? Footer { get; set; }

    /// <summary>The page content.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
