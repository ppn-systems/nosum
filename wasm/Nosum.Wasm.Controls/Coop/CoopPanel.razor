@using System
@using System.Collections.Generic
@using System.Linq
@using Nosum.Wasm.Controls.Menu
@using Nosum.Wasm.ViewModels.Coop
@inherits ObservingComponent<CoopViewModel>

@* The co-op: found or join one, manage members, and use the shared warehouse. The server decides roles and what a member may take.
   Once in a co-op, one part shows at a time on its tab (ui-standard sections 3 and 7): the window fits 1280x720 and a phone without an inner scroll. *@
<MenuPage Status="@Vm.Status" Good="Vm.StatusIsGood">
    <GameStack>
        @if (!Vm.HasCoop)
        {
            <GameSection Title="@Vm.Text("Coop_Create_Heading")">
                <GameRow>
                    <GameInput Value="@Vm.NameText" ValueChanged="@(v => Vm.NameText = v)" OnEnter="@(() => Vm.Create())" MaxLength="120" Placeholder="@Vm.Text("Coop_NamePlaceholder")" Label="@Vm.Text("Coop_NamePlaceholder")" />
                    <GameButton Text="@Vm.Text("Coop_Create")" OnClick="@(() => Vm.Create())" />
                </GameRow>
            </GameSection>
            <GameSection Title="@Vm.Text("Coop_Invites_Heading")">
                @if (Vm.Invites.Count == 0)
                {
                    <p class="coop-empty">@Vm.Text("Coop_NoInvites")</p>
                }
                @foreach ((Guid id, string name, string inviter) in Vm.Invites)
                {
                    Guid inviteId = id;
                    <GameRow Class="center">
                        <span>@(inviter.Length > 0 ? Vm.Text("Coop_InviteMessageFrom", name, inviter) : name)</span>
                        <GameButton Text="@Vm.Text("Coop_Accept")" OnClick="@(() => Vm.Respond(inviteId, true))" />
                        <GameButton Variant="secondary" Text="@Vm.Text("Coop_Decline")" OnClick="@(() => Vm.Respond(inviteId, false))" />
                    </GameRow>
                }
            </GameSection>
        }
        else
        {
            <div class="coop-tabs">
                <GameButton Variant="tab" Active="@(Vm.Part == CoopPart.Members)" Text="@Vm.Text("Coop_Tab_Members")" OnClick="@(() => Vm.Part = CoopPart.Members)" />
                <GameButton Variant="tab" Active="@(Vm.Part == CoopPart.Warehouse)" Text="@Vm.Text("Coop_Tab_Warehouse")" OnClick="@(() => Vm.Part = CoopPart.Warehouse)" />
                <GameButton Variant="tab" Active="@(Vm.Part == CoopPart.Upgrades)" Text="@Vm.Text("Coop_Tab_Upgrades")" OnClick="@(() => Vm.Part = CoopPart.Upgrades)" />
                <GameButton Variant="tab" Active="@(Vm.Part == CoopPart.Objectives)" Text="@Vm.Text("Coop_Tab_Objectives")" OnClick="@(() => Vm.Part = CoopPart.Objectives)" />
                <GameButton Variant="tab" Active="@(Vm.Part == CoopPart.Log)" Text="@Vm.Text("Coop_Tab_Log")" OnClick="@(() => Vm.Part = CoopPart.Log)" />
            </div>
            <div class="coop-part @PartClass(CoopPart.Members)">
                <GameSection Title="@Vm.Text("Coop_Members_Heading")">
                @foreach (MemberDisplay member in Vm.Members)
                {
                    Guid memberId = member.MemberId;
                    <div class="member-row">
                        <span class="member-name">@member.Label</span>
                        <span class="member-role">@member.RoleText</span>
                        <span class="member-gave">@(member.Deposited > 0 ? Vm.Text("Coop_Contrib_Row", member.Deposited) : string.Empty)</span>
                        <span class="member-online @(member.Online ? "on" : null)">@(member.Online ? Vm.Text("Coop_Online") : Vm.Text("Coop_Offline"))</span>
                        <span class="member-action">
                            @if (member.CanKick)
                            {
                                <GameButton Variant="danger" Text="@Vm.Text("Coop_Kick")" OnClick="@(() => Vm.Kick(memberId))" />
                            }
                        </span>
                    </div>
                }
                <p class="coop-empty">@Vm.Text("Coop_Contrib_Window", Vm.LogWindow)</p>
                <GameRow Class="spread">
                    @if (Vm.IsFounder)
                    {
                        <PlayerPicker Players="Vm.Players" ActionText="@Vm.Text("Coop_Invite")" PendingText="@Vm.Text("Coop_Invited")" EmptyText="@Vm.Text("Coop_NobodyNear")" OnPick="@(id => Vm.Invite(id))" />
                    }
                    <GameButton Variant="danger" Text="@Vm.Text("Coop_Leave")" OnClick="@(() => Vm.Leave())" />
                </GameRow>
            </GameSection>
            </div>
            <div class="coop-part @PartClass(CoopPart.Warehouse)">
                @* The warehouse's stock and the bag side by side in the XL panel (ui-standard section 3): the stock list on the left, the bag's grid on the
                   right. A phone stacks them. *@
                <div class="coop-split">
                    <GameSection Title="@Vm.Text("Coop_Warehouse_Heading")">
                        @if (Vm.Stock.Count == 0)
                        {
                            <p class="coop-empty">@Vm.Text("Coop_WarehouseEmpty")</p>
                        }
                        @foreach (StockDisplay row in Vm.Stock)
                        {
                            int itemId = row.Item.ItemId;
                            <GameRow Class="center">
                                <ItemSlotButton Slot="row.Item" Picked="row.Item.IsSelected" OnClick="@(() => Vm.PickWithdraw(itemId))" />
                                <span class="stock-name">@row.Item.Name</span>
                                <span>@Vm.Text("Coop_Available", row.Available)</span>
                            </GameRow>
                        }
                        <GameRow Class="center">
                            <GameInput Class="narrow" Type="number" Value="@Vm.QuantityText" ValueChanged="@(v => Vm.QuantityText = v)" Label="@Vm.Text("Coop_Quantity")" MaxLength="5" />
                            <GameButton Text="@Vm.Text("Coop_Withdraw")" OnClick="@(() => Vm.Withdraw())" />
                            <GameButton Text="@Vm.Text("Coop_Deposit")" Title="@Vm.Text("Coop_DepositHint")" OnClick="@(() => Vm.Deposit())" />
                        </GameRow>
                        <p class="coop-empty coop-hint">@Vm.Text("Coop_DepositHint")</p>
                    </GameSection>
                    <GameSection Title="@Vm.Text("Coop_YourBag")">
                        <ItemGrid Slots="Vm.InventorySlots" Columns="9" OnSlotClick="@(i => Vm.PickDeposit(i))" />
                    </GameSection>
                </div>
            </div>
            <div class="coop-part @PartClass(CoopPart.Upgrades)">
                <GameSection Title="@Vm.Text("Coop_Upgrades_Heading")">
                @foreach (UpgradeDisplay upgrade in Vm.Upgrades)
                {
                    UpgradeDisplay u = upgrade;
                    <div class="upgrade-row">
                        <div class="upgrade-head">
                            <span class="upgrade-title">@upgrade.Title</span>
                            <span class="upgrade-level">@upgrade.LevelText</span>
                            @if (Vm.IsFounder && !upgrade.IsMax)
                            {
                                <span class="upgrade-buy">
                                    <GameButton Text="@Vm.Text("Coop_Upgrade_Buy")" Disabled="@(!upgrade.CanBuy)" OnClick="@(() => Vm.UpgradeAsync(u))" />
                                </span>
                            }
                        </div>
                        <p class="coop-empty">@upgrade.Summary</p>
                        @if (upgrade.IsMax)
                        {
                            <p class="coop-empty">@Vm.Text("Coop_Upgrade_Max")</p>
                        }
                        else
                        {
                            <p class="coop-empty">
                                @Vm.Text("Coop_Upgrade_Next")
                                @foreach (UpgradeCostDisplay cost in upgrade.Costs)
                                {
                                    @(" ")<span class="upgrade-cost @(cost.Enough ? "enough" : "short")">@Vm.Text("Coop_Upgrade_Cost", cost.ItemName, cost.Needed, cost.Have)</span>
                                }
                            </p>
                        }
                    </div>
                }
                @if (!Vm.IsFounder)
                {
                    <p class="coop-empty">@Vm.Text("Coop_Upgrade_FounderOnly")</p>
                }
            </GameSection>
            </div>
            <div class="coop-part @PartClass(CoopPart.Objectives)">
                <GameSection Title="@Vm.Text("Coop_Objectives_Heading")">
                @foreach (ObjectiveDisplay objective in Vm.Objectives)
                {
                    <div class="objective-row">
                        <span class="objective-title">@objective.Title</span>
                        <progress class="objective-bar" value="@objective.Contributed" max="@objective.Target"></progress>
                        <span class="objective-count">@Vm.Text("Coop_Objective_Progress", objective.Contributed, objective.Target)</span>
                        @if (objective.Completed)
                        {
                            <span class="objective-trophy">@Vm.Text("Coop_Trophy_Earned")</span>
                        }
                    </div>
                }
            </GameSection>
            </div>
            <div class="coop-part @PartClass(CoopPart.Log)">
                <GameSection Title="@Vm.Text("Coop_Log_Heading")">
                @{
                    IReadOnlyList<string> log = Vm.Log;
                    int pages = PageCountOf(log.Count);
                    int page = Math.Min(_logPage, pages - 1);
                }
                @foreach (string line in log.Skip(page * LogPageSize).Take(LogPageSize))
                {
                    <p class="coop-log">@line</p>
                }
                @if (pages > 1)
                {
                    <Pager Page="page" PageCount="pages" PreviousText="@Vm.Text("Pager_Previous")" NextText="@Vm.Text("Pager_Next")"
                           PositionText="@Vm.Text("Pager_Position", page + 1, pages)" OnPage="@(p => _logPage = p)" />
                }
            </GameSection>
            </div>
        }
    </GameStack>
</MenuPage>

@code {

    /// <summary>The class of a part's wrapper: "active" for the part the tab bar chose, which is the only one shown.</summary>
    private string? PartClass(CoopPart part) => part == Vm.Part ? "active" : null;

    /// <summary>The warehouse log lines on one page. The server keeps the latest 20 lines; ten fit the window at 1280x720 and 1920x1080 without a scroll.</summary>
    private const int LogPageSize = 10;

    private int _logPage;

    private static int PageCountOf(int lines) => Math.Max(1, (lines + LogPageSize - 1) / LogPageSize);

    protected override void OnInitialized() => Vm.Open();
}
