@using Microsoft.JSInterop
@using Nosum.Wasm.Controls.Menu
@using Nosum.Wasm.ViewModels.Market
@using Nosum.Wasm.ViewModels.Shop
@inherits ObservingComponent<MarketViewModel>
@implements IAsyncDisposable
@inject IJSRuntime Js

@* The consignment market: browse and buy, list a stack, and the player's own listings. Every price and fee is the server's rule; this panel only asks and shows. *@
<MenuPage Status="@Vm.Status" Good="Vm.StatusIsGood">
    <GameStack>
        <TabBar Active="(int)Vm.Tab" OnSelect="@(id => Vm.SetTab((MarketTab)id))"
                Tabs="@(new (int, string)[] { ((int)MarketTab.Browse, Vm.Text("Market_Tab_Browse")), ((int)MarketTab.Sell, Vm.Text("Market_Tab_Sell")), ((int)MarketTab.Mine, Vm.Text("Market_Tab_Mine")) })" />

        @if (Vm.Tab == MarketTab.Browse)
        {
            @* One row: the search, then the order of the page (newest first, or by what one unit costs; stacks of different sizes compare on the unit price). *@
            <div class="market-filter">
                <GameInput Class="market-search" Value="@_search" ValueChanged="@(v => _search = v)" OnEnter="@(() => Vm.RunSearch(_search))" Placeholder="@Vm.Text("Market_SearchPlaceholder")" Label="@Vm.Text("Market_SearchPlaceholder")" />
                <GameButton Text="@Vm.Text("Market_Search")" OnClick="@(() => Vm.RunSearch(_search))" />
                <TabBar Active="(int)Vm.Sort" OnSelect="@(id => Vm.ChooseSort(id))" Tabs="Vm.SortTabs" />
            </div>
            @if (Vm.Browsed.Count == 0)
            {
                <p class="market-empty">@Vm.Text("Market_Empty")</p>
            }
            @* The page asks for the rows the window has room for (docs/adr/ADR-101 amendment 2026-11-01): no inner scrollbar at any size. *@
            <div class="listing-list" @ref="_browseList">
@foreach (ListingDisplay listing in Vm.Browsed)
            {
                Guid id = listing.Id;
                int itemId = listing.Item.ItemId;
                <GameRow Class="listing-row">
                    <ItemSlotButton Slot="listing.Item" Compact="true" />
                    @* One line: "Name x3 · Seller: name". A long line ends in an ellipsis (ADR-101). *@
                    <span class="listing-main"><span class="listing-name">@listing.Item.Name x@(listing.Item.Quantity)</span> <span class="listing-seller">@listing.SellerText</span></span>
                    <span class="listing-price">@listing.PriceText</span>
                    <GameButton Variant="secondary" Text="@Vm.Text("Market_History")" Title="@Vm.Text("Market_History_Tip")" OnClick="@(() => Vm.ShowHistory(itemId))" />
                    @if (listing.IsMine)
                    {
                        <span>@Vm.Text("Market_YourListing")</span>
                    }
                    else
                    {
                        <GameButton Text="@Vm.Text("Market_Buy")" OnClick="@(() => Vm.Buy(id))" />
                    }
                </GameRow>
            }
            </div>
            <PriceHistoryCard Vm="Vm" />
            <Pager Page="Vm.Page" PageCount="Vm.PageCount" PreviousText="@Vm.Text("Pager_Previous")" NextText="@Vm.Text("Pager_Next")"
                   PositionText="@Vm.Text("Pager_Position", Vm.Page + 1, Vm.PageCount)" OnPage="@(p => Vm.GoToPage(p))" />
        }
        else if (Vm.Tab == MarketTab.Sell)
        {
            <GameSection>
                @* The menu page keeps one u of padding on the right (its scrollbar gutter), which would centre the grid 1.5 px left of the panel body. *@
                <div class="market-sell-grid">
                    <ItemGrid Slots="Vm.InventorySlots" Columns="9" Picked="@(Vm.SellItem?.Index ?? -1)" OnSlotClick="@(i => Vm.PickSellSlot(i))" />
                </div>
            </GameSection>
            @if (Vm.SellItem is { } item)
            {
                @* Two lines: what and how many; then the price, what the player gets, and the button. The presets set the quantity (one, five, the stack). *@
                <GameRow Class="center">
                    <TabBar Tabs="SellPresetTabs()" Active="Vm.ActiveSellPreset" OnSelect="SelectSellPreset" />
                </GameRow>
                <div class="sell-form">
                    <span class="sell-name">@item.Name</span>
                    <span>@Vm.Text("Market_Quantity")</span>
                    <GameInput Class="narrow" Type="number" Value="@Vm.SellQuantityText" ValueChanged="@(v => { Vm.SellQuantityText = v; Vm.Touch(); })" Label="@Vm.Text("Market_Quantity")" MaxLength="4" />
                    <span class="sell-price">
                        <span>@Vm.Text("Market_TotalPrice")</span>
                        <PriceInput Class="narrow" Value="@Vm.SellPriceText" ValueChanged="@(v => { Vm.SellPriceText = v; Vm.Touch(); })" OnEnter="@(() => Vm.Sell())"
                                    Label="@Vm.Text("Market_TotalPrice")" Unit="@Vm.Text("Market_PriceLabel")" />
                    </span>
                    <GameButton Text="@Vm.Text("Market_List")" OnClick="@(() => Vm.Sell())" />
                    @* One line under the form: the bin's price while no price is typed, the fee and what the seller receives once one is. *@
                    @if (Vm.FeeSummary.Length > 0)
                    {
                        <span class="market-fee sell-fee">@Vm.FeeSummary</span>
                    }
                    else if (Vm.BinHint.Length > 0)
                    {
                        <span class="market-fee sell-bin">@Vm.BinHint</span>
                    }
                </div>
                @if (Vm.PendingListing is not null)
                {
                    @* A large stack waits for the seller's confirm before it is listed (issue #215, the same rule as a bulk purchase). *@
                    <GameNotice Kind="info" Text="@Vm.PendingListingText" />
                    <GameRow Class="center">
                        <GameButton Text="@Vm.Text("Shop_Confirm_Yes")" OnClick="Vm.ConfirmListing" />
                        <GameButton Variant="secondary" Text="@Vm.Text("Shop_Confirm_No")" OnClick="Vm.CancelListing" />
                    </GameRow>
                }
                <PriceHistoryCard Vm="Vm" Compact="true" />
            }
            else
            {
                <p class="market-empty">@Vm.Text("Market_SellHint")</p>
            }
        }
        else
        {
            @if (Vm.Mine.Count == 0)
            {
                <p class="market-empty">@Vm.Text("Market_NoneMine")</p>
            }
            <div class="listing-list">
@foreach (ListingDisplay listing in Vm.Mine)
            {
                Guid id = listing.Id;
                <GameRow Class="listing-row">
                    <ItemSlotButton Slot="listing.Item" Compact="true" />
                    @* Your own listing: how long it stays up (48 hours), then the price. *@
                    <span class="listing-main"><span class="listing-name">@listing.Item.Name x@(listing.Item.Quantity)</span> <span class="listing-seller">@listing.ExpiryText</span></span>
                    <span class="listing-price">@listing.PriceText</span>
                    <GameButton Variant="danger" Text="@Vm.Text("Market_Cancel")" OnClick="@(() => Vm.Cancel(id))" />
                </GameRow>
            }
            </div>
        }
    </GameStack>
</MenuPage>

@code {
    private string _search = string.Empty;
    private IJSObjectReference? _module;
    private DotNetObjectReference<MarketPanel>? _self;
    private int _watch;
    private ElementReference _browseList;

    protected override void OnInitialized() => Vm.Open();

    /// <inheritdoc/>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                // The same module the shop uses to fit its rows to the window (shop-rows.js: measure, and a resize watch that is debounced).
                _module = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/Nosum.Wasm.Controls/shop-rows.js");
                _self = DotNetObjectReference.Create(this);
                _watch = await _module.InvokeAsync<int>("watch", _self);
            }

            await this.MeasureRowsAsync();
        }
        catch (JSDisconnectedException)
        {
            // The page is going away.
        }
    }

    /// <summary>Called by shop-rows.js once the window has stopped resizing: the page is measured again.</summary>
    [JSInvokable]
    public Task OnViewportChanged() => this.InvokeAsync(this.MeasureRowsAsync);

    /// <summary>
    /// Asks the window how much room the listing list has and gives the view model the whole rows that fit. Runs on a render and on a resize, never per frame;
    /// the view model reloads only when the count changes, so the render that follows measures to the same answer and stops.
    /// </summary>
    private async Task MeasureRowsAsync()
    {
        if (_module is null || Vm.Tab != MarketTab.Browse || Vm.Browsed.Count == 0)
        {
            return;
        }

        double[]? room = await _module.InvokeAsync<double[]?>("measure", _browseList);
        if (room is { Length: 4 })
        {
            Vm.SetPageSize(MarketViewModel.RowsThatFit(room[0], room[1], room[2]));
        }
    }

    /// <inheritdoc/>
    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("unwatch", _watch);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The page is going away.
        }

        _self?.Dispose();
        _self = null;
        this.Dispose();
    }

    private IReadOnlyList<(int Id, string Label)> SellPresetTabs() =>
    [
        (ShopViewModel.PresetOne, Vm.PresetLabel(ShopViewModel.PresetOne)),
        (ShopViewModel.PresetFive, Vm.PresetLabel(ShopViewModel.PresetFive)),
        (ShopViewModel.PresetAll, Vm.PresetLabel(ShopViewModel.PresetAll)),
    ];

    private void SelectSellPreset(int preset) => Vm.ChooseSellPreset(preset);
}
