@using Nosum.Wasm.ViewModels.Market
@inherits ObservingComponent<MarketViewModel>

@* The consignment market: browse and buy, list a stack, and the player's own listings. Every price and fee is the server's rule; this panel only asks and shows. *@
<GamePanel Dock="PanelDock.Center" Title="@Vm.Text("Market_Title")" CloseText="@Vm.Text("Panel_Close")" OnClose="OnClose" Status="@Vm.Status" Class="wide">
    <GameStack>
        <TabBar Active="(int)Vm.Tab" OnSelect="@(id => Vm.SetTab((MarketTab)id))"
                Tabs="@(new (int, string)[] { ((int)MarketTab.Browse, Vm.Text("Market_Tab_Browse")), ((int)MarketTab.Sell, Vm.Text("Market_Tab_Sell")), ((int)MarketTab.Mine, Vm.Text("Market_Tab_Mine")) })" />

        @if (Vm.Tab == MarketTab.Browse)
        {
            <GameRow>
                <GameInput Value="@_search" ValueChanged="@(v => _search = v)" OnEnter="@(() => Vm.RunSearch(_search))" Placeholder="@Vm.Text("Market_SearchPlaceholder")" Label="@Vm.Text("Market_SearchPlaceholder")" />
                <GameButton Text="@Vm.Text("Market_Search")" OnClick="@(() => Vm.RunSearch(_search))" />
            </GameRow>
            @if (Vm.Browsed.Count == 0)
            {
                <p class="market-empty">@Vm.Text("Market_Empty")</p>
            }
            @foreach (ListingDisplay listing in Vm.Browsed)
            {
                Guid id = listing.Id;
                <GameRow Class="listing-row">
                    <ItemSlotButton Slot="listing.Item" Scale="2" />
                    <span class="listing-name">@listing.Item.Name x@(listing.Item.Quantity)</span>
                    <span class="listing-price">@Vm.Text("Market_Price", listing.PriceText)</span>
                    @if (listing.IsMine)
                    {
                        <span>@Vm.Text("Market_YourListing")</span>
                    }
                    else
                    {
                        <GameButton Text="@Vm.Text("Market_Buy")" OnClick="@(() => Vm.Buy(id))" />
                    }
                </GameRow>
            }
            <Pager Page="Vm.Page" PageCount="Vm.PageCount" PreviousText="@Vm.Text("Pager_Previous")" NextText="@Vm.Text("Pager_Next")"
                   PositionText="@Vm.Text("Pager_Position", Vm.Page + 1, Vm.PageCount)" OnPage="@(p => Vm.GoToPage(p))" />
        }
        else if (Vm.Tab == MarketTab.Sell)
        {
            <GameSection Title="@Vm.Text("Market_SellPick")">
                <ItemGrid Slots="Vm.InventorySlots" Columns="9" Scale="2" Picked="@(Vm.SellItem?.Index ?? -1)" OnSlotClick="@(i => Vm.PickSellSlot(i))" />
            </GameSection>
            @if (Vm.SellItem is { } item)
            {
                <GameRow Class="center">
                    <span>@item.Name</span>
                    <GameInput Type="number" Value="@Vm.SellQuantityText" ValueChanged="@(v => { Vm.SellQuantityText = v; Vm.Touch(); })" Label="@Vm.Text("Market_Quantity")" MaxLength="4" />
                    <span>@Vm.Text("Market_Quantity")</span>
                </GameRow>
                <GameRow Class="center">
                    <PriceInput Value="@Vm.SellPriceText" ValueChanged="@(v => { Vm.SellPriceText = v; Vm.Touch(); })" OnEnter="@(() => Vm.Sell())"
                                Label="@Vm.Text("Market_PriceLabel")" Unit="@Vm.Text("Market_PriceLabel")" />
                </GameRow>
                @if (Vm.FeeSummary.Length > 0)
                {
                    <p class="market-fee">@Vm.FeeSummary</p>
                }
                <GameButton Text="@Vm.Text("Market_List")" OnClick="@(() => Vm.Sell())" />
            }
            else
            {
                <p class="market-empty">@Vm.Text("Market_SellHint")</p>
            }
        }
        else
        {
            @if (Vm.Mine.Count == 0)
            {
                <p class="market-empty">@Vm.Text("Market_NoneMine")</p>
            }
            @foreach (ListingDisplay listing in Vm.Mine)
            {
                Guid id = listing.Id;
                <GameRow Class="listing-row">
                    <ItemSlotButton Slot="listing.Item" Scale="2" />
                    <span class="listing-name">@listing.Item.Name x@(listing.Item.Quantity)</span>
                    <span class="listing-price">@Vm.Text("Market_Price", listing.PriceText)</span>
                    <GameButton Variant="danger" Text="@Vm.Text("Market_Cancel")" OnClick="@(() => Vm.Cancel(id))" />
                </GameRow>
            }
        }
    </GameStack>
</GamePanel>

@code {
    private string _search = string.Empty;

    /// <summary>Raised when the close button is clicked.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    protected override void OnInitialized() => Vm.Open();
}
