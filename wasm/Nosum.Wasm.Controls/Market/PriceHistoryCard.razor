@using Nosum.Wasm.ViewModels.Market

@* The price history of one item (docs/adr/ADR-030 D4): a line of the daily median unit price and the latest day's lowest, median and highest. Shown under the
   browse list (with a title and a hide button) and, compact, under the sell form where the seller prices the stack; the market view model says which item. *@
@if (Vm.HistoryItemId != 0)
{
    @if (Compact)
    {
        <GameRow Class="center history-compact">
            <GameSparkline Values="Vm.HistoryPoints" Label="@Vm.Text("Market_History_Chart")" />
            <span class="history-lines">
                @foreach (string line in Vm.HistoryLines)
                {
                    <span class="history-line">@line</span>
                }
            </span>
        </GameRow>
    }
    else
    {
        <GameSection Title="@Vm.HistoryTitle">
            <GameStack>
                <GameSparkline Values="Vm.HistoryPoints" Label="@Vm.Text("Market_History_Chart")" />
                @foreach (string line in Vm.HistoryLines)
                {
                    <p class="history-line">@line</p>
                }
                <GameRow>
                    <GameButton Variant="secondary" Text="@Vm.Text("Market_History_Hide")" OnClick="@(() => Vm.HideHistory())" />
                </GameRow>
            </GameStack>
        </GameSection>
    }
}

@code {
    /// <summary>The market view model that holds the history.</summary>
    [Parameter, EditorRequired] public MarketViewModel Vm { get; set; } = default!;

    /// <summary>Shows the chart beside the lines, without a title or a hide button (the sell form).</summary>
    [Parameter] public bool Compact { get; set; }
}
