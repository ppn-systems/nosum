@using Nosum.Wasm.ViewModels.Chest
@using Nosum.Wasm.Controls.Menu
@inherits ObservingComponent<ChestViewModel>

@* The chest page, Minecraft layout: the chest's grid on top, the player's bag and hotbar under it. Click a stack, then a slot; shift-click sends a stack to the other side. *@
<MenuPage Status="@Vm.Status">
    <GameStack>
        <div class="chest-split">
        <GameSection Title="@Vm.ChestLabel">
            <div class="chest-tools">
                <GameButton Variant="secondary" Text="@Vm.SortChestLabel" OnClick="Vm.SortChest" />
            </div>
            <div class="chest-grid">
                <ItemGrid Slots="Vm.ChestSlots" Columns="9" Picked="@Vm.PickedChestSlot" OnSlotClick="@(i => Vm.ClickChestAsync(i))" OnSlotShiftClick="@(i => Vm.QuickMoveChestAsync(i))" />
            </div>
        </GameSection>
        <GameSection Title="@Vm.BagLabel">
            <div class="chest-tools">
                <GameButton Variant="secondary" Text="@Vm.SortBagLabel" OnClick="Vm.SortBag" />
            </div>
            <div class="chest-grid">
                <ItemGrid Slots="Vm.BagSlots" Columns="9" Picked="@Vm.PickedPlayerSlot" OnSlotClick="@(i => Vm.ClickPlayerAsync(i))" OnSlotShiftClick="@(i => Vm.QuickMovePlayerAsync(i))" />
                <ItemGrid Slots="Vm.HotbarSlots" Columns="9" Picked="@Vm.PickedPlayerSlot" OnSlotClick="@(i => Vm.ClickPlayerAsync(i))" OnSlotShiftClick="@(i => Vm.QuickMovePlayerAsync(i))" />
            </div>
        </GameSection>
        </div>
        <p class="chest-hint">@Vm.Hint</p>
    </GameStack>
</MenuPage>
