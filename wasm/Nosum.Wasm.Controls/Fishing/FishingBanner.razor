@using Nosum.Wasm.ViewModels.Fishing
@inherits ObservingComponent<FishingViewModel>

@* The fishing status line in the bottom toast stack (docs/design/ui-standard.md section 5): what the line is doing and the press that reels in. The bite
   window is drawn by the scene, as a gauge beside the farmer (FishingDecorator), so the line keeps only the words. It is shown while a cast is open
   (docs/adr/ADR-078 D9); the catch is in FishingCatchCard. *@
@if (Vm.Phase != FishingPhase.Idle)
{
    <GamePanel Class="hud toast fishing-status" Role="status" Title="">
        @Vm.Message
        @if (Vm.Phase == FishingPhase.Biting)
        {
            <strong>@Vm.PressPrompt</strong>
        }
        @if (!string.IsNullOrEmpty(Vm.Note))
        {
            <span>@Vm.Note</span>
        }
    </GamePanel>
}
