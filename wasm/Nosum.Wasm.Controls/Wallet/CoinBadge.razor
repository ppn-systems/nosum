@inherits ObservingComponent<Nosum.Wasm.ViewModels.Wallet.WalletViewModel>

@* The coin counter: the coin and the amount, nothing else (the unit is the coin picture; the tooltip names it). *@
<GamePanel Class="hud coin" Title="">
    <p class="coin-line" role="status" aria-label="@(Vm.Amount + " " + Vm.Caption)" data-tip="@Vm.Caption"><GameIcon Name="coin" /><span class="coin-amount">@Vm.Amount</span></p>
</GamePanel>
