@inherits ObservingComponent<Nosum.Wasm.ViewModels.Wallet.WalletViewModel>

@* The coin counter in a corner of the screen. *@
<div class="coin-badge" role="status" aria-label="@Vm.Caption" title="@Vm.Caption">
    <span class="coin-amount">@Vm.Amount</span>
    <span class="coin-caption">@Vm.Caption</span>
</div>
