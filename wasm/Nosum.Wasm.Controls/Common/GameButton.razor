@* The one button of the game UI. Looks come only from the shared "game-button" class. *@
<button type="button" class="game-button" disabled="@Disabled" @onclick="OnClick">@ChildContent</button>

@code {
    /// <summary>Gets or sets what happens on a click.</summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>Gets or sets whether the button can be used.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Gets or sets the localized label.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
