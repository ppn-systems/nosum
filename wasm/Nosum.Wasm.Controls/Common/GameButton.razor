@* The one button of the game UI. Looks come only from the shared "game-button" class and its variants (primary, danger, plain, tab, link);
   text comes from the caller (already localized). Keyboard users reach it with Tab (docs/adr/ADR-033 D4); a click in the game does not take focus (the canvas keeps the keyboard), on a form (Focusable) it does. *@
<button @attributes="Extra"
        type="@(Submit ? "submit" : "button")"
        class="game-button @Variant @(Active ? "active" : null)"
        disabled="@Disabled"
        data-tip="@Title"
        aria-pressed="@(Variant == "tab" ? (Active ? "true" : "false") : null)"
        @onmousedown:preventDefault="@(!Focusable)"
        @onclick="OnClick"><span class="game-button-label">@Text@ChildContent</span></button>

@code {
    /// <summary>Gets or sets extra HTML attributes and event handlers for the button (for example <c>data-capture-key</c> and <c>@onkeydown</c> on the key binding rows).</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? Extra { get; set; }

    /// <summary>Gets or sets what happens on a click.</summary>
    [Parameter]
    public EventCallback OnClick { get; set; }

    /// <summary>Gets or sets whether the button can be used.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Gets or sets the localized label (or put the label in the content).</summary>
    [Parameter]
    public string Text { get; set; } = string.Empty;

    /// <summary>Gets or sets an optional localized tooltip.</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>Gets or sets the look: <c>primary</c>, <c>danger</c>, <c>plain</c>, <c>tab</c>, <c>link</c> or <c>chip</c>.</summary>
    [Parameter]
    public string Variant { get; set; } = "primary";

    /// <summary>Gets or sets whether the button is the active tab.</summary>
    [Parameter]
    public bool Active { get; set; }

    /// <summary>Gets or sets whether the button keeps focus when clicked (forms); in the game it must not. It can always be reached with Tab.</summary>
    [Parameter]
    public bool Focusable { get; set; }

    /// <summary>Gets or sets whether the button submits the form it is in.</summary>
    [Parameter]
    public bool Submit { get; set; }

    /// <summary>Gets or sets the localized label as content.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
