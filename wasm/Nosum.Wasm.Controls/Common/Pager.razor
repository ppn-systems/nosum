@* Previous and next page with the position between them. *@
<GameRow Class="center">
    <GameButton Variant="plain" Disabled="@(Page <= 0)" OnClick="() => OnPage.InvokeAsync(Page - 1)"><GameIcon Name="arrow-left" />@PreviousText</GameButton>
    <span class="pager-position">@PositionText</span>
    <GameButton Variant="plain" Disabled="@(Page + 1 >= PageCount)" OnClick="() => OnPage.InvokeAsync(Page + 1)">@NextText<GameIcon Name="arrow-right" /></GameButton>
</GameRow>

@code {
    /// <summary>The zero-based page.</summary>
    [Parameter] public int Page { get; set; }

    /// <summary>The number of pages.</summary>
    [Parameter] public int PageCount { get; set; } = 1;

    /// <summary>The previous button's text.</summary>
    [Parameter, EditorRequired] public string PreviousText { get; set; } = string.Empty;

    /// <summary>The next button's text.</summary>
    [Parameter, EditorRequired] public string NextText { get; set; } = string.Empty;

    /// <summary>The position text between the buttons, for example "2 / 5" (already localized).</summary>
    [Parameter, EditorRequired] public string PositionText { get; set; } = string.Empty;

    /// <summary>Raised with the page to go to.</summary>
    [Parameter] public EventCallback<int> OnPage { get; set; }
}
