@* A grid of item slots (inventory, an offer, a warehouse). The caller says what a click means; the slot size is the theme's. *@
<div class="item-grid" style="--item-grid-columns:@Columns">
    @foreach (SlotDisplay slot in Slots)
    {
        int index = slot.Index;
        <ItemSlotButton Slot="slot" Picked="@(Picked == index)" OnClick="() => OnSlotClick.InvokeAsync(index)" OnShiftClick="@(OnSlotShiftClick.HasDelegate ? EventCallback.Factory.Create(this, () => OnSlotShiftClick.InvokeAsync(index)) : default)" OnRightClick="@(OnSlotRightClick.HasDelegate ? EventCallback.Factory.Create(this, () => OnSlotRightClick.InvokeAsync(index)) : default)" />
    }
</div>

@code {
    /// <summary>The slots to show.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<SlotDisplay> Slots { get; set; } = [];

    /// <summary>Obsolete and ignored: the slot size is the theme's.</summary>
    [Parameter] public int Scale { get; set; }

    /// <summary>Slots per row.</summary>
    [Parameter] public int Columns { get; set; } = 9;

    /// <summary>The index marked as picked, or -1.</summary>
    [Parameter] public int Picked { get; set; } = -1;

    /// <summary>Raised with the clicked slot's index.</summary>
    [Parameter] public EventCallback<int> OnSlotClick { get; set; }

    /// <summary>Raised with the clicked slot's index when it was clicked with Shift held; nothing happens when nobody listens (a plain click is raised instead).</summary>
    [Parameter] public EventCallback<int> OnSlotShiftClick { get; set; }

    /// <summary>Raised with the right-clicked slot's index (a split); nothing happens when nobody listens.</summary>
    [Parameter] public EventCallback<int> OnSlotRightClick { get; set; }
}
