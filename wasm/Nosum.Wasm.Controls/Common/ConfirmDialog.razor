@* A small question with two answers. *@
<GamePanel Title="@Title" Class="dialog" Role="alertdialog">
    <GameStack>
        <p class="confirm-message">@Message</p>
        <GameRow Class="end">
            @if (ThirdText is not null)
            {
                <GameButton Variant="primary" Text="@ThirdText" OnClick="OnThird" />
            }
            <GameButton Variant="@(ThirdText is null ? "primary" : "secondary")" Text="@ConfirmText" OnClick="OnConfirm" />
            <GameButton Variant="secondary" Text="@CancelText" OnClick="OnCancel" />
        </GameRow>
    </GameStack>
</GamePanel>

@code {
    /// <summary>The title (already localized).</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>The question (already localized).</summary>
    [Parameter, EditorRequired] public string Message { get; set; } = string.Empty;

    /// <summary>The yes button's text.</summary>
    [Parameter, EditorRequired] public string ConfirmText { get; set; } = string.Empty;

    /// <summary>The no button's text.</summary>
    [Parameter, EditorRequired] public string CancelText { get; set; } = string.Empty;

    /// <summary>Raised on yes.</summary>
    [Parameter] public EventCallback OnConfirm { get; set; }

    /// <summary>Raised on no.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>An optional first answer, shown as the primary button before yes (for example "link an account first"). Null hides it.</summary>
    [Parameter] public string? ThirdText { get; set; }

    /// <summary>Raised on the optional first answer.</summary>
    [Parameter] public EventCallback OnThird { get; set; }
}
