@* A small question with two answers. *@
<GamePanel Dock="PanelDock.Center" Title="@Title" Class="dialog">
    <GameStack>
        <p class="confirm-message">@Message</p>
        <GameRow>
            <GameButton Variant="primary" Text="@ConfirmText" OnClick="OnConfirm" />
            <GameButton Variant="plain" Text="@CancelText" OnClick="OnCancel" />
        </GameRow>
    </GameStack>
</GamePanel>

@code {
    /// <summary>The title (already localized).</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>The question (already localized).</summary>
    [Parameter, EditorRequired] public string Message { get; set; } = string.Empty;

    /// <summary>The yes button's text.</summary>
    [Parameter, EditorRequired] public string ConfirmText { get; set; } = string.Empty;

    /// <summary>The no button's text.</summary>
    [Parameter, EditorRequired] public string CancelText { get; set; } = string.Empty;

    /// <summary>Raised on yes.</summary>
    [Parameter] public EventCallback OnConfirm { get; set; }

    /// <summary>Raised on no.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }
}
