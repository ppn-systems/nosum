@* A status light with a word: connection state. Kind picks the light (ok, warn, error). *@
<span class="game-badge @Kind" role="status"><span class="game-badge-light"></span>@Text</span>

@code {
    /// <summary>The light: <c>ok</c>, <c>warn</c> or <c>error</c>.</summary>
    [Parameter] public string Kind { get; set; } = "ok";

    /// <summary>The localized text.</summary>
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;
}
