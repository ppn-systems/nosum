@* A framed panel: the one container every game UI panel is built from. Looks come only from the shared "game-panel" classes and the theme
   variables, so the theme can change in one place. Where a panel sits is decided by the dock region of GameHud it is put in, not by the panel.
   A panel with a close handler has a header with a close button and a status line. *@
<section class="game-panel @Class" role="@(Role ?? (OnClose.HasDelegate ? "dialog" : "region"))" aria-label="@(Title.Length > 0 ? Title : null)">
    @if (OnClose.HasDelegate)
    {
        <div class="game-panel-header">
            <h2 class="game-panel-title">@Title</h2>
            <button type="button" class="game-close" aria-label="@CloseText" title="@CloseText" tabindex="-1" @onmousedown:preventDefault @onclick="OnClose"></button>
        </div>
    }
    else if (Title.Length > 0)
    {
        <h2 class="game-panel-title">@Title</h2>
    }
    <div class="game-panel-body">@ChildContent</div>
    @if (!string.IsNullOrEmpty(Status))
    {
        <p class="game-panel-status" role="status">@Status</p>
    }
</section>

@code {
    /// <summary>Gets or sets the localized title; empty for none.</summary>
    [Parameter]
    public string Title { get; set; } = string.Empty;

    /// <summary>Obsolete and ignored: the <c>GameHud</c> region the panel is put in decides where it sits.</summary>
    [Parameter]
    public PanelDock Dock { get; set; } = PanelDock.None;

    /// <summary>Gets or sets the localized text of the close button (its accessible name and tooltip).</summary>
    [Parameter]
    public string CloseText { get; set; } = string.Empty;

    /// <summary>Gets or sets what happens when the close button is clicked; without a handler there is no header and no close button.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>Gets or sets the localized status line under the body, or empty.</summary>
    [Parameter]
    public string? Status { get; set; }

    /// <summary>Gets or sets the ARIA role; by default <c>dialog</c> for a closable panel and <c>region</c> otherwise.</summary>
    [Parameter]
    public string? Role { get; set; }

    /// <summary>Gets or sets extra shared CSS classes: <c>wide</c> (a large window), <c>hud</c> (a compact always-visible panel), <c>dialog</c>.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>Gets or sets the content.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
