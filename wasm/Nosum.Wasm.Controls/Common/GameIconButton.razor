@* A square button that shows one sprite of the theme (the settings gear, mail, or a HUD panel button). Tip is its tooltip and accessible name (already localized). *@
<button type="button"
        class="game-icon-button @(Active ? "active" : null)"
        aria-pressed="@(Active ? "true" : "false")"
        data-tip="@Tip"
        aria-label="@Tip"
        @onmousedown:preventDefault
        @onclick="OnClick"><span class="game-icon-button-art" style="background-image:var(--nosum-img-@(Icon))"></span>@if (Badge > 0)
{
<span class="game-icon-badge" aria-hidden="true">@(Badge > 9 ? "9+" : Badge.ToString())</span>
}</button>

@code {
    /// <summary>The theme sprite: <c>tab-settings</c>, ... (see <c>nosum-theme.js</c>).</summary>
    [Parameter, EditorRequired] public string Icon { get; set; } = string.Empty;

    /// <summary>The localized tooltip and accessible name.</summary>
    [Parameter, EditorRequired] public string Tip { get; set; } = string.Empty;

    /// <summary>Whether the panel this button opens is currently active.</summary>
    [Parameter] public bool Active { get; set; }

    /// <summary>A count shown in a small badge on the button (unread mail on the gear); nothing when zero.</summary>
    [Parameter] public int Badge { get; set; }

    /// <summary>Raised on a click.</summary>
    [Parameter] public EventCallback OnClick { get; set; }
}
