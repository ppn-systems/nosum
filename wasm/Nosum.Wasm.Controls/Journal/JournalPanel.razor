@using Nosum.Wasm.Controls.Inventory
@using Nosum.Wasm.Controls.Menu
@using Nosum.Wasm.ViewModels.Journal
@inherits ObservingComponent<JournalViewModel>

@* The collection journal (J): every item of the catalogue. The ones the farmer has obtained show their picture, count and first date; the rest are silhouettes. *@
<MenuPage>
    <p class="journal-summary">@Vm.Text("Journal_Summary", Vm.Discovered, JournalViewModel.Total)</p>
    <div class="journal-filters">
        <GameButton Variant="tab" Active="@(Vm.Filter == JournalFilter.All)" Text="@Vm.Text("Journal_Filter_All")" OnClick="@(() => Vm.SetFilter(JournalFilter.All))" />
        <GameButton Variant="tab" Active="@(Vm.Filter == JournalFilter.Found)" Text="@Vm.Text("Journal_Filter_Found")" OnClick="@(() => Vm.SetFilter(JournalFilter.Found))" />
        <GameButton Variant="tab" Active="@(Vm.Filter == JournalFilter.Missing)" Text="@Vm.Text("Journal_Filter_Missing")" OnClick="@(() => Vm.SetFilter(JournalFilter.Missing))" />
    </div>
    <div class="journal-grid">
        @foreach (JournalCell cell in Vm.PageCells())
        {
            <div class="journal-cell @(cell.Discovered ? "found" : "undiscovered")">
                <ItemSlotButton Slot="cell.Slot" />
            </div>
        }
    </div>
    @if (Vm.PageCount > 1)
    {
        <Pager Page="Vm.Page" PageCount="Vm.PageCount" PreviousText="@Vm.Text("Pager_Previous")" NextText="@Vm.Text("Pager_Next")"
               PositionText="@Vm.Text("Pager_Position", Vm.Page + 1, Vm.PageCount)" OnPage="@(p => Vm.GoToPage(p))" />
    }
</MenuPage>

@code {
    /// <summary>Asks the server for the journal each time the panel opens.</summary>
    protected override void OnInitialized() => Vm.Open();
}
