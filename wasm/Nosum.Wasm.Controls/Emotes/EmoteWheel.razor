@using System
@using System.Threading.Tasks
@using Microsoft.JSInterop
@using Nosum.Wasm.Controls.Common
@using Nosum.Wasm.ViewModels.Emotes
@inherits ObservingComponent<EmoteWheelViewModel>
@inject IJSRuntime Js

@* The emote wheel (docs/adr/ADR-071 D1): twelve round icon buttons around a circle, opened by B or the HUD button. Choosing one sends it through the view model.
   A refusal message shows briefly under the wheel. The layer covers the overlay region and takes no pointer events itself. *@
<div class="emote-layer">
    @if (Vm.IsOpen)
    {
        <div class="emote-wheel" role="group" aria-label="@Vm.Label">
            @for (int i = 0; i < Vm.Options.Count; i++)
            {
                EmoteOption option = Vm.Options[i];
                (int x, int y) = Place(i);
                <div class="emote-slot" style="--emote-x:@x;--emote-y:@y">
                    <GameIconButton Icon="@option.Icon" Tip="@option.Label" OnClick="@(() => Vm.Choose(option.Code))" />
                </div>
            }
        </div>
    }
    @if (Vm.Notice.Length > 0)
    {
        <div class="emote-notice">
            <GameNotice Kind="error" Text="@Vm.Notice" />
        </div>
    }
</div>

@code {
    // Radius of the circle the icon centres sit on, in UI pixels; the twelve icons are 30 degrees apart, the first at the top.
    private const double RadiusUnits = 56;

    private IJSObjectReference? _module;
    private DotNetObjectReference<EmoteWheel>? _self;

    /// <summary>Called by emote-keys.js when B is pressed (no field has the keys).</summary>
    [JSInvokable]
    public Task ToggleFromKey() => InvokeAsync(Vm.Toggle);

    /// <summary>Called by emote-keys.js when Escape is pressed.</summary>
    [JSInvokable]
    public Task CloseFromKey() => InvokeAsync(Vm.Close);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/Nosum.Wasm.Controls/emote-keys.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("attach", _self);
        }
        catch (JSException)
        {
            // The hotkey is a convenience: the HUD button still opens the wheel.
        }
    }

    /// <summary>Where the icon of an emote sits on the circle, in UI pixels from its centre.</summary>
    private static (int X, int Y) Place(int index)
    {
        double angle = ((index * 30) - 90) * Math.PI / 180;
        return ((int)Math.Round(Math.Cos(angle) * RadiusUnits), (int)Math.Round(Math.Sin(angle) * RadiusUnits));
    }

    /// <inheritdoc/>
    protected override void Dispose(bool disposing)
    {
        base.Dispose(disposing);
        if (disposing)
        {
            _ = this.ReleaseAsync();
        }
    }

    private async Task ReleaseAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("detach");
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The page is gone; nothing to detach from.
        }
        finally
        {
            _self?.Dispose();
        }
    }
}
