@inherits ObservingComponent<Nosum.Wasm.ViewModels.Progress.ProgressViewModel>

@* The energy bar: a thin vertical gauge beside the hotbar that fills from the bottom. The number is in the tooltip and the accessible name, not on the screen,
   so the HUD stays tidy. It is hidden until the server has said how much energy the player has. *@
@if (Vm.HasEnergy)
{
    <GamePanel Class="hud energy" Title="">
        <div class="energy-bar @(Vm.EnergyLow ? "low" : null)" role="meter" aria-label="@Vm.EnergyLabel" aria-valuemin="0" aria-valuemax="@Vm.MaxEnergy" aria-valuenow="@Vm.Energy" data-tip="@Vm.EnergyLabel">
            <span class="energy-fill" style="height: @(Math.Round(Vm.EnergyFraction * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
        </div>
    </GamePanel>
}
