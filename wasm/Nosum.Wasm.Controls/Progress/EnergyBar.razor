@inherits ObservingComponent<Nosum.Wasm.ViewModels.Progress.ProgressViewModel>

@* The energy bar: a thin vertical gauge beside the hotbar that fills from the bottom. The number is in the tooltip and the accessible name, not on the screen,
   so the HUD stays tidy. It is hidden until the server has said how much energy the player has. *@
@if (Vm.HasEnergy)
{
    <GamePanel Class="hud bare energy" Title="">
        <div class="vitals-bars @Vm.StatusEffectBadge">
            <div class="energy-bar hp-bar @(Vm.HpLow ? "low" : null)" role="meter" aria-label="@Vm.HpLabel" aria-valuemin="0" aria-valuemax="@Vm.MaxHp" aria-valuenow="@Vm.Hp" data-tip="@Vm.HpLabel">
                <span class="energy-fill hp-fill" style="height: @(Math.Round(Vm.HpFraction * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
            </div>
            <div class="energy-bar mp-bar @(Vm.MpLow ? "low" : null)" role="meter" aria-label="@Vm.MpLabel" aria-valuemin="0" aria-valuemax="@Vm.MaxMp" aria-valuenow="@Vm.Mp" data-tip="@Vm.MpLabel">
                <span class="energy-fill mp-fill" style="height: @(Math.Round(Vm.MpFraction * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
            </div>
            <div class="energy-bar @(Vm.EnergyLow ? "low" : null) @(Vm.EnergyPulsing ? "pulse" : null) @(Vm.Running ? "running" : null)" role="meter" aria-label="@Vm.EnergyLabel" aria-valuemin="0" aria-valuemax="@Vm.MaxEnergy" aria-valuenow="@Vm.Energy" data-tip="@Vm.EnergyTip">
                <span class="energy-fill" style="height: @(Math.Round(Vm.EnergyFraction * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span>
            </div>
        </div>
    </GamePanel>
}
