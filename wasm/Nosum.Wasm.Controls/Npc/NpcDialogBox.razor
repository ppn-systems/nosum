@using Nosum.Wasm.ViewModels.Npc
@inherits ObservingComponent<NpcDialogViewModel>

@* The merchant's dialog box (docs/adr/ADR-043 D3), at the bottom of the screen: the portrait, the name and what the merchant does, a line of talk and one button per
   thing the merchant offers, then Leave. Buy, Sell and the others open a dialog of their own over the game; nothing here talks to the server. *@
@if (Vm.IsSpeaking && Vm.Npc is not null)
{
    <div class="npc-box-wrap">
        <GamePanel Title="@Vm.Name" Class="npc-box" Role="dialog">
            <div class="npc-box-body">
                <img class="npc-portrait @(Vm.PortraitTalking ? "npc-portrait-talking" : null)" src="@Vm.PortraitUrl" alt="" />
                <div class="npc-box-text">
                    <p class="npc-role">@Vm.Role</p>
                    @* A click on the line finishes it while it types out (issue #214); once it is done the arrow shows the choices are next. *@
                    <p class="npc-line @(Vm.IsRevealing ? "npc-line-typing" : null)" @onclick="@(() => Vm.Skip())">@Vm.Line<span class="npc-prompt" aria-hidden="true"><GameIcon Name="dialog-arrow" /></span></p>
                </div>
            </div>
            <GameRow Class="npc-actions">
                @foreach (NpcChoice choice in Vm.Choices)
                {
                    NpcChoice current = choice;
                    <GameButton Text="@current.Label" OnClick="@(() => Vm.Choose(current.Action))" />
                }
                <GameButton Variant="plain" Text="@Vm.LeaveLabel" OnClick="@(() => Vm.Leave())" />
            </GameRow>
        </GamePanel>
    </div>
}
