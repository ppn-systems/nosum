@using Nosum.Wasm.ViewModels.Help
@inherits ObservingComponent<HelpViewModel>

@* The keyboard help card: every key, grouped. All text comes from the view model; the key caps are the shared GameKey. *@
<GamePanel Title="@Vm.Title" CloseText="@Vm.Text("Panel_Close")" OnClose="OnClose" Class="help">
    <div class="help-sections">
        @foreach (HelpSection section in Vm.Sections)
        {
            <GameSection Title="@section.Title">
                @foreach (HelpEntry entry in section.Entries)
                {
                    <div class="help-entry">
                        <span class="help-keys">
                            @foreach (string key in entry.Keys)
                            {
                                <GameKey Text="@key" />
                            }
                        </span>
                        <span>@entry.Description</span>
                    </div>
                }
            </GameSection>
        }
    </div>
</GamePanel>

@code {
    /// <summary>Raised when the close button is clicked.</summary>
    [Parameter] public EventCallback OnClose { get; set; }
}
