@* The one layout system of the in-game UI: dock regions on a full-screen grid, so nothing can overlap. A control never positions itself;
   it is put in a region:

     top-left (quest tracker, arrange key strip) | top-center (a notice) | top-right (coins, settings button)
                              | center (the game menu)  |
                              | bottom-center (key strip, message, hotbar) |

   Overlay is above everything (dialogs) and dims the screen. The HUD itself never takes the mouse; only the controls in it do. *@
<div class="game-hud">
    <div class="hud-backdrop"></div>
    <div class="hud-row hud-top">
        <div class="hud-region hud-top-left">@TopLeft</div>
        <div class="hud-region hud-top-center">@TopCenter</div>
        <div class="hud-region hud-top-right">@TopRight</div>
    </div>
    <div class="hud-row hud-middle">
        <div class="hud-region hud-center">@Center</div>
    </div>
    <div class="hud-row hud-bottom">
        <div class="hud-region hud-bottom-center">@BottomCenter</div>
    </div>
    <div class="hud-bottom-left">@BottomLeft</div>
    <div class="hud-overlay">@Overlay</div>
</div>

@code {
    /// <summary>Top-left corner (the quest tracker and, in a furniture place, the key strip under it).</summary>
    [Parameter] public RenderFragment? TopLeft { get; set; }

    /// <summary>Top, centred (a notice, a connection problem).</summary>
    [Parameter] public RenderFragment? TopCenter { get; set; }

    /// <summary>Top-right corner (coins and the settings button).</summary>
    [Parameter] public RenderFragment? TopRight { get; set; }

    /// <summary>The modal area: the game menu. Null when it is closed.</summary>
    [Parameter] public RenderFragment? Center { get; set; }

    /// <summary>Bottom, centred (the arrange key strip and the message line above the hotbar).</summary>
    [Parameter] public RenderFragment? BottomCenter { get; set; }

    /// <summary>Bottom-left corner (the chat line).</summary>
    [Parameter] public RenderFragment? BottomLeft { get; set; }

    /// <summary>Above everything: dialogs and forms that need an answer. Null when there is none.</summary>
    [Parameter] public RenderFragment? Overlay { get; set; }
}
