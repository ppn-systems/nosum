@using Nosum.Wasm.Controls.Common
@using Nosum.Wasm.ViewModels.Minimap
@inherits ObservingComponent<MinimapViewModel>

@* The minimap card under the HUD's top-right row: the same 9-slice wood frame as the panels. The canvas draws the map inside it (MapScene.Minimap);
   a click opens the world map. When the player hid the map in Settings (and on a phone, by default) the card collapses into one map button in the
   same column; a phone has no map button, its Menu window lists the world map (docs/design/ui-standard.md section 6). *@
@if (Vm.Drawn)
{
    <button type="button" class="hud-minimap" aria-label="@Vm.Tip" data-tip="@Vm.Tip" @onmousedown:preventDefault @onclick="OnOpen"></button>
}
else if (Vm.ShowsButton)
{
    @* The player (or a phone, by default) hid the map: its one button keeps the world map in reach. An M-key hide leaves no card and no button. *@
    <div class="hud-minimap-button">
        <GameIconButton Icon="tab-market" Tip="@Vm.Tip" OnClick="OnOpen" />
    </div>
}

@code {
    /// <summary>Raised by a click on the card or the button: opens the world map.</summary>
    [Parameter] public EventCallback OnOpen { get; set; }
}
