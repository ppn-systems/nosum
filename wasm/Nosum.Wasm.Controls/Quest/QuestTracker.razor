@inherits ObservingComponent<QuestTrackerViewModel>

@* The quest in progress: its name and one line per objective with a checkbox. Click the title to fold it to that one line; the long hint is its tooltip.
   (Or the banner of the quest just finished.) All text comes from the view model. *@
@if (Vm.IsVisible)
{
    @if (Vm.IsCompleted)
    {
        <GamePanel Class="hud quest completed" Title="">
            <strong class="banner">@Vm.CompletedText</strong>
        </GamePanel>
    }
    else
    {
        <GamePanel Class="hud quest" Title="">
            <button type="button" class="quest-head" tabindex="-1" aria-expanded="@(_open ? "true" : "false")" data-tip="@(Vm.Heading + ": " + Vm.Title + (Vm.Hint.Length > 0 ? "\n" + Vm.Hint : string.Empty))"
                    @onmousedown:preventDefault @onclick="() => _open = !_open">
                <span class="quest-fold">@(_open ? "-" : "+")</span><span class="quest-title">@Vm.Title</span>
            </button>
            @if (_open)
            {
                <ul class="objectives">
                    @foreach (ObjectiveLine line in Vm.Objectives)
                    {
                        <li class="@(line.IsDone ? "done" : null)"><span class="check"></span><span class="obj-text">@line.Text</span><span class="count">@line.Progress</span></li>
                    }
                </ul>
            }
        </GamePanel>
    }
}

@code {
    private bool _open = true;
}
