@using Nosum.Wasm.Controls.Menu
@using Nosum.Wasm.ViewModels.Blacksmith
@using Nosum.Wasm.Controls.Building
@using Nosum.Wasm.ViewModels.Building
@using Microsoft.JSInterop
@using Nosum.Wasm.ViewModels.Shop
@inherits ObservingComponent<ShopViewModel>
@implements IAsyncDisposable
@inject IJSRuntime Js

@* One shop, chosen by ShopId (seed, clothing or furniture shop): pick what to buy for coins. The title and the list come from the shared shop catalogue,
   and the server prices and checks every purchase. Self-contained: it opens the shop on its view model by itself, so a host only sets ShopId and Vm.
   The blacksmith's counter (docs/adr/ADR-026 D2) also shows its tool upgrades under the list when the host gives it the blacksmith's view model. *@
<MenuPage Status="@Vm.Status" Good="Vm.StatusIsGood">
    <GameStack>
        @if (Tabbed)
        {
            @* The carpenter's counter is split into tabs, so each one fits a 1280×720 panel without a scrollbar (docs/design/ui-standard.md section 3). *@
            <TabBar Tabs="CarpenterTabs()" Active="(int)Current" OnSelect="SelectTab" />
        }
        @if (ShowGoods)
        {
            @* One row at the top: the balance, the quantity presets (one, five, all) and the quantity stepper (ui-standard sections 1 and 8).
               Spacing shrinks to fit the row; the font does not. The field keeps its accessible name, so the row needs no label. *@
            <div class="shop-head">
                <GameRow Class="spread shop-top">
                    <span>@Vm.CoinsText</span>
                    <TabBar Tabs="PresetTabs()" Active="Vm.ActivePreset" OnSelect="SelectPreset" />
                    <GameButton Variant="secondary" Text="@Vm.Text("Shop_Qty_Less")" Disabled="@(Vm.Quantity <= 1)" OnClick="@(() => Vm.Step(-1))" />
                    <span class="shop-qty"><GameInput Type="number" Value="@Vm.QuantityText" ValueChanged="@(v => { Vm.QuantityText = v; Vm.Touch(); })" Label="@Vm.Text("Shop_Quantity")" MaxLength="2" /></span>
                    <GameButton Variant="secondary" Text="@Vm.Text("Shop_Qty_More")" Disabled="@(Vm.Quantity >= ShopViewModel.MaxQuantity)" OnClick="@(() => Vm.Step(1))" />
                </GameRow>
            </div>
            @if (Vm.Pending is not null)
            {
                @* A bulk order, or one that costs a quarter of the balance: the player confirms the total before any coins move (issue #215). *@
                <GameNotice Kind="info" Text="@Vm.PendingText" />
                <GameRow Class="center">
                    <GameButton Text="@Vm.Text("Shop_Confirm_Yes")" OnClick="Vm.Confirm" />
                    <GameButton Variant="secondary" Text="@Vm.Text("Shop_Confirm_No")" OnClick="Vm.CancelPurchase" />
                </GameRow>
            }
            @* Two columns of compact rows on a desktop, one on a phone (ShopPanel.razor.css). The page holds columns x rows items. *@
            <div class="shop-list" @ref="_listRef">
                @foreach (ShopOfferDisplay offer in Vm.PageOffers)
                {
                    int itemId = offer.ItemId;
                    <GameRow Class="@RowClass(offer)">
                        @* A greyed row (out of season) is not clickable: its price cell carries the reason (docs/design/research-hud-and-loops.md, item 4). *@
                        <ItemSlotButton Slot="offer.Item" Picked="@(Vm.Detail?.ItemId == itemId)" OnClick="@(() => { if (offer.SeasonNote.Length == 0) { Vm.Select(itemId); } })" Tip="@offer.Item.Name" />
                        <span class="shop-text">
                            <span class="shop-name">@offer.Item.Name</span>
                            <span class="shop-price">@offer.PriceText</span>
                        </span>
                        <GameButton Text="@Vm.Text("Shop_Buy")" Disabled="!offer.CanBuy" OnClick="@(() => Vm.Buy(itemId))" />
                    </GameRow>
                }
            </div>
            @if (Vm.PageCount > 1)
            {
                <Pager Page="Vm.Page" PageCount="Vm.PageCount" PreviousText="@Vm.Text("Pager_Previous")" NextText="@Vm.Text("Pager_Next")"
                       PositionText="@Vm.Text("Pager_Position", Vm.Page + 1, Vm.PageCount)" OnPage="@(p => Vm.GoToPage(p))" />
            }
            @if (Vm.Detail is { } detail)
            {
                @* The detail strip: what the selected item is and does, what the typed quantity costs, and why Buy is off when it is (ui-standard section 3). *@
                <GameSection>
                    <p>@detail.Description</p>
                    @foreach (string effect in detail.Effects)
                    {
                        <p>@effect</p>
                    }
                    <GameRow Class="spread">
                        <span>@detail.PriceText</span>
                        <span>@detail.TotalText</span>
                    </GameRow>
                    @if (detail.AfterText.Length > 0)
                    {
                        <p>@detail.AfterText</p>
                    }
                    @if (detail.BlockText.Length > 0)
                    {
                        <GameNotice Kind="info" Text="@detail.BlockText" />
                    }
                </GameSection>
            }
        }
        @if (ShowExtras)
        {
            @if (Vm.IsBlacksmithShop && Smith is not null)
            {
                <BlacksmithSection Vm="Smith" />
            }
            @if (Tabbed)
            {
                <CarpenterSections Vm="Carpenter" Section="Current" ShowAnimals="ShowAnimals" />
            }
        }
    </GameStack>
</MenuPage>

@code {
    private int _openedShop = -1;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ShopPanel>? _self;
    private int _watch;
    private ElementReference? _listRef;

    /// <summary>The shop to show, an id from <c>ShopCatalog</c>. Changing it opens the other shop.</summary>
    [Parameter, EditorRequired] public int ShopId { get; set; }

    /// <summary>The blacksmith's upgrade view model; only used when <see cref="ShopId"/> is the blacksmith's counter.</summary>
    [Parameter] public BlacksmithViewModel? Smith { get; set; }

    /// <summary>The carpenter's view model, when the shop is the carpenter's counter: its tabs (goods, buildings and animals, pets) replace the sections under the list (docs/adr/ADR-028).</summary>
    [Parameter] public CarpenterViewModel? Carpenter { get; set; }

    /// <summary>Whether the carpenter's Buildings tab lists the animals as well (the Build page). The Buy page shows the buildings only.</summary>
    [Parameter] public bool ShowAnimals { get; set; } = true;

    private CarpenterTab? _tab;

    /// <summary>Whether the carpenter's counter is shown as tabs.</summary>
    private bool Tabbed => Carpenter is not null && Vm.IsCarpenterShop && ShowExtras;

    /// <summary>The tab on show: the chosen one, or the first one the page offers (the Build page has no goods).</summary>
    private CarpenterTab Current => _tab is { } t && (t != CarpenterTab.Goods || ShowOffers) ? t : (ShowOffers ? CarpenterTab.Goods : CarpenterTab.Buildings);

    private bool ShowGoods => ShowOffers && (!Tabbed || Current == CarpenterTab.Goods);

    private IReadOnlyList<(int Id, string Label)> CarpenterTabs()
    {
        List<(int Id, string Label)> tabs = [];
        if (ShowOffers)
        {
            tabs.Add(((int)CarpenterTab.Goods, Carpenter!.Text("Carpenter_Tab_Goods")));
        }

        tabs.Add(((int)CarpenterTab.Buildings, Carpenter!.Text("Carpenter_Tab_Buildings")));
        tabs.Add(((int)CarpenterTab.Pets, Carpenter!.Text("Carpenter_Pets")));
        return tabs;
    }

    private void SelectTab(int id) => _tab = (CarpenterTab)id;

    private IReadOnlyList<(int Id, string Label)> PresetTabs() =>
    [
        (ShopViewModel.PresetOne, Vm.PresetLabel(ShopViewModel.PresetOne)),
        (ShopViewModel.PresetFive, Vm.PresetLabel(ShopViewModel.PresetFive)),
        (ShopViewModel.PresetAll, Vm.PresetLabel(ShopViewModel.PresetAll)),
    ];

    private void SelectPreset(int preset) => Vm.ChoosePreset(preset);

    /// <inheritdoc/>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        try
        {
            if (firstRender)
            {
                _module = await Js.InvokeAsync<IJSObjectReference>("import", "./_content/Nosum.Wasm.Controls/shop-rows.js");
                _self = DotNetObjectReference.Create(this);
                _watch = await _module.InvokeAsync<int>("watch", _self);
            }

            await this.MeasureRowsAsync();
        }
        catch (JSDisconnectedException)
        {
            // The page is going away.
        }
    }

    /// <summary>Called by shop-rows.js once the window has stopped resizing: the rows are measured again.</summary>
    [JSInvokable]
    public Task OnViewportChanged() => this.InvokeAsync(this.MeasureRowsAsync);

    /// <summary>
    /// Asks the window how much room the list has and gives the view model the whole rows that fit (docs/design/ui-standard.md section 3).
    /// The view model re-renders only when the count changes, so the render that follows measures to the same answer and stops.
    /// </summary>
    private async Task MeasureRowsAsync()
    {
        if (_module is null || !ShowGoods || _listRef is not { } list || Vm.PageOffers.Count == 0)
        {
            return;
        }

        double[]? room = await _module.InvokeAsync<double[]?>("measure", list);
        if (room is { Length: 4 })
        {
            Vm.SetLayout((int)room[3], ShopViewModel.RowsThatFit(room[0], room[1], room[2]));
        }
    }

    /// <inheritdoc/>
    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("unwatch", _watch);
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The page is going away.
        }

        _self?.Dispose();
        _self = null;
        this.Dispose();
    }

    /// <summary>A row is dimmed when the balance cannot cover one unit of it (the price still reads, the Buy button is off).</summary>
    private static string RowClass(ShopOfferDisplay offer) => offer.Dimmed ? "center shop-row shop-row-dim" : "center shop-row";

    /// <summary>Whether the list of what the shop sells is shown. The merchant's Build and Upgrade buttons show only the sections (docs/adr/ADR-043 D3).</summary>
    [Parameter] public bool ShowOffers { get; set; } = true;

    /// <summary>Whether the sections under the list (the blacksmith's upgrades, the carpenter's buildings) are shown. The merchant's Buy button shows only the list.</summary>
    [Parameter] public bool ShowExtras { get; set; } = true;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (_openedShop != ShopId)
        {
            _openedShop = ShopId;
            Vm.Open(ShopId);
            if (Vm.IsBlacksmithShop)
            {
                Smith?.Open();
            }
        }
    }
}
