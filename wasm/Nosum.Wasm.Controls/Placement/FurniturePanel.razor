@using Nosum.Wasm.Controls.Common
@using Nosum.Wasm.ViewModels.Placement
@inherits ObservingComponent<FurnitureCatalogViewModel>

@* (The key strip is PlacementPanel; the panel has no close button: arrange mode has no exit action yet.) *@

@* The furniture catalogue of the arrange mode: the owned pieces by category, with a search. Place carries the selected piece, so the ghost in
   the world previews it; Pick up takes the piece in front back into the bag. Shown only where furniture can be placed. All text comes from the view model. *@
@if (Vm.IsVisible)
{
    <TradeDialog Title="@Vm.Title" CloseText="" Size="PanelSize.M">
        <PlacementPanel Vm="Placement" />
        <div class="furniture-tabs">
            <TabBar Tabs="Vm.Tabs" Active="Vm.ActiveTab" OnSelect="@(id => Vm.SelectTab(id))" />
        </div>
        <GameInput Class="furniture-search" Value="@Vm.Search" ValueChanged="@(v => Vm.SetSearch(v))" Placeholder="@Vm.SearchPlaceholder" Label="@Vm.SearchPlaceholder" MaxLength="32" />
        <div class="furniture-grid">
            <ItemGrid Slots="Vm.Slots" Columns="6" OnSlotClick="@(i => Vm.Select(i))" />
        </div>
        @if (Vm.EmptyText is { } empty)
        {
            <p class="furniture-empty">@empty</p>
        }
        @if (Vm.DetailText is { } detail)
        {
            <p class="furniture-detail">@detail</p>
        }
        <div class="furniture-actions">
            <GameButton Variant="primary" Text="@Vm.PlaceLabel" Disabled="@(Vm.Selected is null)" OnClick="@(() => Vm.Carry(Vm.SelectedItemId))" />
            <GameButton Variant="plain" Text="@Vm.PickUpLabel" OnClick="Vm.PickUp" />
        </div>
    </TradeDialog>
}

@code {
    /// <summary>The arrange mode's key strip, shown first in the panel.</summary>
    [Parameter, EditorRequired] public PlacementViewModel Placement { get; set; } = default!;
}
