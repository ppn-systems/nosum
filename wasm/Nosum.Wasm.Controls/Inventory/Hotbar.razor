@using Nosum.Wasm.Controls.Progress
@inherits ObservingComponent<InventoryViewModel>

@* The hotbar: the first nine inventory slots. Number keys 1 to 9 select (handled by the game loop); a click selects too. *@
@if (Vm.Slots.Count > 0)
{
    <div class="hotbar-dock">
        <GamePanel Class="hud hotbar" Role="toolbar" Title="">
            <div class="hotbar-row">
                <div class="hotbar-slots" aria-label="@Vm.HotbarLabel">
                    @foreach (SlotDisplay slot in Vm.Hotbar)
                    {
                        int index = slot.Index;
                        <ItemSlotButton Slot="slot" Hotkey="@((index + 1).ToString(System.Globalization.CultureInfo.InvariantCulture))" OnClick="() => Vm.Select(index)" />
                    }
                </div>
                @if (Progress is not null)
                {
                    <div class="hotbar-skills" role="toolbar" aria-label="@Progress.CombatSkillsAriaLabel">
                        <GameButton Variant="chip" Disabled="@Progress.WhirlwindDisabled" Title="@($"{Progress.WhirlwindLabel}\n{Progress.WhirlwindTip}")" aria-label="@Progress.WhirlwindLabel" OnClick="@(() => Progress.CastSkill(1))"><GameKey Text="Z" /></GameButton>
                        <GameButton Variant="chip" Disabled="@Progress.FireballDisabled" Title="@($"{Progress.FireballLabel}\n{Progress.FireballTip}")" aria-label="@Progress.FireballLabel" OnClick="@(() => Progress.CastSkill(2))"><GameKey Text="X" /></GameButton>
                        <GameButton Variant="chip" Disabled="@Progress.DivineHealDisabled" Title="@($"{Progress.DivineHealLabel}\n{Progress.DivineHealTip}")" aria-label="@Progress.DivineHealLabel" OnClick="@(() => Progress.CastSkill(3))"><GameKey Text="V" /></GameButton>
                    </div>
                }
            </div>
        </GamePanel>
        @if (Progress is not null)
        {
            @if (Progress.CurrentCombo > 1 || Progress.IsLevelUpActive)
            {
                <div class="hotbar-badges">
                    @if (Progress.CurrentCombo > 1)
                    {
                        <GameBadge Kind="warn" Text="@Progress.ComboBadgeText" />
                    }
                    @if (Progress.IsLevelUpActive)
                    {
                        <GameBadge Kind="ok" Text="@Progress.LevelUpBadgeText" />
                    }
                </div>
            }
            @* The thin energy gauge stands beside the slots (docs/adr/ADR-023 D6). *@
            <EnergyBar Vm="Progress" />
        }
    </div>
}

@code {
    private Nosum.Wasm.ViewModels.Progress.ProgressViewModel? _subscribedProgress;

    /// <summary>The energy view model; when given, its bar stands beside the slots.</summary>
    [Parameter] public Nosum.Wasm.ViewModels.Progress.ProgressViewModel? Progress { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (ReferenceEquals(_subscribedProgress, Progress))
        {
            return;
        }

        if (_subscribedProgress is not null)
        {
            _subscribedProgress.Changed -= OnProgressChanged;
        }

        _subscribedProgress = Progress;
        if (_subscribedProgress is not null)
        {
            _subscribedProgress.Changed += OnProgressChanged;
        }
    }

    protected override void Dispose(bool disposing)
    {
        if (disposing && _subscribedProgress is not null)
        {
            _subscribedProgress.Changed -= OnProgressChanged;
            _subscribedProgress = null;
        }

        base.Dispose(disposing);
    }

    private void OnProgressChanged() => _ = InvokeAsync(StateHasChanged);
}
