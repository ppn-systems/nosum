@using Nosum.Wasm.Controls.Progress
@inherits ObservingComponent<InventoryViewModel>

@* The hotbar: the first nine inventory slots. Number keys 1 to 9 select (handled by the game loop); a click selects too. *@
@if (Vm.Slots.Count > 0)
{
    <div class="hotbar-dock">
        <GamePanel Class="hud hotbar" Role="toolbar" Title="">
            <div class="hotbar-slots" aria-label="@Vm.HotbarLabel">
                @foreach (SlotDisplay slot in Vm.Hotbar)
                {
                    int index = slot.Index;
                    <ItemSlotButton Slot="slot" Hotkey="@((index + 1).ToString(System.Globalization.CultureInfo.InvariantCulture))" OnClick="() => Vm.Select(index)" />
                }
            </div>
        </GamePanel>
        <div class="combat-skills-dock" role="toolbar" aria-label="Combat Skills">
            <button type="button" class="skill-btn skill-whirlwind" title="Whirlwind Cleave [Z] (15 MP)" @onclick="() => OnSkill?.Invoke(1)">
                <span class="skill-key">Z</span>
                <span class="skill-glyph">⚔️</span>
                <span class="skill-cost">15</span>
            </button>
            <button type="button" class="skill-btn skill-fireball" title="Fireball Pyromancy [X] (25 MP)" @onclick="() => OnSkill?.Invoke(2)">
                <span class="skill-key">X</span>
                <span class="skill-glyph">🔥</span>
                <span class="skill-cost">25</span>
            </button>
            <button type="button" class="skill-btn skill-divine-heal" title="Divine Heal [V] (20 MP)" @onclick="() => OnSkill?.Invoke(3)">
                <span class="skill-key">V</span>
                <span class="skill-glyph">✨</span>
                <span class="skill-cost">20</span>
            </button>
        </div>
        @if (Progress is not null && Progress.CurrentCombo > 1)
        {
            <div class="combat-combo-badge" role="status" aria-live="polite" title="Combat Combo Streak!">
                <span class="combo-icon">🔥</span>
                <span class="combo-val">@Progress.CurrentCombo x</span>
                <span class="combo-label">COMBO!</span>
                <span class="combo-bonus">+@Progress.ComboBonusPercent%</span>
            </div>
        }
        @if (Progress is not null)
        {
            @* The thin energy gauge stands beside the slots (docs/adr/ADR-023 D6). *@
            <EnergyBar Vm="Progress" />
        }
    </div>
}

@code {
    /// <summary>The energy view model; when given, its bar stands beside the slots.</summary>
    [Parameter] public Nosum.Wasm.ViewModels.Progress.ProgressViewModel? Progress { get; set; }

    /// <summary>Invoked when a combat skill button is triggered (docs/adr/ADR-056).</summary>
    [Parameter] public Action<byte>? OnSkill { get; set; }
}
