@* One inventory slot: the item's picture, its quantity, a selected frame and a hotkey label. Text comes from the slot (already localized).
   The size is the theme's (a slot is 18 UI pixels, the picture 16). *@
<button type="button"
        class="slot @(Slot.IsSelected ? "selected" : null) @(Picked ? "picked" : null) @(Slot.IsEmpty ? "empty" : null)"
        data-tip="@(Tip ?? Slot.Tooltip)"
        aria-label="@(Slot.IsEmpty ? null : Slot.Name)"
        @onmousedown:preventDefault
        @oncontextmenu:preventDefault
        @oncontextmenu="RightClicked"
        @onclick="Clicked">
    @if (Hotkey is not null)
    {
        <span class="hotkey">@Hotkey</span>
    }
    @if (Slot.IsEmpty && Ghost is not null)
    {
        <span class="ghost" style="background-image:var(--nosum-img-@(Ghost));--gw:var(--nosum-w-@(Ghost));--gh:var(--nosum-h-@(Ghost))"></span>
    }
    @if (Slot.Icon is { } icon)
    {
        <span class="icon" style="@IconStyle(icon)"></span>
    }
    @if (Slot.Meter is { } meter)
    {
        <span class="meter"><span style="width: @(Math.Round(Math.Clamp(meter, 0, 1) * 100).ToString(System.Globalization.CultureInfo.InvariantCulture))%"></span></span>
        <span class="quantity">@Slot.MeterText</span>
    }
    else if (Slot.Quantity > 1)
    {
        <span class="quantity">@Slot.Quantity</span>
    }
</button>

@code {
    /// <summary>The slot to show.</summary>
    [Parameter, EditorRequired] public SlotDisplay Slot { get; set; } = default!;

    /// <summary>Obsolete and ignored: the slot size is the theme's.</summary>
    [Parameter] public int Scale { get; set; }

    /// <summary>The key shown in the corner (for the hotbar), or <see langword="null"/>.</summary>
    [Parameter] public string? Hotkey { get; set; }

    /// <summary>A tooltip that replaces the slot's own (an equipment slot names what goes there), or <see langword="null"/>.</summary>
    [Parameter] public string? Tip { get; set; }

    /// <summary>A theme glyph drawn faintly while the slot is empty (<c>glyph-hat</c>, ...), or <see langword="null"/>.</summary>
    [Parameter] public string? Ghost { get; set; }

    /// <summary>Whether the slot was picked up and waits for a target.</summary>
    [Parameter] public bool Picked { get; set; }

    /// <summary>Raised when the slot is clicked.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    /// <summary>Raised instead of <see cref="OnClick"/> when the slot is clicked with Shift held (a quick move); ignored when nobody listens.</summary>
    [Parameter] public EventCallback OnShiftClick { get; set; }

    /// <summary>Raised when the slot is right-clicked (a long press on touch); the browser's menu is suppressed. Nothing happens when nobody listens.</summary>
    [Parameter] public EventCallback OnRightClick { get; set; }

    private Task Clicked(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
        => e.ShiftKey && OnShiftClick.HasDelegate ? OnShiftClick.InvokeAsync() : OnClick.InvokeAsync();

    private Task RightClicked(Microsoft.AspNetCore.Components.Web.MouseEventArgs e)
        => OnRightClick.HasDelegate ? OnRightClick.InvokeAsync() : Task.CompletedTask;

    // The picture is the sprite itself, scaled to fit the slot's picture and centred by the slot. The box is exactly the scaled sprite, so no
    // neighbouring art shows through. Lengths are UI pixels (--u), set here so each slot carries its own geometry.
    private static string IconStyle(ItemIcon icon)
    {
        if (icon.ThemeImage is { } name)
        {
            return FormattableString.Invariant($"background-image:var(--nosum-img-{name});width:calc({ItemIcon.PictureSize} * var(--u));height:calc({ItemIcon.PictureSize} * var(--u));background-size:calc({ItemIcon.PictureSize} * var(--u)) calc({ItemIcon.PictureSize} * var(--u))");
        }

        double scale = icon.FitScale;
        return FormattableString.Invariant($"background-image:url('{icon.SheetUrl}');width:calc({icon.Width * scale} * var(--u));height:calc({icon.Height * scale} * var(--u));background-size:calc({icon.SheetWidth * scale} * var(--u)) calc({icon.SheetHeight * scale} * var(--u));background-position:calc({-icon.X * scale} * var(--u)) calc({-icon.Y * scale} * var(--u))");
    }
}
