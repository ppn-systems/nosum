@* A small pixel-art weather icon. Kind: sun, rain, storm or snow. Decorative: the text next to it carries the meaning. *@
<span class="weather-icon @Kind" aria-hidden="true"></span>

@code {
    /// <summary>The weather: <c>sun</c>, <c>rain</c>, <c>storm</c> or <c>snow</c>.</summary>
    [Parameter] public string Kind { get; set; } = "sun";
}
