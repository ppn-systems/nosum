@using Nosum.Wasm.Controls.Common
@using Nosum.Wasm.Controls.Menu
@using Nosum.Wasm.ViewModels.Pets
@inherits ObservingComponent<PetViewModel>

@* The pet panel (docs/adr/ADR-075 D3-D4 and its amendment): with a pet, its name, its mood, the petting button (once a game day) and "Give back", which asks
   first (PetRehomeOverlay); with none, where a cat or a dog is bought, at the carpenter's counter. The status line under it shows the server's answer. *@
<MenuPage Status="@Vm.Status" Good="Vm.StatusIsGood">
    <GameStack>
        @if (Vm.HasPet)
        {
            <GameSection Title="@Vm.Pet.Name">
                <p>@Vm.KindName</p>
                <GameField Label="@Vm.Text("Pet_Mood")">
                    <GameProgress Percent="@Vm.MoodPercent" Text="@Vm.MoodPercent.ToString()" Label="@Vm.Text("Pet_Mood")" />
                </GameField>
                <GameRow>
                    <GameButton Text="@Vm.Text("Pet_Pet")" Disabled="@(!Vm.CanPet)" OnClick="@(() => Vm.PetIt())" />
                    <GameButton Variant="plain" Text="@Vm.Text("Pet_Rehome")" OnClick="@(() => Vm.AskRehome())" />
                </GameRow>
                @if (Vm.Pet.PettedToday)
                {
                    <GameNotice Kind="info" Text="@Vm.Text("Pet_AlreadyPetted")" />
                }
            </GameSection>
        }
        else if (Vm.IsLoaded)
        {
            <GameSection Title="@Vm.Text("Pet_NoPetTitle")">
                <p>@Vm.BuyHintText</p>
            </GameSection>
        }
    </GameStack>
</MenuPage>
