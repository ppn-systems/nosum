@using Nosum.Wasm.Controls.Menu
@using Nosum.Wasm.ViewModels.Trade
@inherits ObservingComponent<TradeViewModel>

@* The trade window: pick a player, then both sides fill an offer and confirm. Any change clears both confirmations on the server. *@
<MenuPage Status="@Vm.Status" Good="Vm.StatusIsGood" Footer="@(Vm.Phase == TradePhase.Open ? Actions() : null)">
    <GameStack>
        @if (Vm.Phase == TradePhase.Open)
        {
            @* Both offers side by side; under them the player's coins and bag. Confirm and cancel stay pinned under the scrolling part (Footer). *@
            <div class="trade-sides">
                <GameSection Title="@Vm.Text("Trade_Yours")">
                    <ItemGrid Slots="Vm.MyItems" Columns="4" OnSlotClick="@(i => Vm.Withdraw(i))" />
                    <p class="trade-coins">@Vm.Text("Trade_Coins", Vm.MyCoins)</p>
                    <p class="trade-state">@(Vm.MyConfirmed ? Vm.Text("Trade_Confirmed") : Vm.Text("Trade_NotConfirmed"))</p>
                </GameSection>
                <GameSection Title="@Vm.OtherLabel">
                    <ItemGrid Slots="Vm.OtherItems" Columns="4" />
                    <p class="trade-coins">@Vm.Text("Trade_Coins", Vm.OtherCoins)</p>
                    <p class="trade-state">@(Vm.OtherConfirmed ? Vm.Text("Trade_Confirmed") : Vm.Text("Trade_NotConfirmed"))</p>
                </GameSection>
            </div>
            <GameRow>
                <span>@Vm.Text("Trade_AddCoins")</span>
                <PriceInput Class="narrow" Value="@Vm.CoinsText" ValueChanged="@(v => Vm.CoinsText = v)" OnEnter="@(() => Vm.SetCoins())" Label="@Vm.Text("Trade_AddCoins")" Unit="@Vm.Text("Wallet_Caption")" />
                <GameButton Text="@Vm.Text("Trade_SetCoins")" OnClick="@(() => Vm.SetCoins())" />
            </GameRow>
            <p class="trade-state">@Vm.Text("Trade_PickItems")</p>
            <ItemGrid Slots="Vm.InventorySlots" Columns="9" OnSlotClick="@(i => Vm.Offer(i))" />
        }
        else if (Vm.Phase == TradePhase.Waiting)
        {
            <p class="trade-state">@Vm.Text("Trade_Waiting")</p>
            <GameButton Variant="danger" Text="@Vm.Text("Trade_Cancel")" OnClick="@(() => Vm.Cancel())" />
        }
        else
        {
            <GameSection Title="@Vm.Text("Trade_PickPlayer")">
                <PlayerPicker Players="Vm.Players" ActionText="@Vm.Text("Trade_Invite")" EmptyText="@Vm.Text("Trade_NobodyNear")" OnPick="@(id => Vm.Invite(id))" />
            </GameSection>
        }
    </GameStack>
</MenuPage>

@code {
    private RenderFragment Actions() => @<GameRow>
        <GameButton Text="@Vm.ConfirmLabel" Disabled="Vm.MyConfirmed || Vm.ConfirmLocked" OnClick="@(() => Vm.Confirm())" />
        <GameButton Variant="danger" Text="@Vm.Text("Trade_Cancel")" OnClick="@(() => Vm.Cancel())" />
    </GameRow>;
}
