@using Nosum.Wasm.Controls.Menu
@using Nosum.Wasm.ViewModels.Profile
@inherits ObservingComponent<ProfileViewModel>

@* The player's profile: the nickname everyone sees above the head, and changing it. The server checks the rules, uniqueness and the 24-hour wait.
   A guest cannot rename: the form is replaced by a note that registering unlocks it. *@
<MenuPage Status="@Vm.Status" Good="Vm.StatusIsGood">
    <GameStack>
        <GameSection>
            <p>@Vm.CurrentText</p>
        </GameSection>
        @if (Vm.CanRename)
        {
            <GameField Label="@Vm.Text("Profile_NewLabel")" Hint="@Vm.RuleText">
                <GameInput Value="@Vm.NewNickname" ValueChanged="@(v => Vm.NewNickname = v)" OnEnter="@(() => Vm.SaveAsync(default))"
                           Placeholder="@Vm.Text("Profile_NewLabel")" Label="@Vm.Text("Profile_NewLabel")" MaxLength="24" />
            </GameField>
            <GameButton Text="@Vm.Text("Profile_Save")" Disabled="Vm.IsBusy" OnClick="@(() => Vm.SaveAsync(default))" />
        }
        else
        {
            <GameNotice Kind="info" Text="@Vm.GuestNoticeText" />
        }
    </GameStack>
</MenuPage>
