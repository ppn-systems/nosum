<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <Description>Nosum Blazor WebAssembly host: the game canvas page plus the UI overlay (inventory, shop, chat).</Description>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Required by the [JSExport] source generator (Game/GameLoop.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Tester tools (Game/DevTools.cs, docs/adr/ADR-013 amendments) exist only in a build made with -p:NosumDevTools=true; a normal or Production publish has none. -->
  <PropertyGroup Condition="'$(NosumDevTools)' == 'true'">
    <DefineConstants>$(DefineConstants);NOSUM_DEV_TOOLS</DefineConstants>
  </PropertyGroup>

  <!-- Placeholder content served from the repository's assets/ folder (docs/adr/ADR-007):
       only the files the client loads, linked so assets/ stays the single copy. -->
  <ItemGroup>
    <Content Include="..\..\assets\Maps\springobjects.png" Link="wwwroot\assets\Maps\%(Filename)%(Extension)" />
    <!-- Maps of Nosum.Gameplay.Maps.GameMaps and the tilesheets they name; GameMapsTests checks that every one is listed. -->
    <Content Include="..\..\assets\Maps\Farm.tmx;..\..\assets\Maps\FarmHouse.tmx;..\..\assets\Maps\BusStop.tmx;..\..\assets\Maps\Forest.tmx;..\..\assets\Maps\Town.tmx;..\..\assets\Maps\Backwoods.tmx;..\..\assets\Maps\Farm_Foraging.tmx;..\..\assets\Maps\Mine.tmx" Link="wwwroot\assets\Maps\%(Filename)%(Extension)" />
    <!-- The forty floor plans of the mine and their three sheets (docs/adr/ADR-026 D3); the maps name their sheet relative to their own folder. -->
    <Content Include="..\..\assets\Maps\Mines\1.tmx;..\..\assets\Maps\Mines\2.tmx;..\..\assets\Maps\Mines\3.tmx;..\..\assets\Maps\Mines\4.tmx;..\..\assets\Maps\Mines\5.tmx;..\..\assets\Maps\Mines\6.tmx;..\..\assets\Maps\Mines\7.tmx;..\..\assets\Maps\Mines\8.tmx;..\..\assets\Maps\Mines\9.tmx;..\..\assets\Maps\Mines\10.tmx;..\..\assets\Maps\Mines\11.tmx;..\..\assets\Maps\Mines\12.tmx;..\..\assets\Maps\Mines\13.tmx;..\..\assets\Maps\Mines\14.tmx;..\..\assets\Maps\Mines\15.tmx;..\..\assets\Maps\Mines\16.tmx;..\..\assets\Maps\Mines\17.tmx;..\..\assets\Maps\Mines\18.tmx;..\..\assets\Maps\Mines\19.tmx;..\..\assets\Maps\Mines\20.tmx;..\..\assets\Maps\Mines\21.tmx;..\..\assets\Maps\Mines\22.tmx;..\..\assets\Maps\Mines\23.tmx;..\..\assets\Maps\Mines\24.tmx;..\..\assets\Maps\Mines\25.tmx;..\..\assets\Maps\Mines\26.tmx;..\..\assets\Maps\Mines\27.tmx;..\..\assets\Maps\Mines\28.tmx;..\..\assets\Maps\Mines\29.tmx;..\..\assets\Maps\Mines\41.tmx;..\..\assets\Maps\Mines\31.tmx;..\..\assets\Maps\Mines\32.tmx;..\..\assets\Maps\Mines\33.tmx;..\..\assets\Maps\Mines\34.tmx;..\..\assets\Maps\Mines\35.tmx;..\..\assets\Maps\Mines\36.tmx;..\..\assets\Maps\Mines\37.tmx;..\..\assets\Maps\Mines\38.tmx;..\..\assets\Maps\Mines\39.tmx;..\..\assets\Maps\Mines\40.tmx;..\..\assets\Maps\Mines\mine.png;..\..\assets\Maps\Mines\mine_dark.png;..\..\assets\Maps\Mines\mine_desert.png" Link="wwwroot\assets\Maps\Mines\%(Filename)%(Extension)" />
    <Content Include="..\..\assets\Maps\paths.png;..\..\assets\Maps\spring_outdoorsTileSheet.png;..\..\assets\Maps\spring_outdoorsTileSheet2.png;..\..\assets\Maps\spring_outdoorTileSheet_extra.png;..\..\assets\Maps\spring_town.png;..\..\assets\Maps\spring_monsterGraveTiles.png;..\..\assets\Maps\spring_Shadows.png;..\..\assets\Maps\spring_Waterfalls.png;..\..\assets\Maps\townInterior.png;..\..\assets\Maps\farmhouse_tiles.png;..\..\assets\Maps\walls_and_floors.png" Link="wwwroot\assets\Maps\%(Filename)%(Extension)" />
