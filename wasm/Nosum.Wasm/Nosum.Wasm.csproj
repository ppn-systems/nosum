<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <Description>Nosum Blazor WebAssembly host: the game canvas page plus the UI overlay (inventory, shop, chat).</Description>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Required by the [JSExport] source generator (Game/GameLoop.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Tester tools (Game/DevTools.cs, docs/adr/ADR-013 amendments) exist only in a build made with -p:NosumDevTools=true; a normal or Production publish has none. -->
  <PropertyGroup Condition="'$(NosumDevTools)' == 'true'">
    <DefineConstants>$(DefineConstants);NOSUM_DEV_TOOLS</DefineConstants>
  </PropertyGroup>

  <!-- Placeholder content served from the repository's assets/ folder (docs/adr/ADR-007):
       only the files the client loads, linked so assets/ stays the single copy. -->
  <ItemGroup>
    <Content Include="..\..\assets\sprites\items.png" Link="wwwroot\assets\sprites\%(Filename)%(Extension)" />
    <!-- Maps of Nosum.Gameplay.Maps.GameMaps and the tilesheets they name; GameMapsTests checks that every one is listed. -->
    <!-- Every hosted map has an own file (art/README.md): it and the own sheets it draws are linked from art/own/Maps/ to the same paths. -->
    <Content Include="..\..\art\own\Maps\Farm.tmx;..\..\art\own\Maps\terrain.png;..\..\art\own\Maps\town.png;..\..\art\own\Maps\nature.png;..\..\art\own\Maps\markers.png" Link="wwwroot\assets\Maps\%(Filename)%(Extension)" />
    <!-- The forty floor plans of the mine (docs/adr/ADR-026 D3); they name their sheet, cave.png, relative to their own folder. -->
    <Content Include="..\..\art\own\Maps\Mines\1.tmx;..\..\art\own\Maps\Mines\2.tmx;..\..\art\own\Maps\Mines\3.tmx;..\..\art\own\Maps\Mines\4.tmx;..\..\art\own\Maps\Mines\5.tmx;..\..\art\own\Maps\Mines\6.tmx;..\..\art\own\Maps\Mines\7.tmx;..\..\art\own\Maps\Mines\8.tmx;..\..\art\own\Maps\Mines\9.tmx;..\..\art\own\Maps\Mines\10.tmx;..\..\art\own\Maps\Mines\11.tmx;..\..\art\own\Maps\Mines\12.tmx;..\..\art\own\Maps\Mines\13.tmx;..\..\art\own\Maps\Mines\14.tmx;..\..\art\own\Maps\Mines\15.tmx;..\..\art\own\Maps\Mines\16.tmx;..\..\art\own\Maps\Mines\17.tmx;..\..\art\own\Maps\Mines\18.tmx;..\..\art\own\Maps\Mines\19.tmx;..\..\art\own\Maps\Mines\20.tmx;..\..\art\own\Maps\Mines\21.tmx;..\..\art\own\Maps\Mines\22.tmx;..\..\art\own\Maps\Mines\23.tmx;..\..\art\own\Maps\Mines\24.tmx;..\..\art\own\Maps\Mines\25.tmx;..\..\art\own\Maps\Mines\26.tmx;..\..\art\own\Maps\Mines\27.tmx;..\..\art\own\Maps\Mines\28.tmx;..\..\art\own\Maps\Mines\29.tmx;..\..\art\own\Maps\Mines\41.tmx;..\..\art\own\Maps\Mines\31.tmx;..\..\art\own\Maps\Mines\32.tmx;..\..\art\own\Maps\Mines\33.tmx;..\..\art\own\Maps\Mines\34.tmx;..\..\art\own\Maps\Mines\35.tmx;..\..\art\own\Maps\Mines\36.tmx;..\..\art\own\Maps\Mines\37.tmx;..\..\art\own\Maps\Mines\38.tmx;..\..\art\own\Maps\Mines\39.tmx;..\..\art\own\Maps\Mines\40.tmx" Link="wwwroot\assets\Maps\Mines\%(Filename)%(Extension)" />
    <Content Include="..\..\art\own\Maps\FarmHouse.tmx;..\..\art\own\Maps\BusStop.tmx;..\..\art\own\Maps\Forest.tmx;..\..\art\own\Maps\Town.tmx;..\..\art\own\Maps\Backwoods.tmx;..\..\art\own\Maps\Farm_Foraging.tmx;..\..\art\own\Maps\Coop.tmx;..\..\art\own\Maps\Barn.tmx;..\..\art\own\Maps\Mine.tmx;..\..\art\own\Maps\Mountain.tmx;..\..\art\own\Maps\Beach.tmx;..\..\art\own\Maps\Woods.tmx" Link="wwwroot\assets\Maps\%(Filename)%(Extension)" />
    <!-- The cave sheet of the mine (ADR-042 P3): the entrance cave names it as cave.png, the floors as ../cave.png from Mines/. -->
    <Content Include="..\..\art\own\Maps\cave.png" Link="wwwroot\assets\Maps\%(Filename)%(Extension)" />
    <!-- The own sheets of the maps drawn by Nosum.MapGen (docs/adr/ADR-042 P2): interior and the Paths layer's picture (never drawn, markers.png). -->
    <Content Include="..\..\art\own\Maps\interior.png" Link="wwwroot\assets\Maps\%(Filename)%(Extension)" />
    <Content Include="..\..\assets\farmer\body.png;..\..\assets\farmer\hats.png;..\..\assets\farmer\pants.png;..\..\assets\farmer\shirts.png;..\..\assets\farmer\hair.png" Link="wwwroot\assets\farmer\%(Filename)%(Extension)" />
    <Content Include="..\..\assets\sprites\buildings\farmhouse.png;..\..\assets\sprites\buildings\greenhouse.png;..\..\assets\sprites\buildings\shipping_bin.png;..\..\assets\sprites\buildings\coop.png;..\..\assets\sprites\buildings\barn.png" Link="wwwroot\assets\sprites\buildings\%(Filename)%(Extension)" />
    <Content Include="..\..\assets\sprites\animals\chicken.png;..\..\assets\sprites\animals\cow.png" Link="wwwroot\assets\sprites\animals\%(Filename)%(Extension)" />
    <Content Include="..\..\assets\sprites\crops.png;..\..\assets\sprites\tools.png;..\..\assets\sprites\weapons.png;..\..\assets\sprites\furniture.png;..\..\assets\sprites\craftables.png;..\..\assets\sprites\soil.png" Link="wwwroot\assets\sprites\%(Filename)%(Extension)" />
    <Content Include="..\..\assets\sprites\trees\oak.png;..\..\assets\sprites\trees\maple.png;..\..\assets\sprites\trees\pine.png" Link="wwwroot\assets\sprites\trees\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nosum.Wasm.ViewModels\Nosum.Wasm.ViewModels.csproj" />
    <ProjectReference Include="..\Nosum.Wasm.Controls\Nosum.Wasm.Controls.csproj" />
    <ProjectReference Include="..\Nosum.Wasm.Socket\Nosum.Wasm.Socket.csproj" />
    <ProjectReference Include="..\..\contracts\Nosum.Contracts\Nosum.Contracts.csproj" />
    <ProjectReference Include="..\..\engine\Nosum.Rendering.Web\Nosum.Rendering.Web.csproj" />
    <ProjectReference Include="..\..\engine\Nosum.Core\Nosum.Core.csproj" />
    <ProjectReference Include="..\..\gameplay\Nosum.Gameplay\Nosum.Gameplay.csproj" />
  </ItemGroup>

</Project>
