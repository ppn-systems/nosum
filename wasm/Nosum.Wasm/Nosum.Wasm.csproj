<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <Description>Nosum Blazor WebAssembly host: the game canvas page plus the UI overlay (inventory, shop, chat).</Description>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!-- Required by the [JSExport] source generator (Game/GameLoop.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Tester tools (Game/DevTools.cs, docs/adr/ADR-013 amendments) exist only in a build made with -p:NosumDevTools=true; a normal or Production publish has none. -->
  <PropertyGroup Condition="'$(NosumDevTools)' == 'true'">
    <DefineConstants>$(DefineConstants);NOSUM_DEV_TOOLS</DefineConstants>
  </PropertyGroup>

  <!-- Early content served from the repository's assets/ folder (docs/adr/ADR-007): only the files the client loads, linked
       and never copied. Link is the file name; NosumBase is the URL folder it is served from (NosumLinkedStaticWebAssets
       below). GameMapsTests checks every hosted map is listed. -->
  <ItemGroup>
    <Content Include="..\..\assets\sprites\items.png;..\..\assets\sprites\ambient.png;..\..\assets\sprites\hearts.png;..\..\assets\sprites\crops.png;..\..\assets\sprites\tools.png;..\..\assets\sprites\weapons.png;..\..\assets\sprites\monsters.png;..\..\assets\sprites\furniture.png;..\..\assets\sprites\craftables.png;..\..\assets\sprites\soil.png" Link="%(Filename)%(Extension)" NosumBase="assets/sprites" />
    <Content Include="..\..\assets\sprites\buildings\farmhouse.png;..\..\assets\sprites\buildings\greenhouse.png;..\..\assets\sprites\buildings\shipping_bin.png;..\..\assets\sprites\buildings\coop.png;..\..\assets\sprites\buildings\barn.png" Link="%(Filename)%(Extension)" NosumBase="assets/sprites/buildings" />
    <Content Include="..\..\assets\sprites\animals\chicken.png;..\..\assets\sprites\animals\cow.png" Link="%(Filename)%(Extension)" NosumBase="assets/sprites/animals" />
    <Content Include="..\..\assets\sprites\trees\oak.png;..\..\assets\sprites\trees\maple.png;..\..\assets\sprites\trees\pine.png" Link="%(Filename)%(Extension)" NosumBase="assets/sprites/trees" />
    <Content Include="..\..\assets\farmer\body.png;..\..\assets\farmer\hats.png;..\..\assets\farmer\pants.png;..\..\assets\farmer\shirts.png;..\..\assets\farmer\hair.png" Link="%(Filename)%(Extension)" NosumBase="assets/farmer" />
    <Content Include="..\..\art\own\Maps\Farm.tmx;..\..\art\own\Maps\terrain.png;..\..\art\own\Maps\town.png;..\..\art\own\Maps\nature.png;..\..\art\own\Maps\markers.png;..\..\art\own\Maps\Farmhouse.tmx;..\..\art\own\Maps\Crossroads.tmx;..\..\art\own\Maps\Forest.tmx;..\..\art\own\Maps\Town.tmx;..\..\art\own\Maps\Hillside.tmx;..\..\art\own\Maps\CoopFarm.tmx;..\..\art\own\Maps\Coop.tmx;..\..\art\own\Maps\Barn.tmx;..\..\art\own\Maps\Mine.tmx;..\..\art\own\Maps\Mountain.tmx;..\..\art\own\Maps\Beach.tmx;..\..\art\own\Maps\Woods.tmx;..\..\art\own\Maps\cave.png;..\..\art\own\Maps\interior.png" Link="%(Filename)%(Extension)" NosumBase="assets/Maps" />
    <Content Include="..\..\art\own\Maps\Mines\1.tmx;..\..\art\own\Maps\Mines\2.tmx;..\..\art\own\Maps\Mines\3.tmx;..\..\art\own\Maps\Mines\4.tmx;..\..\art\own\Maps\Mines\5.tmx;..\..\art\own\Maps\Mines\6.tmx;..\..\art\own\Maps\Mines\7.tmx;..\..\art\own\Maps\Mines\8.tmx;..\..\art\own\Maps\Mines\9.tmx;..\..\art\own\Maps\Mines\10.tmx;..\..\art\own\Maps\Mines\11.tmx;..\..\art\own\Maps\Mines\12.tmx;..\..\art\own\Maps\Mines\13.tmx;..\..\art\own\Maps\Mines\14.tmx;..\..\art\own\Maps\Mines\15.tmx;..\..\art\own\Maps\Mines\16.tmx;..\..\art\own\Maps\Mines\17.tmx;..\..\art\own\Maps\Mines\18.tmx;..\..\art\own\Maps\Mines\19.tmx;..\..\art\own\Maps\Mines\20.tmx;..\..\art\own\Maps\Mines\21.tmx;..\..\art\own\Maps\Mines\22.tmx;..\..\art\own\Maps\Mines\23.tmx;..\..\art\own\Maps\Mines\24.tmx;..\..\art\own\Maps\Mines\25.tmx;..\..\art\own\Maps\Mines\26.tmx;..\..\art\own\Maps\Mines\27.tmx;..\..\art\own\Maps\Mines\28.tmx;..\..\art\own\Maps\Mines\29.tmx;..\..\art\own\Maps\Mines\41.tmx;..\..\art\own\Maps\Mines\31.tmx;..\..\art\own\Maps\Mines\32.tmx;..\..\art\own\Maps\Mines\33.tmx;..\..\art\own\Maps\Mines\34.tmx;..\..\art\own\Maps\Mines\35.tmx;..\..\art\own\Maps\Mines\36.tmx;..\..\art\own\Maps\Mines\37.tmx;..\..\art\own\Maps\Mines\38.tmx;..\..\art\own\Maps\Mines\39.tmx;..\..\art\own\Maps\Mines\40.tmx" Link="%(Filename)%(Extension)" NosumBase="assets/Maps/Mines" />
    <Content Include="..\..\assets\sprites\npcs\*.png" Link="%(Filename)%(Extension)" NosumBase="assets/sprites/npcs" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nosum.Wasm.ViewModels\Nosum.Wasm.ViewModels.csproj" />
    <ProjectReference Include="..\Nosum.Wasm.Controls\Nosum.Wasm.Controls.csproj" />
    <ProjectReference Include="..\Nosum.Wasm.Socket\Nosum.Wasm.Socket.csproj" />
    <ProjectReference Include="..\..\contracts\Nosum.Contracts\Nosum.Contracts.csproj" />
    <ProjectReference Include="..\..\engine\Nosum.Rendering.Web\Nosum.Rendering.Web.csproj" />
    <ProjectReference Include="..\..\engine\Nosum.Core\Nosum.Core.csproj" />
    <ProjectReference Include="..\..\gameplay\Nosum.Gameplay\Nosum.Gameplay.csproj" />
  </ItemGroup>

  <!-- Serves the linked Content above from their own folders, not from wwwroot/ (see the Controls project for why a Development
       build served them as empty files). The URLs are the same as before. -->
  <Target Name="NosumLinkedStaticWebAssets" AfterTargets="ResolveProjectStaticWebAssets">
    <ItemGroup>
      <_WasmSprites Include="@(Content)" Condition="'%(Content.NosumBase)' == 'assets/sprites'" />
    </ItemGroup>
    <DefineStaticWebAssets
      CandidateAssets="@(_WasmSprites)"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
      FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
      RelativePathPattern="**"
      SourceType="Project"
      SourceId="$(PackageId)"
      ContentRoot="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', 'assets', 'sprites'))"
      BasePath="assets/sprites"
      AssetMergeSource="$(StaticWebAssetMergeTarget)">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_NosumLinkedAsset" />
    </DefineStaticWebAssets>
    <ItemGroup>
      <_WasmBuildings Include="@(Content)" Condition="'%(Content.NosumBase)' == 'assets/sprites/buildings'" />
    </ItemGroup>
    <DefineStaticWebAssets
      CandidateAssets="@(_WasmBuildings)"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
      FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
      RelativePathPattern="**"
      SourceType="Project"
      SourceId="$(PackageId)"
      ContentRoot="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', 'assets', 'sprites', 'buildings'))"
      BasePath="assets/sprites/buildings"
      AssetMergeSource="$(StaticWebAssetMergeTarget)">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_NosumLinkedAsset" />
    </DefineStaticWebAssets>
    <ItemGroup>
      <_WasmAnimals Include="@(Content)" Condition="'%(Content.NosumBase)' == 'assets/sprites/animals'" />
    </ItemGroup>
    <DefineStaticWebAssets
      CandidateAssets="@(_WasmAnimals)"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
      FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
      RelativePathPattern="**"
      SourceType="Project"
      SourceId="$(PackageId)"
      ContentRoot="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', 'assets', 'sprites', 'animals'))"
      BasePath="assets/sprites/animals"
      AssetMergeSource="$(StaticWebAssetMergeTarget)">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_NosumLinkedAsset" />
    </DefineStaticWebAssets>
    <ItemGroup>
      <_WasmTrees Include="@(Content)" Condition="'%(Content.NosumBase)' == 'assets/sprites/trees'" />
    </ItemGroup>
    <DefineStaticWebAssets
      CandidateAssets="@(_WasmTrees)"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
      FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
      RelativePathPattern="**"
      SourceType="Project"
      SourceId="$(PackageId)"
      ContentRoot="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', 'assets', 'sprites', 'trees'))"
      BasePath="assets/sprites/trees"
      AssetMergeSource="$(StaticWebAssetMergeTarget)">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_NosumLinkedAsset" />
    </DefineStaticWebAssets>
    <ItemGroup>
      <_WasmFarmer Include="@(Content)" Condition="'%(Content.NosumBase)' == 'assets/farmer'" />
    </ItemGroup>
    <DefineStaticWebAssets
      CandidateAssets="@(_WasmFarmer)"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
      FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
      RelativePathPattern="**"
      SourceType="Project"
      SourceId="$(PackageId)"
      ContentRoot="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', 'assets', 'farmer'))"
      BasePath="assets/farmer"
      AssetMergeSource="$(StaticWebAssetMergeTarget)">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_NosumLinkedAsset" />
    </DefineStaticWebAssets>
    <ItemGroup>
      <_WasmMaps Include="@(Content)" Condition="'%(Content.NosumBase)' == 'assets/Maps'" />
    </ItemGroup>
    <DefineStaticWebAssets
      CandidateAssets="@(_WasmMaps)"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
      FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
      RelativePathPattern="**"
      SourceType="Project"
      SourceId="$(PackageId)"
      ContentRoot="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', 'art', 'own', 'Maps'))"
      BasePath="assets/Maps"
      AssetMergeSource="$(StaticWebAssetMergeTarget)">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_NosumLinkedAsset" />
    </DefineStaticWebAssets>
    <ItemGroup>
      <_WasmMines Include="@(Content)" Condition="'%(Content.NosumBase)' == 'assets/Maps/Mines'" />
    </ItemGroup>
    <DefineStaticWebAssets
      CandidateAssets="@(_WasmMines)"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
      FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
      RelativePathPattern="**"
      SourceType="Project"
      SourceId="$(PackageId)"
      ContentRoot="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', 'art', 'own', 'Maps', 'Mines'))"
      BasePath="assets/Maps/Mines"
      AssetMergeSource="$(StaticWebAssetMergeTarget)">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_NosumLinkedAsset" />
    </DefineStaticWebAssets>
    <ItemGroup>
      <_WasmNpcs Include="@(Content)" Condition="'%(Content.NosumBase)' == 'assets/sprites/npcs'" />
    </ItemGroup>
    <DefineStaticWebAssets
      CandidateAssets="@(_WasmNpcs)"
      FingerprintCandidates="$(StaticWebAssetsFingerprintContent)"
      FingerprintPatterns="@(StaticWebAssetFingerprintPattern)"
      RelativePathPattern="**"
      SourceType="Project"
      SourceId="$(PackageId)"
      ContentRoot="$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '..', '..', 'assets', 'sprites', 'npcs'))"
      BasePath="assets/sprites/npcs"
      AssetMergeSource="$(StaticWebAssetMergeTarget)">
      <Output TaskParameter="Assets" ItemName="StaticWebAsset" />
      <Output TaskParameter="Assets" ItemName="_NosumLinkedAsset" />
    </DefineStaticWebAssets>
    <DefineStaticWebAssetEndpoints
      CandidateAssets="@(_NosumLinkedAsset)"
      ExistingEndpoints="@(StaticWebAssetEndpoint)"
      ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
      <Output TaskParameter="Endpoints" ItemName="StaticWebAssetEndpoint" />
    </DefineStaticWebAssetEndpoints>
  </Target>

</Project>
