<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <Description>Nosum Blazor WebAssembly host: the game canvas page plus the UI overlay (inventory, shop, chat).</Description>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Required by the [JSExport] source generator (Game/GameLoop.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Placeholder content served from the repository's assets/ folder (docs/adr/ADR-007):
       only the files the client loads, linked so assets/ stays the single copy. -->
  <ItemGroup>
    <Content Include="..\..\assets\Maps\springobjects.png" Link="wwwroot\assets\Maps\%(Filename)%(Extension)" />
    <!-- Maps of Nosum.Gameplay.Maps.GameMaps and the tilesheets they name; GameMapsTests checks that every one is listed. -->
    <Content Include="..\..\assets\Maps\Farm.tmx;..\..\assets\Maps\FarmHouse.tmx;..\..\assets\Maps\BusStop.tmx;..\..\assets\Maps\Forest.tmx;..\..\assets\Maps\Town.tmx;..\..\assets\Maps\Backwoods.tmx" Link="wwwroot\assets\Maps\%(Filename)%(Extension)" />
    <Content Include="..\..\assets\Maps\paths.png;..\..\assets\Maps\spring_outdoorsTileSheet.png;..\..\assets\Maps\spring_outdoorsTileSheet2.png;..\..\assets\Maps\spring_outdoorTileSheet_extra.png;..\..\assets\Maps\spring_town.png;..\..\assets\Maps\spring_monsterGraveTiles.png;..\..\assets\Maps\spring_Shadows.png;..\..\assets\Maps\spring_Waterfalls.png;..\..\assets\Maps\townInterior.png;..\..\assets\Maps\farmhouse_tiles.png;..\..\assets\Maps\walls_and_floors.png" Link="wwwroot\assets\Maps\%(Filename)%(Extension)" />
    <Content Include="..\..\assets\Characters\Farmer\farmer_base.png;..\..\assets\Characters\Farmer\hats.png;..\..\assets\Characters\Farmer\pants.png;..\..\assets\Characters\Farmer\shirts.png;..\..\assets\Characters\Farmer\hairstyles.png" Link="wwwroot\assets\Characters\Farmer\%(Filename)%(Extension)" />
    <Content Include="..\..\assets\Buildings\houses.png;..\..\assets\Buildings\Greenhouse.png;..\..\assets\Buildings\Shipping Bin.png" Link="wwwroot\assets\Buildings\%(Filename)%(Extension)" />
    <Content Include="..\..\assets\TileSheets\crops.png;..\..\assets\TileSheets\tools.png;..\..\assets\TileSheets\furniture.png" Link="wwwroot\assets\TileSheets\%(Filename)%(Extension)" />
    <Content Include="..\..\assets\TerrainFeatures\hoeDirt.png" Link="wwwroot\assets\TerrainFeatures\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <TrimmerRootDescriptor Include="TrimmerRoots.xml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nosum.Wasm.ViewModels\Nosum.Wasm.ViewModels.csproj" />
    <ProjectReference Include="..\Nosum.Wasm.Controls\Nosum.Wasm.Controls.csproj" />
    <ProjectReference Include="..\Nosum.Wasm.Socket\Nosum.Wasm.Socket.csproj" />
    <ProjectReference Include="..\..\contracts\Nosum.Contracts\Nosum.Contracts.csproj" />
    <ProjectReference Include="..\..\engine\Nosum.Rendering.Web\Nosum.Rendering.Web.csproj" />
    <ProjectReference Include="..\..\engine\Nosum.Core\Nosum.Core.csproj" />
    <ProjectReference Include="..\..\gameplay\Nosum.Gameplay\Nosum.Gameplay.csproj" />
  </ItemGroup>

</Project>
