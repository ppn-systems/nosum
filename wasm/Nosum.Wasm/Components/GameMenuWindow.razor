@* Standalone window hosting the currently active game panel (docs/adr/ADR-044). *@
<TradeDialog Title="@DialogTitle()" CloseText="@Toolbar.Text("Panel_Close")" Size="@SizeOf(Panel)" OnClose="OnDialogClose">
    @switch (Panel)
    {
        case PanelKind.Market:
            <MarketPanel Vm="Market" />
            break;
        case PanelKind.Shop:
            <ShopPanel Vm="Shop" ShopId="ShopId" Smith="Blacksmith" Carpenter="Carpenter" ShowAnimals="@(Npc.Page == NpcPage.Build)"
                       ShowOffers="@(Npc.Page != NpcPage.Build && Npc.Page != NpcPage.Upgrade)" ShowExtras="@(Npc.Page != NpcPage.Shop || Npc.Npc?.CounterId == Nosum.Gameplay.Shops.ShopCatalog.CarpenterShop)" />
            break;
        case PanelKind.Goals:
            <GoalsPanel Vm="Goals" />
            break;
        case PanelKind.Chest:
            <ChestPanel Vm="Chest" />
            break;
        case PanelKind.Furnace:
            <FurnacePanel Vm="Furnace" />
            break;
        case PanelKind.Inventory:
            <InventoryPanel Vm="Inventory" Wardrobe="Wardrobe" />
            break;
        case PanelKind.Wardrobe:
            <WardrobePanel Vm="Wardrobe" />
            break;
        case PanelKind.Backpack:
            <BackpackPanel Vm="Backpack" />
            break;
        case PanelKind.Trade:
            <TradePanel Vm="Trade" />
            break;
        case PanelKind.Coop:
            <CoopPanel Vm="Coop" />
            break;
        case PanelKind.Profile:
            <ProfilePanel Vm="Profile" Account="Form" />
            break;
        case PanelKind.Visitors:
            <VisitorsPanel Vm="Visitors" OnClose="OnClosePanel" />
            break;
        case PanelKind.Friends:
            <FriendsPanel Vm="Friends" OnClose="OnClosePanel" />
            break;
        case PanelKind.Mail:
            <MailPanel Vm="Mail" />
            break;
        case PanelKind.Skills:
            <SkillsPanel Vm="Progress" />
            break;
        case PanelKind.Settings:
            <SettingsPanel Vm="Form" Settings="Settings" />
            break;
        case PanelKind.Pet:
            <PetPanel Vm="Pet" />
            break;
        case PanelKind.Crafting:
            <CraftingPanel Vm="Crafting" />
            break;
        case PanelKind.WorldMap:
            <WorldMapPanel Vm="WorldMap" />
            break;
        case PanelKind.Journal:
            <JournalPanel Vm="Journal" />
            break;
        case PanelKind.Today:
            <TodayPanel Vm="Calendar" />
            break;
        case PanelKind.Menu:
            <GameMenuTiles Items="Toolbar.MenuItems" Label="@Toolbar.MenuLabel" OnOpen="OnOpenPanel" />
            break;
    }
</TradeDialog>

@code {
    /// <summary>The active panel kind.</summary>
    [Parameter, EditorRequired] public PanelKind Panel { get; set; }

    /// <summary>The active shop id when <see cref="Panel"/> is <see cref="PanelKind.Shop"/>.</summary>
    [Parameter] public int ShopId { get; set; }

    /// <summary>Raised when the dialog close button is clicked.</summary>
    [Parameter] public EventCallback OnDialogClose { get; set; }

    /// <summary>Raised when a child panel requests closing the panel directly.</summary>
    [Parameter] public EventCallback OnClosePanel { get; set; }

    /// <summary>Raised when a tile of the game menu opens a panel.</summary>
    [Parameter] public EventCallback<PanelKind> OnOpenPanel { get; set; }

    /// <summary>The width of a panel: L for the wide pages (the inventory with its side column, the shops, the market, the wardrobe and the
    /// world map, the settings with its key list), S for the small ones (a chest, a furnace, the pet, the visitors, the game menu), M for the rest
    /// (docs/design/ui-standard.md section 3).</summary>
    private static PanelSize SizeOf(PanelKind panel) => panel switch
    {
        PanelKind.Inventory or PanelKind.Shop or PanelKind.Market or PanelKind.Wardrobe or PanelKind.WorldMap or PanelKind.Journal
            or PanelKind.Crafting or PanelKind.Skills or PanelKind.Settings or PanelKind.Trade or PanelKind.Coop => PanelSize.L,
        PanelKind.Chest => PanelSize.XL,
        PanelKind.Furnace or PanelKind.Pet or PanelKind.Visitors or PanelKind.Menu => PanelSize.S,
        _ => PanelSize.M,
    };

    private string DialogTitle() => Panel switch
    {
        PanelKind.Shop or PanelKind.Market or PanelKind.Goals => Npc.PageTitle.Length > 0 ? Npc.PageTitle : Toolbar.Text("Toolbar_Shop"),
        PanelKind.Chest => Toolbar.Text("Chest_Title"),
        PanelKind.Furnace => Toolbar.Text("Furnace_Title"),
        PanelKind.Menu => Toolbar.MenuLabel,
        PanelKind.Backpack => Toolbar.Text("Toolbar_Backpack"),
        PanelKind.Today => Toolbar.Text("Today_Title"),
        _ => Toolbar.TitleOf(Panel),
    };
}
