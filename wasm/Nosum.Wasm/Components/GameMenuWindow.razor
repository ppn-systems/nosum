@using Nosum.Wasm.Controls.Progress
@using Nosum.Wasm.Controls.Settings
@using Nosum.Wasm.Controls.Shop
@using Nosum.Wasm.Controls.Trade
@using Nosum.Wasm.Controls.Visit
@using Nosum.Wasm.ViewModels
@using Nosum.Wasm.ViewModels.Account
@using Nosum.Wasm.ViewModels.Blacksmith
@using Nosum.Wasm.ViewModels.Building
@using Nosum.Wasm.ViewModels.Chest
@using Nosum.Wasm.ViewModels.Coop
@using Nosum.Wasm.ViewModels.Crafting
@using Nosum.Wasm.ViewModels.Friends
@using Nosum.Wasm.ViewModels.Furnace
@using Nosum.Wasm.ViewModels.Goals
@using Nosum.Wasm.ViewModels.Inventory
@using Nosum.Wasm.ViewModels.Looks
@using Nosum.Wasm.ViewModels.Mail
@using Nosum.Wasm.ViewModels.Market
@using Nosum.Wasm.ViewModels.Npc
@using Nosum.Wasm.ViewModels.Profile
@using Nosum.Wasm.ViewModels.Progress
@using Nosum.Wasm.ViewModels.Settings
@using Nosum.Wasm.ViewModels.Shop
@using Nosum.Wasm.ViewModels.Trade
@using Nosum.Wasm.ViewModels.Visit
@inject ToolbarViewModel Toolbar
@inject MarketViewModel Market
@inject ShopViewModel Shop
@inject BlacksmithViewModel Blacksmith
@inject CarpenterViewModel Carpenter
@inject GoalsViewModel Goals
@inject ChestViewModel Chest
@inject FurnaceViewModel Furnace
@inject InventoryViewModel Inventory
@inject WardrobeViewModel Wardrobe
@inject TradeViewModel Trade
@inject CoopViewModel Coop
@inject ProfileViewModel Profile
@inject AccountFormViewModel Form
@inject VisitorsViewModel Visitors
@inject FriendsViewModel Friends
@inject MailViewModel Mail
@inject ProgressViewModel Progress
@inject SettingsViewModel Settings
@inject CraftingViewModel Crafting
@inject NpcDialogViewModel Npc

@* Standalone window hosting the currently active game panel (docs/adr/ADR-044). *@
<TradeDialog Title="@DialogTitle()" CloseText="@Toolbar.Text("Panel_Close")" OnClose="OnDialogClose">
    @switch (Panel)
    {
        case PanelKind.Market:
            <MarketPanel Vm="Market" />
            break;
        case PanelKind.Shop:
            <ShopPanel Vm="Shop" ShopId="ShopId" Smith="Blacksmith" ShowOffers="@(Npc.Page != NpcPage.Build && Npc.Page != NpcPage.Upgrade)" ShowExtras="@(Npc.Page != NpcPage.Shop)">
                <Extra>
                    @if (Shop.IsCarpenterShop)
                    {
                        <CarpenterSections Vm="Carpenter" />
                    }
                </Extra>
            </ShopPanel>
            break;
        case PanelKind.Goals:
            <GoalsPanel Vm="Goals" />
            break;
        case PanelKind.Chest:
            <ChestPanel Vm="Chest" />
            break;
        case PanelKind.Furnace:
            <FurnacePanel Vm="Furnace" />
            break;
        case PanelKind.Inventory:
            <InventoryPanel Vm="Inventory" Wardrobe="Wardrobe" />
            break;
        case PanelKind.Wardrobe:
            <WardrobePanel Vm="Wardrobe" />
            break;
        case PanelKind.Trade:
            <TradePanel Vm="Trade" />
            break;
        case PanelKind.Coop:
            <CoopPanel Vm="Coop" />
            break;
        case PanelKind.Profile:
            <ProfilePanel Vm="Profile" Account="Form" />
            break;
        case PanelKind.Visitors:
            <VisitorsPanel Vm="Visitors" OnClose="OnClosePanel" />
            break;
        case PanelKind.Friends:
            <FriendsPanel Vm="Friends" />
            break;
        case PanelKind.Mail:
            <MailPanel Vm="Mail" />
            break;
        case PanelKind.Skills:
            <SkillsPanel Vm="Progress" />
            break;
        case PanelKind.Settings:
            <SettingsPanel Vm="Form" Settings="Settings" />
            break;
        case PanelKind.Crafting:
            <CraftingPanel Vm="Crafting" />
            break;
    }
</TradeDialog>

@code {
    /// <summary>The active panel kind.</summary>
    [Parameter, EditorRequired] public PanelKind Panel { get; set; }

    /// <summary>The active shop id when <see cref="Panel"/> is <see cref="PanelKind.Shop"/>.</summary>
    [Parameter] public int ShopId { get; set; }

    /// <summary>Raised when the dialog close button is clicked.</summary>
    [Parameter] public EventCallback OnDialogClose { get; set; }

    /// <summary>Raised when a child panel requests closing the panel directly.</summary>
    [Parameter] public EventCallback OnClosePanel { get; set; }

    private string DialogTitle() => Panel switch
    {
        PanelKind.Shop or PanelKind.Market or PanelKind.Goals => Npc.PageTitle.Length > 0 ? Npc.PageTitle : Toolbar.Text("Toolbar_Shop"),
        PanelKind.Chest => Toolbar.Text("Chest_Title"),
        PanelKind.Furnace => Toolbar.Text("Furnace_Title"),
        _ => Toolbar.TitleOf(Panel),
    };
}
