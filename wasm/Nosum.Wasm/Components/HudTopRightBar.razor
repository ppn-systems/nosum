@using Nosum.Wasm.Controls.Calendar
@using Nosum.Wasm.Controls.Common
@using Nosum.Wasm.Controls.Layout
@using Nosum.Wasm.Controls.Wallet
@using Nosum.Wasm.ViewModels
@using Nosum.Wasm.ViewModels.Calendar
@using Nosum.Wasm.ViewModels.Mail
@using Nosum.Wasm.ViewModels.Minimap
@using Nosum.Wasm.ViewModels.Wallet

@* Top-right HUD: row one (the calendar clock, the coin balance, Mail and Settings), then the minimap card and the menu column under it, sharing the right edge. *@
<div class="hud-bar">
    <CalendarClock Vm="Calendar" OnOpen="@(() => OnTogglePanel.InvokeAsync(PanelKind.Today))" />
    <CoinBadge Vm="Wallet" />
    @* Mail and Settings are standalone windows of their own (docs/adr/ADR-043 D4, ADR-044). *@
    <GameIconButton Icon="tab-mail" Active="@(ActivePanel == PanelKind.Mail)" Tip="@Toolbar.MailTip(Mail.Unread)" Badge="Mail.Unread" OnClick="@(() => OnTogglePanel.InvokeAsync(PanelKind.Mail))" />
    <GameIconButton Icon="tab-settings" Active="@(ActivePanel == PanelKind.Settings)" Tip="@Toolbar.SettingsTip" OnClick="@(() => OnTogglePanel.InvokeAsync(PanelKind.Settings))" />
</div>
<HudMinimap Vm="Minimap" OnOpen="@(() => OnTogglePanel.InvokeAsync(PanelKind.WorldMap))" />
@* The menu column: one column of square buttons under the minimap, at most 8 with the Menu button last (docs/design/ui-standard.md section 2). A narrow
   or touch screen keeps only the Menu button; the rest of the column is in the game menu. *@
<div class="hud-menu-column" role="toolbar" aria-label="@Toolbar.Label">
    @foreach (ToolbarItem item in Toolbar.ColumnItems)
    {
        PanelKind kind = item.Kind;
        <div class="hud-menu-item">
            <GameIconButton Icon="@item.Icon" Active="@(ActivePanel == kind)" Tip="@(item.Hotkey.Length > 0 ? item.Label + " [" + item.Hotkey + "]" : item.Label)" OnClick="@(() => OnTogglePanel.InvokeAsync(kind))" />
        </div>
    }
    <div class="hud-menu-item hud-menu-button">
        @* The Menu button is icon-only: its name shows beside it on a phone, where the column is this one button (docs/design/ui-standard.md section 6). *@
        <span class="hud-menu-label" aria-hidden="true">@Toolbar.MenuLabel</span>
        <GameIconButton Icon="tab-menu" Active="@(ActivePanel == PanelKind.Menu)" Tip="@Toolbar.MenuLabel" OnClick="@(() => OnTogglePanel.InvokeAsync(PanelKind.Menu))" />
    </div>
</div>

@code {
    /// <summary>The calendar view model.</summary>
    [Parameter, EditorRequired] public CalendarViewModel Calendar { get; set; } = default!;

    /// <summary>The wallet view model.</summary>
    [Parameter, EditorRequired] public WalletViewModel Wallet { get; set; } = default!;

    /// <summary>The mail view model.</summary>
    [Parameter, EditorRequired] public MailViewModel Mail { get; set; } = default!;

    /// <summary>The minimap frame view model.</summary>
    [Parameter, EditorRequired] public MinimapViewModel Minimap { get; set; } = default!;

    /// <summary>The toolbar view model.</summary>
    [Parameter, EditorRequired] public ToolbarViewModel Toolbar { get; set; } = default!;

    /// <summary>The currently open panel, or <see cref="PanelKind.None"/>.</summary>
    [Parameter] public PanelKind ActivePanel { get; set; }

    /// <summary>Raised when a toolbar or top-right button is clicked to toggle a panel.</summary>
    [Parameter] public EventCallback<PanelKind> OnTogglePanel { get; set; }

    protected override void OnParametersSet() => Minimap.Covered = ActivePanel != PanelKind.None;
}
