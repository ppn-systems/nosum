@using Nosum.Wasm.Controls.Common
@using Nosum.Wasm.ViewModels.Account
@implements IDisposable

@* The returning player's card (docs/adr/ADR-082): who this browser remembers, one button that resumes that session without another sign-in, and one
   that signs out or uses another account. A refused resume brings back the sign-in buttons with the reason; nothing here touches the socket. *@
<GamePanel Title="@Vm.Remembered.Title" Class="account account-continue" Role="form">
    <div class="account-form">
        <GameStack>
            <div class="account-continue-who">
                @if (Vm.Remembered.Remembered is { Kind: RememberedAccountKind.Google })
                {
                    <svg class="account-continue-mark" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
                        <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z" />
                        <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z" />
                        <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z" />
                        <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z" />
                    </svg>
                }
                else if (Vm.Remembered.Remembered is { Kind: RememberedAccountKind.Microsoft })
                {
                    <svg class="account-continue-mark" viewBox="0 0 21 21" aria-hidden="true" focusable="false">
                        <rect x="0" y="0" width="10" height="10" fill="#F25022" />
                        <rect x="11" y="0" width="10" height="10" fill="#7FBA00" />
                        <rect x="0" y="11" width="10" height="10" fill="#00A4EF" />
                        <rect x="11" y="11" width="10" height="10" fill="#FFB900" />
                    </svg>
                }
                <span class="account-continue-name">@Vm.Remembered.DisplayName</span>
            </div>
            <GameButton Focusable="true" Disabled="@Vm.IsBusy" Text="@Vm.Remembered.ContinueText" OnClick="@(() => Vm.ContinueAsync())" />
            <GameButton Variant="secondary" Focusable="true" Disabled="@Vm.IsBusy" Text="@Vm.Remembered.ForgetText" OnClick="@(() => Vm.ForgetRememberedAsync())" />
            @if (Vm.ErrorText is not null)
            {
                <GameNotice Kind="error" Text="@Vm.ErrorText" />
            }
        </GameStack>
    </div>
</GamePanel>

@code {
    /// <summary>The account view model; the card reads the remembered session and the busy state from it.</summary>
    [Parameter, EditorRequired] public AccountFormViewModel Vm { get; set; } = default!;

    /// <inheritdoc/>
    protected override void OnInitialized()
    {
        Vm.Changed += OnChanged;
        Vm.Remembered.Changed += OnChanged;
    }

    // The view model can raise Changed from a socket callback; marshal back to the render context.
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    /// <inheritdoc/>
    public void Dispose()
    {
        Vm.Changed -= OnChanged;
        Vm.Remembered.Changed -= OnChanged;
    }
}
