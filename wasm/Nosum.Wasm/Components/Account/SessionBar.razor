@using System.Threading
@using Nosum.Wasm.ViewModels.Account
@implements IDisposable

@* Reusable in-game bar: who is signed in, the invitation to register (guests), and sign out. Text and behaviour come from the view model. *@
@if (Vm.CurrentSession is not null)
{
    <div class="session-bar">
        <span class="session-who">@Vm.SignedInText</span>
        @if (Vm.CanUpgrade)
        {
            <span class="session-prompt">@Vm.UpgradePromptText</span>
            <button type="button" @onclick="Vm.BeginUpgrade" disabled="@Vm.IsBusy">@Vm.UpgradeText</button>
        }
        <button type="button" @onclick="LogoutAsync" disabled="@Vm.IsBusy">@Vm.SignOutText</button>
    </div>
}

@code {
    /// <summary>The account view model; the same instance the page gives to the form.</summary>
    [Parameter, EditorRequired] public AccountFormViewModel Vm { get; set; } = default!;

    private AccountFormViewModel? _subscribed;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, Vm))
        {
            return;
        }

        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnChanged;
        }

        _subscribed = Vm;
        Vm.Changed += OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private Task LogoutAsync() => Vm.LogoutAsync(CancellationToken.None);

    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnChanged;
        }
    }
}
