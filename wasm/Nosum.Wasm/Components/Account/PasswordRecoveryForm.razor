@using Nosum.Wasm.Controls.Common
@using Nosum.Wasm.ViewModels.Account
@using System.Threading
@implements IDisposable

@* The "forgot password" form: the e-mail, then the e-mailed code with a new password. Built only from the shared controls; text and behaviour come from the view model. *@
<GamePanel Title="@Vm.Title" Class="account" Role="form">
    <form class="account-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
        <GameStack>
            <div class="account-fields recovery-fields">
                @if (Vm.Step != RecoveryStep.Done)
                {
                    <GameField Label="@Vm.EmailLabel" Hint="@(Vm.Step == RecoveryStep.Request ? Vm.RequestHint : null)">
                        <GameInput Type="email" Value="@Vm.Email" ValueChanged="@(v => Vm.Email = v)" Label="@Vm.EmailLabel" AutoComplete="email"
                                   MaxLength="@Nosum.Contracts.Account.AccountLimits.EmailMaxLength" Disabled="@(Vm.IsBusy || Vm.Step == RecoveryStep.Confirm)" />
                    </GameField>
                }

                @if (Vm.Step == RecoveryStep.Confirm)
                {
                    <GameField Label="@Vm.CodeLabel" Hint="@Vm.CodeHint">
                        <GameInput Value="@Vm.Code" ValueChanged="@(v => Vm.Code = v)" Label="@Vm.CodeLabel" AutoComplete="one-time-code" MaxLength="8" Disabled="@Vm.IsBusy" />
                    </GameField>

                    <GameField Label="@Vm.NewPasswordLabel">
                        <GameInput Type="password" Value="@Vm.NewPassword" ValueChanged="@(v => Vm.NewPassword = v)" Label="@Vm.NewPasswordLabel" AutoComplete="new-password"
                                   MaxLength="@Nosum.Contracts.Account.AccountLimits.PasswordMaxLength" Disabled="@Vm.IsBusy" />
                    </GameField>

                    <GameField Label="@Vm.ConfirmPasswordLabel">
                        <GameInput Type="password" Value="@Vm.ConfirmPassword" ValueChanged="@(v => Vm.ConfirmPassword = v)" Label="@Vm.ConfirmPasswordLabel" AutoComplete="new-password"
                                   MaxLength="@Nosum.Contracts.Account.AccountLimits.PasswordMaxLength" Disabled="@Vm.IsBusy" />
                    </GameField>
                }
            </div>

            @if (Vm.InfoText is not null)
            {
                <GameNotice Kind="info" Text="@Vm.InfoText" />
            }

            @if (Vm.ErrorText is not null)
            {
                <GameNotice Kind="error" Text="@Vm.ErrorText" />
            }

            <GameButton Submit="true" Focusable="true" Disabled="@Vm.IsBusy">@Vm.SubmitText@if (Vm.IsBusy)
                {
                    <GameSpinner />
                }</GameButton>

            @if (Vm.Step != RecoveryStep.Done)
            {
                <GameButton Variant="plain" Focusable="true" OnClick="Vm.Cancel" Disabled="@Vm.IsBusy" Text="@Vm.CancelText" />
            }
        </GameStack>
    </form>
</GamePanel>

@code {
    /// <summary>The form's view model; the start screen creates it and closes the form on Closed.</summary>
    [Parameter, EditorRequired] public PasswordRecoveryViewModel Vm { get; set; } = default!;

    private PasswordRecoveryViewModel? _subscribed;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, Vm))
        {
            return;
        }

        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnChanged;
        }

        _subscribed = Vm;
        Vm.Changed += OnChanged;
    }

    // The view model can raise Changed from a socket callback; marshal back to the render context.
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private Task SubmitAsync() => Vm.SubmitAsync(CancellationToken.None);

    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnChanged;
        }
    }
}
