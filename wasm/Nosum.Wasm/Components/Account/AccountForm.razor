@using Nosum.Wasm.ViewModels.Account
@using System.Threading
@implements IDisposable

@* Reusable login / register form. All text and behaviour come from the view model; no network code here. *@
<form class="account-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
    <h2 class="account-title">@Vm.Title</h2>

    <label class="account-field">
        <span>@Vm.UsernameLabel</span>
        <input type="text" @bind="Vm.Username" @bind:event="oninput" autocomplete="username" maxlength="@Nosum.Contracts.Account.AccountLimits.UsernameMaxLength" disabled="@Vm.IsBusy" />
        @if (Vm.IsRegister)
        {
            <small>@Vm.UsernameHint</small>
        }
    </label>

    <label class="account-field">
        <span>@Vm.PasswordLabel</span>
        <input type="password" @bind="Vm.Password" @bind:event="oninput" autocomplete="@(Vm.IsRegister ? "new-password" : "current-password")" maxlength="@Nosum.Contracts.Account.AccountLimits.PasswordMaxLength" disabled="@Vm.IsBusy" />
        @if (Vm.IsRegister)
        {
            <small>@Vm.PasswordHint</small>
        }
    </label>

    @if (Vm.IsRegister)
    {
        <label class="account-field">
            <span>@Vm.ConfirmPasswordLabel</span>
            <input type="password" @bind="Vm.ConfirmPassword" @bind:event="oninput" autocomplete="new-password" maxlength="@Nosum.Contracts.Account.AccountLimits.PasswordMaxLength" disabled="@Vm.IsBusy" />
        </label>
    }

    @if (Vm.ErrorText is not null)
    {
        <p class="account-error" role="alert">@Vm.ErrorText</p>
    }

    <button type="submit" class="account-submit" disabled="@Vm.IsBusy">@Vm.SubmitText</button>
    <button type="button" class="account-switch" @onclick="Vm.SwitchMode" disabled="@Vm.IsBusy">@Vm.SwitchModeText</button>
</form>

@code {
    /// <summary>The form's view model; the page that hosts the component creates it and handles SignedIn.</summary>
    [Parameter, EditorRequired] public AccountFormViewModel Vm { get; set; } = default!;

    private AccountFormViewModel? _subscribed;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, Vm))
        {
            return;
        }

        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnChanged;
        }

        _subscribed = Vm;
        Vm.Changed += OnChanged;
    }

    // The view model can raise Changed from a socket callback; marshal back to the render context.
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private Task SubmitAsync() => Vm.SubmitAsync(CancellationToken.None);

    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnChanged;
        }
    }
}
