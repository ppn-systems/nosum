@using Nosum.Wasm.Controls.Common
@using Nosum.Wasm.ViewModels.Account
@using System.Threading
@implements IDisposable

@* Reusable login / register form, built only from the shared controls. All text and behaviour come from the view model; no network code here.
   The fields and buttons are Focusable: this form is shown while the game does not own the keyboard (before sign-in, or over the game on upgrade). *@
<GamePanel Title="@Vm.Title" Class="account" Role="form">
    <form class="account-form @(Vm.IsRegister ? "register" : null)" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
        <GameStack>
            <div class="account-fields">
                <GameField Label="@Vm.EmailLabel" Hint="@(Vm.IsRegister ? Vm.EmailHint : null)">
                    <GameInput Type="email" Value="@Vm.Email" ValueChanged="@(v => Vm.Email = v)" Label="@Vm.EmailLabel" AutoComplete="email"
                               MaxLength="@AccountFormViewModel.EmailMaxLength" Disabled="@Vm.IsBusy" />
                </GameField>

                <GameField Label="@Vm.PasswordLabel" Hint="@(Vm.IsRegister ? Vm.PasswordHint : null)">
                    <GameInput Type="password" Value="@Vm.Password" ValueChanged="@(v => Vm.Password = v)" Label="@Vm.PasswordLabel" AutoComplete="@(Vm.IsRegister ? "new-password" : "current-password")"
                               MaxLength="@AccountFormViewModel.PasswordMaxLength" Disabled="@Vm.IsBusy" />
                </GameField>

                @if (Vm.IsRegister)
                {
                    <GameField Label="@Vm.ConfirmPasswordLabel">
                        <GameInput Type="password" Value="@Vm.ConfirmPassword" ValueChanged="@(v => Vm.ConfirmPassword = v)" Label="@Vm.ConfirmPasswordLabel" AutoComplete="new-password"
                                   MaxLength="@AccountFormViewModel.PasswordMaxLength" Disabled="@Vm.IsBusy" />
                    </GameField>

                    <GameField Label="@Vm.NicknameLabel" Hint="@Vm.NicknameHint">
                        <GameInput Value="@Vm.Nickname" ValueChanged="@(v => Vm.Nickname = v)" Label="@Vm.NicknameLabel" AutoComplete="nickname" MaxLength="@AccountFormViewModel.NicknameMaxLength" Disabled="@Vm.IsBusy" />
                    </GameField>
                }

            </div>

            @if (Vm.ErrorText is not null)
            {
                <GameNotice Kind="error" Text="@Vm.ErrorText" />
            }

            <GameButton Submit="true" Focusable="true" Disabled="@Vm.IsBusy">@Vm.SubmitText@if (Vm.IsBusy)
                {
                    <GameSpinner />
                }</GameButton>

            @if (Vm.Mode == AccountFormMode.Upgrade)
            {
                <GameButton Variant="plain" Focusable="true" OnClick="Vm.CancelUpgrade" Disabled="@Vm.IsBusy" Text="@Vm.CancelText" />
            }
            else
            {
                <GameButton Variant="link" Focusable="true" OnClick="Vm.SwitchMode" Disabled="@Vm.IsBusy" Text="@Vm.SwitchModeText" />
            }

            @if (!Vm.IsRegister && OnForgotPassword.HasDelegate)
            {
                <GameButton Variant="link" Focusable="true" OnClick="OnForgotPassword" Disabled="@Vm.IsBusy" Text="@ForgotPasswordText" />
            }

            @if (Vm.CanPlayAsGuest)
            {
                <GameButton Variant="plain" Focusable="true" OnClick="PlayAsGuestAsync" Disabled="@Vm.IsBusy" Text="@Vm.PlayAsGuestText" />
            }
        </GameStack>
    </form>
</GamePanel>

@code {
    /// <summary>The form's view model; the page that hosts the component creates it and handles SignedIn.</summary>
    [Parameter, EditorRequired] public AccountFormViewModel Vm { get; set; } = default!;

    /// <summary>Raised by the "forgot password" link of the sign-in form; the link is not shown when nobody handles it (the upgrade form).</summary>
    [Parameter] public EventCallback OnForgotPassword { get; set; }

    /// <summary>The text of the "forgot password" link.</summary>
    [Parameter] public string ForgotPasswordText { get; set; } = string.Empty;

    private AccountFormViewModel? _subscribed;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, Vm))
        {
            return;
        }

        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnChanged;
        }

        _subscribed = Vm;
        Vm.Changed += OnChanged;
    }

    // The view model can raise Changed from a socket callback; marshal back to the render context.
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private Task SubmitAsync() => Vm.SubmitAsync(CancellationToken.None);

    private Task PlayAsGuestAsync() => Vm.PlayAsGuestAsync(CancellationToken.None);

    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnChanged;
        }
    }
}
