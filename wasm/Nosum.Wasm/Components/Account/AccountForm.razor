@using Nosum.Wasm.Controls.Common
@using Nosum.Wasm.ViewModels.Account
@using System
@using System.Threading
@implements IDisposable

@* Reusable account form, built only from the shared controls: sign in with Google or Microsoft, or play as a guest; a guest links one of the two
   identities and chooses a nickname. All text and behaviour come from the view model; no network code here. The buttons are Focusable: this form
   is shown while the game does not own the keyboard (before sign-in, or over the game on upgrade). The two provider buttons are not framed in the
   game's wooden button: each draws its provider's own look (docs/adr/ADR-081). *@
<GamePanel Title="@Vm.Title" Class="account" Role="form">
    <div class="account-form">
        <GameStack>
            @if (Vm.IsUpgradeMode)
            {
                <GameField Label="@Vm.NicknameLabel" Hint="@Vm.NicknameHint">
                    <GameInput Value="@Vm.Nickname" ValueChanged="@(v => Vm.Nickname = v)" Label="@Vm.NicknameLabel" AutoComplete="nickname" MaxLength="@AccountFormViewModel.NicknameMaxLength" Disabled="@Vm.IsBusy" />
                </GameField>
            }

            <div class="account-providers">
                @* Google draws its own button here at the slot's width (a click opens its popup). Without a client id the slot shows the same button, switched off. *@
                @if (Vm.GoogleEnabled)
                {
                    <div id="@_googleSlotId" class="account-google" role="group" aria-label="@Vm.SignInGoogleText"></div>
                }
                else
                {
                    <div class="account-google account-google-off" role="img" aria-label="@(Vm.IsUpgradeMode ? Vm.LinkGoogleText : Vm.SignInGoogleText)">
                        @(Vm.IsUpgradeMode ? Vm.LinkGoogleText : Vm.SignInGoogleText)
                    </div>
                }
                <MicrosoftSignInButton Text="@(Vm.IsUpgradeMode ? Vm.LinkMicrosoftText : Vm.SignInMicrosoftText)" Disabled="@(Vm.IsBusy || !Vm.MicrosoftEnabled)"
                                       OnClick="@(() => Vm.IsUpgradeMode ? Vm.LinkMicrosoftAsync() : Vm.SignInWithMicrosoftAsync())" />
            </div>

            @* One line for a provider that is off on this server, instead of a notice under each button (issue #207). *@
            @if (Vm.ProviderHint is { } providerHint)
            {
                <GameNotice Kind="info" Text="@providerHint" />
            }

            @if (Vm.IsAwaitingProvider)
            {
                <GameNotice Kind="info" Text="@Vm.AwaitingProviderText"><GameSpinner /></GameNotice>
            }

            @if (Vm.ErrorText is not null)
            {
                <GameNotice Kind="error" Text="@Vm.ErrorText" />
            }

            @if (Vm.IsUpgradeMode)
            {
                <GameButton Variant="plain" Focusable="true" OnClick="Vm.CancelUpgrade" Disabled="@Vm.IsBusy" Text="@Vm.CancelText" />
            }
            else if (Vm.CanPlayAsGuest)
            {
                <GameButton Variant="plain" Focusable="true" OnClick="PlayAsGuestAsync" Disabled="@Vm.IsBusy" Text="@Vm.PlayAsGuestText" />
            }
        </GameStack>
    </div>
</GamePanel>

@code {
    /// <summary>The form's view model; the page that hosts the component creates it and handles SignedIn.</summary>
    [Parameter, EditorRequired] public AccountFormViewModel Vm { get; set; } = default!;

    private AccountFormViewModel? _subscribed;
    private readonly string _googleSlotId = "account-google-" + Guid.NewGuid().ToString("N");
    private string? _googleLocale;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, Vm))
        {
            return;
        }

        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnChanged;
        }

        _subscribed = Vm;
        Vm.Changed += OnChanged;
    }

    // Google's button is drawn into the slot once, and again when the UI language changes (its text follows the locale).
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Vm.GoogleEnabled && _googleLocale != AccountFormViewModel.GoogleButtonLocale)
        {
            _googleLocale = AccountFormViewModel.GoogleButtonLocale;
            await Vm.AttachGoogleButtonAsync(_googleSlotId);
        }
    }

    // The view model can raise Changed from a socket callback; marshal back to the render context.
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private Task PlayAsGuestAsync() => Vm.PlayAsGuestAsync(CancellationToken.None);

    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnChanged;
        }
    }
}
