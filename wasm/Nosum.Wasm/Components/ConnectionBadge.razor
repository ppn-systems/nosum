@using Nosum.Wasm.Controls.Common
@using Nosum.Wasm.Socket
@using Nosum.Wasm.ViewModels.Player
@implements IDisposable
@inject ConnectionStatusViewModel Status

@* Shown only when something is wrong: nothing while the connection is fine. *@
@if (Status.State != GameSocketState.Ready)
{
    <GameBadge Kind="@Kind" Text="@Status.Text" />
}

@code {
    private string Kind => Status.State switch
    {
        GameSocketState.Ready => "ok",
        GameSocketState.Connecting or GameSocketState.Reconnecting => "warn",
        _ => "error",
    };

    protected override void OnInitialized() => Status.Changed += OnChanged;

    // The view model raises Changed on a socket thread; render on the component's context.
    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Status.Changed -= OnChanged;
}
