@page "/"
@using System.IO
@using System.Net.Http
@using System.Runtime.InteropServices.JavaScript
@using System.Threading
@using System.Runtime.Versioning
@using Nosum.Wasm.Components
@using Nosum.Wasm.Components.Account
@using Nosum.Wasm.Controls.Common
@using Nosum.Wasm.Controls.Chat
@using Nosum.Wasm.Controls.Coop
@using Nosum.Wasm.Controls.Friends
@using Nosum.Wasm.Controls.Mail
@using Nosum.Wasm.Controls.Feedback
@using Nosum.Wasm.Controls.Menu
@using Nosum.Wasm.Controls.Settings
@using Nosum.Wasm.Controls.Layout
@using Nosum.Wasm.ViewModels.Help
@using Nosum.Wasm.Controls.Inventory
@using Nosum.Wasm.Controls.Looks
@using Nosum.Wasm.Controls.Market
@using Nosum.Wasm.Controls.Placement
@using Nosum.Wasm.Controls.Profile
@using Nosum.Wasm.Controls.Shop
@using Nosum.Wasm.Controls.Quest
@using Nosum.Wasm.Controls.Trade
@using Nosum.Wasm.Controls.Wallet
@using Nosum.Wasm.Controls.Calendar
@using Nosum.Wasm.ViewModels.Calendar
@using Nosum.Wasm.Game
@using Nosum.Contracts.Account
@using Nosum.Wasm.ViewModels
@using Nosum.Wasm.ViewModels.Account
@using Nosum.Wasm.ViewModels.Chat
@using Nosum.Wasm.ViewModels.Coop
@using Nosum.Wasm.ViewModels.Friends
@using Nosum.Wasm.ViewModels.Mail
@using Nosum.Wasm.ViewModels.Visit
@using Nosum.Wasm.Controls.Visit
@using Nosum.Wasm.ViewModels.Looks
@using Nosum.Wasm.ViewModels.Market
@using Nosum.Wasm.ViewModels.Wallet
@using Nosum.Wasm.ViewModels.Trade
@using Nosum.Wasm.ViewModels.Feedback
@using Nosum.Wasm.ViewModels.Inventory
@using Nosum.Wasm.ViewModels.Placement
@using Nosum.Wasm.ViewModels.Profile
@using Nosum.Wasm.ViewModels.Shop
@using Nosum.Wasm.ViewModels.Quest
@attribute [SupportedOSPlatform("browser")]
@implements IDisposable
@inject HttpClient Http
@inject AccountFormViewModel Form
@inject AccountSessionKeeper Keeper
@inject NavigationManager Navigation
@inject InventoryViewModel Inventory
@inject QuestTrackerViewModel Quest
@inject GameMessagesViewModel Messages
@inject ToolbarViewModel Toolbar
@inject WalletViewModel Wallet
@inject CalendarViewModel Calendar
@inject MarketViewModel Market
@inject WardrobeViewModel Wardrobe
@inject TradeViewModel Trade
@inject CoopViewModel Coop
@inject VisitorsViewModel Visitors
@inject ChatViewModel Chat
@inject FriendsViewModel Friends
@inject MailViewModel Mail
@inject PlacementViewModel Placement
@inject ProfileViewModel Profile
@inject ShopViewModel Shop
@inject HelpViewModel Help

<PageTitle>Nosum</PageTitle>

<canvas id="game-canvas" class="game-canvas" tabindex="0"></canvas>
@if (!_signedIn)
{
    @* The game starts after sign-in: the canvas listens to the whole window's keys, which would swallow typing. *@
    <StartScreen Vm="Form" />
}
else
{
    <GameHud>
        <TopLeft>
            @if (_started && _panel == PanelKind.None)
            {
                <QuestTracker Vm="Quest" />
                <PlacementPanel Vm="Placement" />
            }
        </TopLeft>
        <TopCenter>
            @if (_error is not null)
            {
                <GamePanel Class="hud" Title="">
                    <GameNotice Kind="error" Text="@_error" />
                </GamePanel>
            }
            <ConnectionBadge />
        </TopCenter>
        <TopRight>
            @if (_started)
            {
                <CalendarClock Vm="Calendar" />
                <CoinBadge Vm="Wallet" />
                <GameIconButton Icon="tab-settings" Tip="@(Mail.Unread > 0 ? Toolbar.Text("Toolbar_Settings") + " - " + Toolbar.Text("Toolbar_MailUnread", Mail.Unread) : Toolbar.Text("Toolbar_Settings"))" Badge="Mail.Unread" OnClick="@(() => TogglePanel(PanelKind.Settings))" />
            }
        </TopRight>
        <Center>
            @* The upgrade form is a dialog of its own: the menu steps aside while it is open and comes back with it closed. *@
            @if (_started && _panel != PanelKind.None && !Form.ShowsForm)
            {
                <GameMenu Tabs="Tabs()" Active="(int)_panel" OnSelect="@(id => SelectTab((PanelKind)id))" OnClose="ClosePanel" CloseText="@Toolbar.Text("Panel_Close")">
                    @switch (_panel)
                    {
                        case PanelKind.Inventory:
                            <InventoryPanel Vm="Inventory" Wardrobe="Wardrobe" />
                            break;
                        case PanelKind.Market:
                            <MarketPanel Vm="Market" />
                            break;
                        case PanelKind.Wardrobe:
                            <WardrobePanel Vm="Wardrobe" />
                            break;
                        case PanelKind.Trade:
                            <TradePanel Vm="Trade" />
                            break;
                        case PanelKind.Coop:
                            <CoopPanel Vm="Coop" />
                            break;
                        case PanelKind.Profile:
                            <ProfilePanel Vm="Profile" />
                            break;
                        case PanelKind.Visitors:
                            <VisitorsPanel Vm="Visitors" OnClose="ClosePanel" />
                            break;
                        case PanelKind.Friends:
                            <FriendsPanel Vm="Friends" />
                            break;
                        case PanelKind.Mail:
                            <MailPanel Vm="Mail" />
                            break;
                        case PanelKind.Shop:
                            <ShopPanel Vm="Shop" ShopId="_shopId" />
                            break;
                        case PanelKind.Settings:
                            <SettingsPanel Vm="Form" Help="Help" />
                            break;
                    }
                </GameMenu>
            }
        </Center>
        <BottomCenter>
            @if (_started && _panel == PanelKind.None)
            {
                <GameMessage Vm="Messages" />
                <Hotbar Vm="Inventory" />
            }
        </BottomCenter>
        <BottomLeft>
            @if (_started)
            {
                <ChatLine Vm="Chat" Enabled="@(_panel == PanelKind.None && !Form.ShowsForm)" />
            }
        </BottomLeft>
        <Overlay>
            @if (!_started)
            {
                <GamePanel Class="dialog" Title="" Role="status">
                    <p class="home-loading">@Toolbar.Text("Game_Loading") <GameSpinner /></p>
                </GamePanel>
            }
            @if (Form.ShowsForm)
            {
                @* Upgrade form over the running game. *@
                <AccountForm Vm="Form" />
            }
            @if (Trade.Phase == TradePhase.Invited)
            {
                <ConfirmDialog Title="@Trade.Text("Trade_InviteTitle")" Message="@Trade.Text("Trade_InviteMessage", Trade.InviterLabel)"
                               ConfirmText="@Trade.Text("Coop_Accept")" CancelText="@Trade.Text("Coop_Decline")"
                               OnConfirm="@(() => Trade.Respond(true))" OnCancel="@(() => Trade.Respond(false))" />
            }
            else if (_panel != PanelKind.Coop && !Coop.HasCoop && Coop.Invites.Count > 0)
            {
                (Guid inviteId, string coopName, string inviter) = Coop.Invites[0];
                <ConfirmDialog Title="@Coop.Text("Coop_InviteTitle")" Message="@(inviter.Length > 0 ? Coop.Text("Coop_InviteMessageFrom", coopName, inviter) : Coop.Text("Coop_InviteMessage", coopName))"
                               ConfirmText="@Coop.Text("Coop_Accept")" CancelText="@Coop.Text("Coop_Decline")"
                               OnConfirm="@(() => Coop.Respond(inviteId, true))" OnCancel="@(() => Coop.Respond(inviteId, false))" />
            }
        </Overlay>
    </GameHud>
}

@code {
    private bool _signedIn;
    private bool _started;
    private PanelKind _panel;
    private PanelKind _lastTab = PanelKind.Inventory;
    private int _shopId;
    private string? _error;

    protected override void OnInitialized()
    {
        Form.SignedIn += OnSignedIn;
        Form.SessionUpdated += Keeper.UpdateSession;
        Form.SessionUpdated += OnSessionUpdated;
        Form.SignedOut += OnSignedOut;
        Form.Changed += OnFormChanged;
        Keeper.SessionEnded += OnSessionEnded;
        Keeper.RegistrationPromptUnlocked += OnPromptUnlocked;
        GameLoop.PanelToggleRequested += OnPanelKey;
        GameLoop.ShopRequested += OnShopRequested;
        GameLoop.PanelCloseRequested += OnCloseKey;
        Trade.WantsOpen += OnTradeWantsOpen;
        Trade.Changed += OnViewModelChanged;
        Coop.Changed += OnViewModelChanged;
        Mail.Changed += OnViewModelChanged;

        // Back from a session the server ended: say why on the account form.
        string query = Navigation.ToAbsoluteUri(Navigation.Uri).Query;
        if (query.StartsWith("?ended=", StringComparison.Ordinal)
            && Enum.TryParse(query["?ended=".Length..], out AccountStatus reason)
            && reason == AccountStatus.SessionReplaced)
        {
            Form.ShowSessionEnded(reason);
        }
    }

    public void Dispose()
    {
        Form.SignedIn -= OnSignedIn;
        Form.SessionUpdated -= Keeper.UpdateSession;
        Form.SessionUpdated -= OnSessionUpdated;
        Form.SignedOut -= OnSignedOut;
        Form.Changed -= OnFormChanged;
        Keeper.SessionEnded -= OnSessionEnded;
        Keeper.RegistrationPromptUnlocked -= OnPromptUnlocked;
        GameLoop.PanelToggleRequested -= OnPanelKey;
        GameLoop.ShopRequested -= OnShopRequested;
        GameLoop.PanelCloseRequested -= OnCloseKey;
        Trade.WantsOpen -= OnTradeWantsOpen;
        Trade.Changed -= OnViewModelChanged;
        Coop.Changed -= OnViewModelChanged;
        Mail.Changed -= OnViewModelChanged;
    }

    // A guest registered under a nickname: the profile shows it.
    private void OnSessionUpdated(AccountSession session) => Profile.Begin(session.Nickname, session.IsGuest);

    // The first quest was finished: the session bar now offers the registration (the form's session is the one it shows).
    private void OnPromptUnlocked() => Form.UnlockRegistrationPrompt();

    // A panel key was pressed in the game (raised from the frame loop). H and ? open the settings page, which holds the key help.
    private void OnPanelKey(PanelKind kind) => _ = InvokeAsync(() => TogglePanel(kind == PanelKind.Help ? PanelKind.Settings : kind));

    // The action key next to a shop counter (raised from the frame): open that shop on its tab.
    private void OnShopRequested(int shopId) => _ = InvokeAsync(() =>
    {
        if (_panel != PanelKind.Shop)
        {
            _shopId = shopId;
            Shop.Open(shopId);
            Show(PanelKind.Shop);
            StateHasChanged();
        }
    });

    // Escape: leave the upgrade form, or close the menu, or else open it on the tab used last.
    private void OnCloseKey() => _ = InvokeAsync(() =>
    {
        if (Form.Mode == AccountFormMode.Upgrade)
        {
            Form.CancelUpgrade();
        }
        else if (_panel != PanelKind.None)
        {
            ClosePanel();
        }
        else
        {
            Show(_lastTab);
        }

        StateHasChanged();
    });

    // The tabs of the game menu: the toolbar's entries, plus the shop (titled by the shop that was opened) while one is open.
    // A new tab is one more entry in ToolbarViewModel.Items.
    private IReadOnlyList<MenuTab> Tabs()
    {
        List<MenuTab> tabs = [];
        foreach (ToolbarItem item in Toolbar.Items)
        {
            if (item.Kind == PanelKind.Settings && _panel == PanelKind.Shop)
            {
                tabs.Add(Tab(Toolbar.ShopItem with { Label = Shop.Title.Length > 0 ? Shop.Title : Toolbar.ShopItem.Label }));
            }

            tabs.Add(Tab(item));
        }

        return tabs;

        static MenuTab Tab(ToolbarItem item) => new((int)item.Kind, item.Label, item.Icon, item.Hotkey);
    }

    private void SelectTab(PanelKind kind) => Show(kind);

    private void TogglePanel(PanelKind kind)
    {
        if (_panel == kind)
        {
            ClosePanel();
        }
        else
        {
            Show(kind);
        }

        StateHasChanged();
    }

    private void Show(PanelKind kind)
    {
        _panel = kind;
        if (kind != PanelKind.Shop)
        {
            _lastTab = kind;
        }

        Toolbar.Active = _panel;
    }

    private void ClosePanel()
    {
        _panel = PanelKind.None;
        Toolbar.Active = _panel;
    }

    // A trade began: show its window.
    private void OnTradeWantsOpen(bool open)
    {
        if (open && Trade.Phase == TradePhase.Open)
        {
            _ = InvokeAsync(() =>
            {
                Show(PanelKind.Trade);
                StateHasChanged();
            });
        }
    }

    // The invitation dialogs follow the trade and co-op state.
    private void OnViewModelChanged() => _ = InvokeAsync(StateHasChanged);

    // The overlay shows or hides with the form's mode (upgrade form over the running game).
    private void OnFormChanged() => _ = InvokeAsync(StateHasChanged);

    // Another connection of this player took over: reload to the account form with the reason (the game cannot be stopped in place).
    private void OnSessionEnded(AccountStatus reason)
        => _ = InvokeAsync(() => Navigation.NavigateTo("/?ended=" + reason, forceLoad: true));

    // Signing out reloads the page: the game loop and its input handlers are torn down with it, and the
    // account form is the first thing the fresh page shows.
    private void OnSignedOut()
    {
        Keeper.SignedOut();
        _ = InvokeAsync(() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true));
    }

    // Raised by the form's view model after a successful register or login.
    private void OnSignedIn(AccountSession session)
    {
        Keeper.SignedIn(session);
        Profile.Begin(session.Nickname, session.IsGuest);
        _signedIn = true;
        _ = InvokeAsync(async () =>
        {
            StateHasChanged();
            await StartGameAsync();
        });
    }

    private async Task StartGameAsync()
    {
        try
        {
            await GameLoop.StartAsync(Http, "game-canvas", CancellationToken.None);
            _started = true;
            StateHasChanged();
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidDataException or JSException)
        {
            _error = Toolbar.Text("Game_StartFailed", ex.Message);
            _started = true;
            StateHasChanged();
        }
    }
}
