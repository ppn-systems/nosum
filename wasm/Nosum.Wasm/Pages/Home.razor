@implements IDisposable
@inject HttpClient Http
@inject AccountFormViewModel Form
@inject AccountSessionKeeper Keeper
@inject NavigationManager Navigation
@inject InventoryViewModel Inventory
@inject QuestTrackerViewModel Quest
@inject GameMessagesViewModel Messages
@inject LevelUpBannerViewModel LevelUps
@inject SeasonBannerViewModel Seasons
@inject ToolbarViewModel Toolbar
@inject EmoteWheelViewModel Emotes
@inject WalletViewModel Wallet
@inject MinimapViewModel Minimap
@inject CalendarViewModel Calendar
@inject MarketViewModel Market
@inject TradeViewModel Trade
@inject CoopViewModel Coop
@inject ChatViewModel Chat
@inject MailViewModel Mail
@inject PlacementViewModel Placement
@inject FurnitureCatalogViewModel Furniture
@inject ProfileViewModel Profile
@inject ElevatorViewModel Elevator
@inject MapLoadingViewModel MapLoading
@inject GameStartViewModel Starting
@inject SettingsViewModel AppSettings
@inject OnboardingViewModel Onboarding
@inject CraftingViewModel Crafting
@inject ChestViewModel Chest
@inject FurnaceViewModel Furnace
@inject FishingViewModel Fishing
@inject CarpenterViewModel Carpenter
@inject ProgressViewModel Progress
@inject NpcDialogViewModel Npc
@inject ConnectionStatusViewModel ConnectionStatus
@inject PetViewModel Pet

<PageTitle>Nosum</PageTitle>

@* A click or tap on a merchant talks to them (docs/adr/ADR-043 D3); the frame decides whether the click hit one and whether the farmer is in reach. *@
<canvas id="game-canvas" class="game-canvas" tabindex="0" @onclick="OnCanvasClick"></canvas>
@if (!_signedIn)
{
    @* The game starts after sign-in: the canvas listens to the whole window's keys, which would swallow typing. *@
    <StartScreen Vm="Form" />
}
else
{
    <GameHud>
        <TopLeft>
            @if (_started && _panel == PanelKind.None)
            {
                <QuestTracker Vm="Quest" />
            }
        </TopLeft>
        <TopCenter>
            @if (_error is not null)
            {
                <GamePanel Class="hud" Title="">
                    <GameNotice Kind="error" Text="@_error" />
                </GamePanel>
            }
            <LevelUpBanner Vm="LevelUps" />
            <SeasonBanner Vm="Seasons" />
            <FishingCatchCard Vm="Fishing" />
            <ConnectionBadge />
        </TopCenter>
        <TopRight>
            @if (_started)
            {
                <HudTopRightBar Calendar="Calendar" Wallet="Wallet" Mail="Mail" Minimap="Minimap" Toolbar="Toolbar" ActivePanel="_panel" OnTogglePanel="TogglePanel" />
            }
        </TopRight>
        <Center>
            @* The arrange mode's furniture panel: a window in the centre, not a corner plaque (docs/design/ui-standard.md section 2). *@
            @if (_started && _panel == PanelKind.None && !Form.ShowsForm)
            {
                <FurniturePanel Vm="Furniture" Placement="Placement" />
            }
            @* Every open panel is a standalone window of its own, never crammed into a shared multi-tab menu (docs/adr/ADR-044). *@
            @if (_started && _panel != PanelKind.None && !Form.ShowsForm)
            {
                <GameMenuWindow Panel="_panel" ShopId="_shopId" OnDialogClose="OnDialogClose" OnClosePanel="ClosePanel" OnOpenPanel="TogglePanel" />
            }
        </Center>
        <BottomCenter>
            @if (_started && _panel == PanelKind.None)
            {
                @if (Npc.Stage == NpcStage.Speaking)
                {
                    @* A merchant is talking: their box takes the hotbar's place (docs/adr/ADR-043 D3). *@
                    <GameMessage Vm="Messages" />
                    <NpcDialogBox Vm="Npc" />
                }
                else
                {
                    <OnboardingHint Vm="Onboarding" />
                    <FishingBanner Vm="Fishing" />
                    <GameMessage Vm="Messages" />
                    <Hotbar Vm="Inventory" Progress="Progress" />
                }
            }
        </BottomCenter>
        <BottomLeft>
            @if (_started)
            {
                <ChatLine Vm="Chat" Enabled="@(_panel == PanelKind.None && !Form.ShowsForm && !Elevator.IsOpen && Npc.Stage == NpcStage.Closed && !IsInviteOpen())" />
            }
        </BottomLeft>
        <BottomRight>
            @if (_started && !Form.ShowsForm)
            {
                @* The emote wheel's button, bottom-right (docs/adr/ADR-075 D1): the same as the B key, and the touch way to open the wheel. *@
                <div class="hud-cell"><GameIconButton Icon="emote-0" Tip="@Emotes.OpenTip" OnClick="@(() => Emotes.Toggle())" /></div>
            }
        </BottomRight>
        <Overlay>
            @if (!Form.ShowsForm)
            {
                @* The reconnect overlay; the sign-in form shows the connection state itself, so the two never stack. *@
                <ConnectionOverlay Vm="ConnectionStatus" />
            }
            @if (!_started)
            {
                <GameStartOverlay Vm="Starting" OnRetry="RetryStart" />
            }
            @if (_started)
            {
                @* The mine elevator's picker, a small dialog over the game. *@
                <ElevatorDialog Vm="Elevator" />
            }
            @* The black screen while a map the server sent the player to loads. *@
            <MapLoadingOverlay Vm="MapLoading" />
            @if (Form.ShowsForm)
            {
                @* Upgrade form over the running game. *@
                <AccountForm Vm="Form" />
            }
            <InviteOverlay Trade="Trade" Coop="Coop" ActivePanel="_panel" />
            <PetRehomeOverlay Vm="Pet" />
            @if (_started && !Form.ShowsForm)
            {
                @* The emote wheel, over the world; B or the HUD button opens it (docs/adr/ADR-075 D1). *@
                <EmoteWheel Vm="Emotes" />
            }
        </Overlay>
    </GameHud>
    @if (_started && _panel == PanelKind.None && !Form.ShowsForm)
    {
        <TouchControls Vm="AppSettings" StickLabel="@Toolbar.Text("Touch_Stick")" UseText="@Toolbar.Text("Touch_Use")" UseLabel="@Toolbar.Text("Touch_UseLabel")" />
    }
}

@code {
    private bool _signedIn;
    private bool _started;
    private PanelKind _panel;
    private PanelKind _lastTab = PanelKind.Inventory;
    private int _shopId;
    private string? _error;
    private Action? _unwireSession;

    protected override void OnInitialized()
    {
        Form.SessionUpdated += Keeper.UpdateSession;
        Form.SignedOut += OnSignedOut;
        Form.Changed += OnFormChanged;
        Keeper.RegistrationPromptUnlocked += OnPromptUnlocked;
        var keeperSignedIn = Keeper.SignedIn;
        var showEnded = Form.ShowSessionEnded;
        WireSessionEvents(
            keeperSignedIn,
            showEnded,
            h => Form.SignedIn += h,
            h => Form.SignedIn -= h,
            h => Form.SessionUpdated += h,
            h => Form.SessionUpdated -= h,
            h => Keeper.SessionEnded += h,
            h => Keeper.SessionEnded -= h,
            s => (s.Nickname, s.IsGuest));
        GameLoop.PanelToggleRequested += OnPanelKey;
        GameLoop.ShopRequested += OnShopRequested;
        GameLoop.CounterLeft += OnCounterLeft;
        Npc.Changed += OnNpcChanged;
        GameLoop.ElevatorRequested += OnElevatorRequested;
        GameLoop.FurnaceRequested += OnFurnaceRequested;
        GameLoop.PanelCloseRequested += OnCloseKey;
        Chest.OpenChanged += OnContainerOpenChanged;
        Furnace.OpenChanged += OnContainerOpenChanged;
        Elevator.Changed += OnViewModelChanged;
        Trade.WantsOpen += OnTradeWantsOpen;
        Trade.Changed += OnViewModelChanged;
        Coop.Changed += OnViewModelChanged;
        Mail.Changed += OnViewModelChanged;
        Chat.Changed += OnChatChanged;
    }

    protected override void OnAfterRender(bool firstRender) => SyncModalState();

    public void Dispose()
    {
        GameLoop.SetModalState(false, false);
        _unwireSession?.Invoke();
        Form.SessionUpdated -= Keeper.UpdateSession;
        Form.SignedOut -= OnSignedOut;
        Form.Changed -= OnFormChanged;
        Keeper.RegistrationPromptUnlocked -= OnPromptUnlocked;
        GameLoop.PanelToggleRequested -= OnPanelKey;
        GameLoop.ShopRequested -= OnShopRequested;
        GameLoop.CounterLeft -= OnCounterLeft;
        Npc.Changed -= OnNpcChanged;
        GameLoop.ElevatorRequested -= OnElevatorRequested;
        GameLoop.FurnaceRequested -= OnFurnaceRequested;
        GameLoop.PanelCloseRequested -= OnCloseKey;
        Chest.OpenChanged -= OnContainerOpenChanged;
        Furnace.OpenChanged -= OnContainerOpenChanged;
        Elevator.Changed -= OnViewModelChanged;
        Trade.WantsOpen -= OnTradeWantsOpen;
        Trade.Changed -= OnViewModelChanged;
        Coop.Changed -= OnViewModelChanged;
        Mail.Changed -= OnViewModelChanged;
        Chat.Changed -= OnChatChanged;
    }

    private void WireSessionEvents<TSession, TStatus>(
        Action<TSession> keeperSignedIn,
        Action<TStatus> showEnded,
        Action<Action<TSession>> addSignedIn,
        Action<Action<TSession>> removeSignedIn,
        Action<Action<TSession>> addUpdated,
        Action<Action<TSession>> removeUpdated,
        Action<Action<TStatus>> addEnded,
        Action<Action<TStatus>> removeEnded,
        Func<TSession, (string Nickname, bool IsGuest)> profileOf)
        where TStatus : struct, Enum
    {
        void SignedInHandler(TSession session)
        {
            keeperSignedIn(session);
            (string nickname, bool isGuest) = profileOf(session);
            Profile.Begin(nickname, isGuest);
            _signedIn = true;
            _ = InvokeAsync(async () =>
            {
                StateHasChanged();
                await StartGameAsync();
            });
        }

        void SessionUpdatedHandler(TSession session)
        {
            (string nickname, bool isGuest) = profileOf(session);
            Profile.Begin(nickname, isGuest);
        }

        void SessionEndedHandler(TStatus reason)
            => _ = InvokeAsync(() => Navigation.NavigateTo("/?ended=" + reason, forceLoad: true));

        addSignedIn(SignedInHandler);
        addUpdated(SessionUpdatedHandler);
        addEnded(SessionEndedHandler);
        _unwireSession = () =>
        {
            removeSignedIn(SignedInHandler);
            removeUpdated(SessionUpdatedHandler);
            removeEnded(SessionEndedHandler);
        };

        // Back from a session the server ended: say why on the account form.
        string query = Navigation.ToAbsoluteUri(Navigation.Uri).Query;
        if (query.StartsWith("?ended=", StringComparison.Ordinal)
            && query["?ended=".Length..] is ("SessionReplaced" or "SessionKicked" or "Banned") and var ended
            && Enum.TryParse(ended, out TStatus endedReason))
        {
            showEnded(endedReason);
        }
    }

    // The first quest was finished: the session bar now offers the registration (the form's session is the one it shows).
    private void OnPromptUnlocked() => Form.UnlockRegistrationPrompt();

    // A panel key was pressed in the game (raised from the frame loop). H and ? open the settings page, which holds the key help.
    private void OnPanelKey(PanelKind kind) => _ = InvokeAsync(() => TogglePanel(kind == PanelKind.Help ? PanelKind.Settings : kind));

    // The action key next to a counter, or a click on its merchant (raised from the frame): the merchant's dialog box opens (docs/adr/ADR-043 D3).
    private void OnShopRequested(int counterId) => _ = InvokeAsync(() =>
    {
        if (_panel == PanelKind.None && !Form.ShowsForm && !Elevator.IsOpen && !IsInviteOpen())
        {
            Npc.Interact(counterId);
            SyncModalState();
        }
    });

    // The farmer walked out of reach of a counter (raised from the frame): the conversation with its merchant ends, and with it the dialog it opened.
    private void OnCounterLeft(int counterId) => _ = InvokeAsync(() => Npc.CounterLeft(counterId));

    // The conversation moved on: the dialog box, the page it opened, or neither. The page shown follows the view model, never the other way round.
    private void OnNpcChanged() => _ = InvokeAsync(() =>
    {
        PanelKind want = Npc.Stage == NpcStage.Trading ? Npc.Panel : PanelKind.None;
        if (want != PanelKind.None)
        {
            _shopId = Npc.ShopId;
            if (Npc.Page == NpcPage.Build)
            {
                Carpenter.Open();
            }
            else if (Npc.Page is NpcPage.MarketBuy or NpcPage.MarketSell)
            {
                Market.SetTab(Npc.Page == NpcPage.MarketSell ? MarketTab.Sell : MarketTab.Browse);
            }

            if (_panel != want)
            {
                Show(want);
            }
        }
        else if (_panel is PanelKind.Shop or PanelKind.Market or PanelKind.Goals)
        {
            ClosePanel();
        }

        SyncModalState();
        StateHasChanged();
    });

    // A click on the world: the frame checks it against the merchants.
    private void OnCanvasClick(MouseEventArgs e)
    {
        if (_started && _panel == PanelKind.None && !Form.ShowsForm && !Elevator.IsOpen && Npc.Stage == NpcStage.Closed && !IsInviteOpen())
        {
            GameLoop.PointerClicked((int)e.OffsetX, (int)e.OffsetY);
        }
    }

    // The close button of a dialog: back to the merchant's box, or away for a chest or a furnace.
    private void OnDialogClose()
    {
        if (Npc.Stage == NpcStage.Trading)
        {
            Npc.Back();
        }
        else
        {
            ClosePanel();
            StateHasChanged();
        }
    }

    // The action key next to the mine elevator (raised from the frame): show the picker.
    private void OnElevatorRequested() => _ = InvokeAsync(() =>
    {
        if (_panel == PanelKind.None && Npc.Stage == NpcStage.Closed && !Form.ShowsForm && !Elevator.IsOpen && !IsInviteOpen())
        {
            Elevator.Open();
            SyncModalState();
            StateHasChanged();
        }
    });

    // The action key facing a furnace (raised from the frame): the furnace page opens when the view model says so.
    private void OnFurnaceRequested(int objectId) => _ = InvokeAsync(() =>
    {
        if (_panel == PanelKind.None && Npc.Stage == NpcStage.Closed && !Form.ShowsForm && !Elevator.IsOpen && !IsInviteOpen())
        {
            Furnace.Open(objectId);
        }
    });

    // A chest or a furnace page opened (the server said Ok) or closed (the server closed it, or the player walked away): show or hide its menu page.
    private void OnContainerOpenChanged(bool open) => _ = InvokeAsync(() =>
    {
        PanelKind kind = Chest.IsOpen ? PanelKind.Chest : Furnace.IsOpen ? PanelKind.Furnace : PanelKind.None;
        if (open && kind != PanelKind.None)
        {
            Show(kind);
        }
        else if (!open && _panel is PanelKind.Chest or PanelKind.Furnace && kind != _panel)
        {
            ClosePanel();
        }

        StateHasChanged();
    });

    // Escape: leave the upgrade form, or close the elevator picker, or close the menu, or else open it on the tab used last.
    private void OnCloseKey() => _ = InvokeAsync(() =>
    {
        if (Form.Mode == AccountFormMode.Upgrade)
        {
            Form.CancelUpgrade();
        }
        else if (Trade.Phase == TradePhase.Invited)
        {
            Trade.Respond(false);
        }
        else if (_panel != PanelKind.Coop && !Coop.HasCoop && Coop.Invites.Count > 0)
        {
            (Guid inviteId, _, _) = Coop.Invites[0];
            Coop.Respond(inviteId, false);
        }
        else if (Elevator.IsOpen)
        {
            Elevator.Close();
        }
        else if (Npc.Stage != NpcStage.Closed)
        {
            Npc.Leave();
        }
        else if (Furniture.IsVisible)
        {
            Furniture.Exit();
        }
        else if (_panel != PanelKind.None)
        {
            ClosePanel();
        }
        else
        {
            Show(_lastTab);
        }

        SyncModalState();
        StateHasChanged();
    });

    private void TogglePanel(PanelKind kind)
    {
        if (_panel == kind)
        {
            ClosePanel();
        }
        else
        {
            Show(kind);
        }

        SyncModalState();
        StateHasChanged();
    }

    private void Show(PanelKind kind)
    {
        if (Elevator.IsOpen)
        {
            Elevator.Close();
        }

        // Anything but the page the merchant opened ends the conversation, so it cannot be left half open behind another page.
        if (Npc.Stage != NpcStage.Closed && kind != Npc.Panel)
        {
            Npc.Leave();
        }

        // Leaving a chest or furnace page for another tab closes it, so opening it again shows it again.
        if (_panel == PanelKind.Chest && kind != PanelKind.Chest)
        {
            Chest.Close();
        }
        else if (_panel == PanelKind.Furnace && kind != PanelKind.Furnace)
        {
            Furnace.Close();
        }
        else if (_panel == PanelKind.Trade && kind != PanelKind.Trade && Trade.Phase is TradePhase.Open or TradePhase.Waiting)
        {
            Trade.Cancel();
        }

        _panel = kind;
        if (kind is not (PanelKind.Shop or PanelKind.Chest or PanelKind.Furnace or PanelKind.Goals or PanelKind.Market))
        {
            _lastTab = kind;
        }

        if (kind == PanelKind.Crafting)
        {
            Crafting.Open();
        }

        Toolbar.Active = _panel;
        SyncModalState();
    }

    private void ClosePanel()
    {
        if (_panel == PanelKind.Chest)
        {
            Chest.Close();
        }
        else if (_panel == PanelKind.Furnace)
        {
            Furnace.Close();
        }
        else if (_panel == PanelKind.Trade && Trade.Phase is TradePhase.Open or TradePhase.Waiting)
        {
            Trade.Cancel();
        }

        _panel = PanelKind.None;
        Toolbar.Active = _panel;
        SyncModalState();
    }

    private bool IsInviteOpen() => Trade.Phase == TradePhase.Invited || (_panel != PanelKind.Coop && !Coop.HasCoop && Coop.Invites.Count > 0);

    private void SyncModalState()
    {
        bool overlayOpen = !_started || Form.ShowsForm || Elevator.IsOpen || IsInviteOpen();
        bool modalOpen = overlayOpen || _panel != PanelKind.None || Npc.Stage != NpcStage.Closed || Chat.InputOpen;
        GameLoop.SetModalState(modalOpen, overlayOpen);
    }

    // Opening the chat box does not re-render this page, so the game is told here: while the box is open, the keys are typing (issue #144).
    private void OnChatChanged() => _ = InvokeAsync(SyncModalState);

    // A trade began: show its window.
    private void OnTradeWantsOpen(bool open)
    {
        if (open && Trade.Phase == TradePhase.Open)
        {
            _ = InvokeAsync(() =>
            {
                Show(PanelKind.Trade);
                StateHasChanged();
            });
        }
    }

    // The invitation dialogs follow the trade and co-op state.
    private void OnViewModelChanged() => _ = InvokeAsync(StateHasChanged);

    // The overlay shows or hides with the form's mode (upgrade form over the running game).
    private void OnFormChanged() => _ = InvokeAsync(StateHasChanged);

    // Signing out reloads the page: the game loop and its input handlers are torn down with it, and the
    // account form is the first thing the fresh page shows.
    private void OnSignedOut()
    {
        Keeper.SignedOut();
        _ = InvokeAsync(() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true));
    }

    private async Task StartGameAsync()
    {
        Starting.Begin();
        try
        {
            await GameLoop.StartAsync(Http, "game-canvas", CancellationToken.None, Starting.SetStep);
            Starting.End();
            _started = true;
            Onboarding.Start();
            StateHasChanged();
        }
        catch (Exception ex) when (ex is HttpRequestException or InvalidDataException or JSException)
        {
            Starting.End();
            _error = Toolbar.Text("Game_StartFailed", ex.Message);
            _started = true;
            StateHasChanged();
        }
    }

    // Try again on a stalled start: the page reloads, and the game starts again from sign-in with a fresh client.
    private void RetryStart() => Navigation.Refresh(forceReload: true);
}
