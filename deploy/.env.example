# Names only (docs/adr/ADR-041 D2). On the production host the deploy workflow writes deploy/.env from GitHub secrets (docs/ops/README.md);
# for a manual start, copy this file to deploy/.env and fill every value. .env is never committed.

# Password of the PostgreSQL role `nosum` (letters and digits only: it goes into a connection string). Read by PostgreSQL only when the data volume is created.
POSTGRES_PASSWORD=

# Token of the Cloudflare Tunnel `nosum-api` (Zero Trust dashboard, docs/ops/README.md). Keep it secret: it lets its holder run the tunnel.
CLOUDFLARE_TUNNEL_TOKEN=

# Origin of the web client on Cloudflare Pages, for example https://nosum.pages.dev (or the custom domain). The server accepts WebSocket
# handshakes from this origin only.
NOSUM_ORIGIN=

# Image tag of nosum-host: the commit SHA the workflow deploys. The workflow keeps the previous tag in NOSUM_PREVIOUS_TAG for a rollback.
NOSUM_TAG=
NOSUM_PREVIOUS_TAG=

# Optional: the cloudflared image tag (pin a current release, github.com/cloudflare/cloudflared/releases), the start of the server calendar
# (ISO 8601 UTC, default: the built-in epoch), the hour (UTC) of the nightly backup and how many days of dumps to keep.
CLOUDFLARED_TAG=2025.8.1
NOSUM_CALENDAR_EPOCH=
BACKUP_HOUR_UTC=3
BACKUP_KEEP_DAYS=14

# Optional: mail for password recovery codes (docs/adr/ADR-029). Without NOSUM_SMTP_HOST nothing is sent and the host warns at start-up.
NOSUM_SMTP_HOST=
NOSUM_SMTP_PORT=587
NOSUM_SMTP_USER=
NOSUM_SMTP_PASSWORD=
NOSUM_SMTP_FROM=
NOSUM_SMTP_SSL=true
