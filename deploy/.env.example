# Names only (docs/adr/ADR-031 D1). Copy to deploy/.env and fill every value; .env is never committed.

# Password of the PostgreSQL role `nosum` (use letters and digits: it goes into a connection string).
POSTGRES_PASSWORD=

# Public host name of the site. Caddy gets a certificate for it automatically; `localhost` gives a local, self-signed one.
NOSUM_DOMAIN=

# Who may connect while the placeholder art is in the repository (docs/adr/ADR-007, ADR-031 D9): space-separated addresses or CIDRs.
# After milestone M6 replaces the art, set `0.0.0.0/0 ::/0` to open the site.
NOSUM_ALLOW_IPS=

# private (default) or public. A public build is refused while assets/PLACEHOLDER_CONTENT exists.
NOSUM_RELEASE=private

# Optional: tag of the images (default `local`), start of the server calendar (ISO 8601 UTC, default: the built-in epoch),
# hour (UTC) of the nightly backup and how many days of dumps to keep.
NOSUM_TAG=
NOSUM_CALENDAR_EPOCH=
BACKUP_HOUR_UTC=3
BACKUP_KEEP_DAYS=14
