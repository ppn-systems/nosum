# Reverse proxy of the single-server deployment (docs/adr/ADR-031 D2, D9).
#   - TLS is automatic (Let's Encrypt for a real NOSUM_DOMAIN, Caddy's own CA for localhost).
#   - /ws/ is the game WebSocket, proxied to the host; everything else is the static WASM client.
#   - Nalix encryption stays on inside the TLS tunnel (docs/adr/ADR-003).
#   - Until milestone M6 the site is private: only NOSUM_ALLOW_IPS may connect (compose refuses to start without it). Further rules, for
#     example basic auth, go in ./access.d/*.caddyfile (never committed).
{
	admin 127.0.0.1:2019
}

{$NOSUM_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		-Server
	}

	# One route, so the directives run in the order written: the allow-list first, then the operator's rules, then the site.
	# (Outside a route, handle blocks are sorted by matcher and would be tried before a bare respond.)
	route {
		@denied not remote_ip {$NOSUM_ALLOW_IPS}
		respond @denied "Forbidden" 403

		import /etc/caddy/access.d/*.caddyfile

		handle /ws/* {
			reverse_proxy {$NOSUM_HOST_UPSTREAM:host}:57300 {
				# The host answers /readyz on its ops port; a host that is not ready (migrating, database down) receives no players.
				health_uri /readyz
				health_port 57301
				health_interval 10s
				health_timeout 3s
			}
		}

		handle /healthz {
			respond "ok" 200
		}

		handle {
			root * /srv

			# Fingerprinted framework files never change under the same name; the page and everything else is revalidated.
			@fingerprinted path_regexp fp ^/_framework/.+\.[0-9a-z]{10}\.(wasm|js|dll|dat|webcil|json|blat)$
			header @fingerprinted Cache-Control "public, max-age=31536000, immutable"
			@revalidate {
				not path_regexp fp2 ^/_framework/.+\.[0-9a-z]{10}\.(wasm|js|dll|dat|webcil|json|blat)$
			}
			header @revalidate Cache-Control "no-cache"

			try_files {path} /index.html
			file_server {
				precompressed br gzip
			}
		}
	}
}
